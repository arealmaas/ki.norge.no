---
import Layout from '../components/layout/Layout.astro';

interface OrdEntry {
  term: string;
  altTerm?: string;
  definisjon: string;
}

const ordliste: OrdEntry[] = [
  {
    term: 'Agentisk KI',
    altTerm: 'agentic AI',
    definisjon: 'KI-systemer som kan planlegge og utføre flertrinnsoppgaver med liten menneskelig inngripen. Agentiske KI-systemer bruker verktøy, søker informasjon og tar beslutninger for å nå et mål.',
  },
  {
    term: 'Algoritme',
    altTerm: 'algorithm',
    definisjon: 'Et sett med regler eller instruksjoner som en datamaskin følger for å løse et problem eller utføre en oppgave. I KI brukes algoritmer til å trene modeller og ta beslutninger.',
  },
  {
    term: 'Automatisering',
    altTerm: 'automation',
    definisjon: 'Bruk av teknologi til å utføre oppgaver uten menneskelig inngripen. KI-drevet automatisering kan håndtere komplekse oppgaver som tidligere krevde menneskelig vurdering.',
  },
  {
    term: 'Bias',
    altTerm: 'skjevhet',
    definisjon: 'Systematiske feil i KI-modeller som kan oppstå når treningsdata ikke er representative, eller når modellen forsterker eksisterende ulikheter. Bias kan føre til urettferdig behandling av enkeltgrupper.',
  },
  {
    term: 'Chatbot',
    altTerm: 'samtalerobot',
    definisjon: 'Et program som simulerer menneskelig samtale via tekst eller tale. Moderne chatboter bruker store språkmodeller for å forstå og svare på naturlig språk.',
  },
  {
    term: 'Computer vision',
    altTerm: 'datasyn',
    definisjon: 'Et felt innen KI som gjør det mulig for datamaskiner å tolke og forstå visuell informasjon som bilder og video. Brukes blant annet til ansiktsgjenkjenning og medisinsk bildeanalyse.',
  },
  {
    term: 'Datasett',
    altTerm: 'dataset',
    definisjon: 'En samling data som brukes til å trene, validere eller teste en KI-modell. Kvaliteten og representativiteten til datasettet er avgjørende for modellens ytelse.',
  },
  {
    term: 'Dype nevrale nettverk',
    altTerm: 'deep neural networks',
    definisjon: 'Kunstige nevrale nettverk med mange lag som kan lære svært komplekse mønstre i store datamengder. Grunnlaget for det meste av moderne KI, inkludert bildegjenkjenning og språkmodeller.',
  },
  {
    term: 'Dyp læring',
    altTerm: 'deep learning',
    definisjon: 'En underkategori av maskinlæring som bruker dype nevrale nettverk med mange lag for å lære mønstre i data. Har revolusjonert felt som bildegjenkjenning, talegjenkjenning og naturlig språkbehandling.',
  },
  {
    term: 'Embedding',
    altTerm: 'vektorrepresentasjon',
    definisjon: 'En matematisk representasjon av ord, setninger eller andre data som vektorer i et flerdimensjonalt rom. Embeddings gjør det mulig for KI-modeller å forstå semantiske likheter mellom begreper.',
  },
  {
    term: 'Etisk KI',
    altTerm: 'ethical AI',
    definisjon: 'Utvikling og bruk av KI-systemer i tråd med etiske prinsipper som rettferdighet, åpenhet, ansvarlighet og personvern. Etisk KI sikrer at teknologien tjener samfunnets beste.',
  },
  {
    term: 'Explainability',
    altTerm: 'forklarbarhet',
    definisjon: 'Evnen til å forklare hvordan en KI-modell kom frem til en bestemt beslutning eller prediksjon. Forklarbarhet er viktig for tillit, ansvarlighet og overholdelse av regelverk.',
  },
  {
    term: 'Finjustering',
    altTerm: 'fine-tuning',
    definisjon: 'Prosessen med å tilpasse en ferdigtrenet KI-modell til en spesifikk oppgave ved å trene den videre på et mindre, domene-spesifikt datasett. Finjustering er mer effektivt enn å trene en modell fra bunnen av.',
  },
  {
    term: 'Fondasjonsmodell',
    altTerm: 'foundation model',
    definisjon: 'En stor KI-modell trent på enorme datamengder som kan brukes som grunnlag for mange ulike oppgaver gjennom finjustering eller prompt-engineering. Eksempler inkluderer GPT-4 og Llama.',
  },
  {
    term: 'Forsterket læring',
    altTerm: 'reinforcement learning',
    definisjon: 'En type maskinlæring der en agent lærer å ta beslutninger ved å interagere med et miljø og motta belønning eller straff for sine handlinger. Brukes blant annet til å trene KI i spill og roboter.',
  },
  {
    term: 'Fritekstgenerering',
    altTerm: 'text generation',
    definisjon: 'KI-modellers evne til å produsere sammenhengende og kontekstuelt relevante tekstsekvenser. Store språkmodeller som GPT-serien er kjent for sin evne til fritekstgenerering.',
  },
];

// Group by first letter
const grouped = ordliste
  .sort((a, b) => a.term.localeCompare(b.term, 'nb'))
  .reduce<Record<string, OrdEntry[]>>((acc, entry) => {
    const letter = entry.term[0].toUpperCase();
    if (!acc[letter]) acc[letter] = [];
    acc[letter].push(entry);
    return acc;
  }, {});

const letters = Object.keys(grouped).sort();
---

<Layout
  title="KI Ordboka"
  description="KI ordboken forklarer vanlige begreper innen kunstig intelligens. Søk etter et ord eller bla deg gjennom listen."
>
  <div class="ordbok-page">
    <div class="ordbok-header">
      <h1 class="ordbok-title">KI Ordboka</h1>
      <p class="ordbok-lead">
        KI ordboken forklarer vanlige begreper innen kunstig intelligens. Søk etter et ord eller bla deg gjennom listen.
      </p>

      <div class="search-container">
        <div class="search-inner">
          <label for="ordbok-search" class="sr-only">Søk etter begrep</label>
          <div class="search-input-wrap">
            <svg class="search-icon" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/>
              <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input
              id="ordbok-search"
              class="search-input"
              type="search"
              placeholder="Søk etter begrep..."
              autocomplete="off"
            />
          </div>
          <button class="search-btn" type="button" aria-label="Søk">Søk</button>
        </div>
      </div>
    </div>

    <div class="ordbok-content">
      <div class="sort-toolbar">
        <span class="sort-label">Begreper</span>
        <button class="sort-btn" type="button" aria-label="Sorter alfabetisk">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="4" y1="6" x2="20" y2="6"/>
            <line x1="4" y1="12" x2="14" y2="12"/>
            <line x1="4" y1="18" x2="10" y2="18"/>
          </svg>
          Alfabetisk
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m6 9 6 6 6-6"/>
          </svg>
        </button>
      </div>

      <div id="ordbok-list" class="ordbok-list">
        {letters.map((letter) => (
          <section class="letter-section" data-letter={letter}>
            <h2 class="letter-heading">{letter}</h2>
            <ul class="term-list" role="list">
              {grouped[letter].map((entry, idx) => (
                <li
                  class={`term-item ${idx % 2 === 0 ? 'term-item--blue' : 'term-item--white'}`}
                  data-term={entry.term.toLowerCase()}
                  data-alt={entry.altTerm?.toLowerCase() ?? ''}
                >
                  <details class="term-details">
                    <summary class="term-summary">
                      <span class="term-name">{entry.term}</span>
                      {entry.altTerm && (
                        <span class="term-alt">({entry.altTerm})</span>
                      )}
                      <svg class="term-chevron" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m6 9 6 6 6-6"/>
                      </svg>
                    </summary>
                    <div class="term-definition">
                      <p>{entry.definisjon}</p>
                    </div>
                  </details>
                </li>
              ))}
            </ul>
          </section>
        ))}

        <p id="no-results" class="no-results" hidden>
          Ingen begreper samsvarer med søket ditt.
        </p>
      </div>
    </div>
  </div>
</Layout>

<script>
  const searchInput = document.getElementById('ordbok-search') as HTMLInputElement | null;
  const searchBtn = document.querySelector('.search-btn') as HTMLButtonElement | null;
  const ordbokList = document.getElementById('ordbok-list');
  const noResults = document.getElementById('no-results');

  function filterOrdbok(query: string) {
    const q = query.trim().toLowerCase();
    const sections = ordbokList?.querySelectorAll<HTMLElement>('.letter-section');
    let totalVisible = 0;

    sections?.forEach((section) => {
      const items = section.querySelectorAll<HTMLElement>('.term-item');
      let sectionVisible = 0;

      items.forEach((item) => {
        const term = item.dataset.term ?? '';
        const alt = item.dataset.alt ?? '';
        const matches = q === '' || term.includes(q) || alt.includes(q);
        item.hidden = !matches;
        if (matches) sectionVisible++;
      });

      section.hidden = sectionVisible === 0;
      totalVisible += sectionVisible;
    });

    if (noResults) noResults.hidden = totalVisible > 0;
  }

  searchInput?.addEventListener('input', (e) => {
    filterOrdbok((e.target as HTMLInputElement).value);
  });

  searchBtn?.addEventListener('click', () => {
    filterOrdbok(searchInput?.value ?? '');
  });

  searchInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') filterOrdbok(searchInput.value);
  });

  // Sort toggle: reverse letter-section order on click.
  let reversed = false;
  const sortBtn = document.querySelector('.sort-btn') as HTMLButtonElement | null;
  const sortChevron = sortBtn?.querySelector('svg:last-child') as SVGElement | null;

  sortBtn?.addEventListener('click', () => {
    reversed = !reversed;
    const sections = Array.from(ordbokList?.querySelectorAll<HTMLElement>('.letter-section') ?? []);
    sections.reverse().forEach((s) => ordbokList?.appendChild(s));
    if (sortChevron) sortChevron.style.transform = reversed ? 'rotate(180deg)' : '';
    sortBtn.setAttribute('aria-label', reversed ? 'Sortert Å–A' : 'Sortert A–Å');
  });
</script>

<style>
  .ordbok-page {
    padding-top: var(--ds-size-4);
  }

  /* Screen-reader only utility */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ── Header ─────────────────────────────────────────── */

  .ordbok-header {
    max-width: 800px;
    margin: 0 auto;
    padding: 24px var(--ds-size-4) 40px;
  }

  .ordbok-title {
    font-size: 2.5rem;
    font-weight: 700;
    color: #000;
    margin: 0 0 16px;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .ordbok-lead {
    font-size: 1.125rem;
    line-height: 1.6;
    color: rgba(0, 0, 0, 0.6);
    margin: 0 0 32px;
    max-width: 600px;
  }

  /* ── Search bar ─────────────────────────────────────── */

  .search-container {
    background: #7691d1;
    border-radius: 24px;
    padding: 16px 20px;
  }

  .search-inner {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .search-input-wrap {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 10px;
    background: #fff;
    border-radius: 12px;
    padding: 10px 16px;
  }

  .search-icon {
    flex-shrink: 0;
    color: rgba(0, 0, 0, 0.45);
  }

  .search-input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-size: 1rem;
    color: #000;
    font-family: inherit;
  }

  .search-input::placeholder {
    color: rgba(0, 0, 0, 0.4);
  }

  /* Remove native search cancel button */
  .search-input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }

  .search-btn {
    flex-shrink: 0;
    background: #0062ba;
    color: #fff;
    border: none;
    border-radius: 12px;
    padding: 10px 20px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
    transition: background 0.15s;
  }

  .search-btn:hover {
    background: #004f96;
  }

  .search-btn:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 2px;
  }

  /* ── Main content ───────────────────────────────────── */

  .ordbok-content {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 var(--ds-size-4) 120px;
  }

  /* ── Sort toolbar ───────────────────────────────────── */

  .sort-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 0 8px;
    border-bottom: 1px solid #b8bcc1;
    margin-bottom: 8px;
  }

  .sort-label {
    font-size: 1rem;
    font-weight: 600;
    color: #000;
  }

  .sort-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: 1px solid #b8bcc1;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 0.875rem;
    font-weight: 500;
    color: #000;
    cursor: pointer;
    font-family: inherit;
    transition: border-color 0.15s, background 0.15s;
  }

  .sort-btn:hover {
    border-color: #0062ba;
    background: rgba(0, 98, 186, 0.05);
  }

  /* ── Letter sections ────────────────────────────────── */

  .letter-section {
    margin-top: 32px;
  }

  .letter-heading {
    font-size: 1.5rem;
    font-weight: 700;
    color: #1a2a6d;
    margin: 0 0 8px;
    padding-bottom: 4px;
    border-bottom: 2px solid #7691d1;
    display: inline-block;
    min-width: 36px;
    text-align: center;
  }

  .term-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid #c5d3f0;
    border-radius: 12px;
    overflow: hidden;
  }

  /* ── Term rows ──────────────────────────────────────── */

  .term-item {
    border-bottom: 1px solid #c5d3f0;
  }

  .term-item:last-child {
    border-bottom: none;
  }

  .term-item--blue {
    background: #d8e4ff;
  }

  .term-item--white {
    background: #fff;
  }

  /* ── Accordion ──────────────────────────────────────── */

  .term-details {
    width: 100%;
  }

  .term-summary {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 20px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .term-summary::-webkit-details-marker {
    display: none;
  }

  .term-summary:hover {
    background: rgba(0, 98, 186, 0.08);
  }

  .term-name {
    font-size: 1.125rem;
    font-weight: 500;
    color: #1a2a6d;
    text-decoration: underline;
    text-decoration-color: rgba(26, 42, 109, 0.35);
    text-underline-offset: 3px;
    flex: 1;
  }

  .term-alt {
    font-size: 0.875rem;
    font-weight: 400;
    color: rgba(0, 0, 0, 0.5);
    font-style: italic;
    margin-right: auto;
  }

  .term-chevron {
    flex-shrink: 0;
    color: #1a2a6d;
    transition: transform 0.2s ease;
    margin-left: auto;
  }

  .term-details[open] > .term-summary .term-chevron {
    transform: rotate(180deg);
  }

  .term-definition {
    padding: 4px 20px 16px 20px;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: rgba(0, 0, 0, 0.7);
    border-top: 1px solid rgba(0, 98, 186, 0.15);
  }

  .term-item--blue .term-definition {
    background: rgba(255, 255, 255, 0.5);
  }

  .term-definition p {
    margin: 12px 0 0;
  }

  /* ── No results ─────────────────────────────────────── */

  .no-results {
    text-align: center;
    padding: 64px var(--ds-size-4);
    color: rgba(0, 0, 0, 0.55);
    font-size: 1rem;
  }

  /* ── Responsive ─────────────────────────────────────── */

  @media (min-width: 640px) {
    .ordbok-title {
      font-size: 3rem;
    }

    .term-summary {
      padding: 16px 24px;
    }

    .term-definition {
      padding: 4px 24px 20px 24px;
    }
  }

  @media (min-width: 1024px) {
    .ordbok-header {
      padding-top: 40px;
    }

    .ordbok-title {
      font-size: 3.5rem;
    }
  }
</style>
