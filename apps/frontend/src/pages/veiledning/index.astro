---
import Layout from '../../components/layout/Layout.astro';
import { getVeiledningGuider } from '../../lib/umbraco';

const guidesRes = await getVeiledningGuider();
const guides = guidesRes.data;
---
<Layout title="Veiledning">
  <div class="guide-listing">
    <h1>Veiledning</h1>
    <div class="guide-list">
      {guides.map(guide => (
        <a href={`/veiledning/${guide.slug}`} class="guide-card">
          <h2>{guide.tittel}</h2>
        </a>
      ))}
    </div>
  </div>
</Layout>
<style>
  .guide-listing {
    max-width: 800px;
    margin: 0 auto;
    padding: var(--ds-size-8) var(--ds-size-4);
  }
  .guide-listing h1 {
    font-size: 2rem;
    font-weight: 700;
    margin: 0 0 var(--ds-size-8);
  }
  .guide-list {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-4);
  }
  .guide-card {
    display: block;
    padding: var(--ds-size-6);
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s;
  }
  .guide-card:hover {
    border-color: #7c3aed;
  }
  .guide-card h2 {
    margin: 0;
    font-size: 1.25rem;
  }
</style>
