---
import Layout from '../../components/layout/Layout.astro';
import BlocksRenderer from '../../components/shared/BlocksRenderer.astro';
export const prerender = false;

import { getArtikkel, getPlainText, extractHeadings, type Artikkel } from '../../lib/umbraco';
import { articleSchema } from '../../lib/seo';
import { Heading, Paragraph, Link } from '@digdir/designsystemet-react';

const { slug } = Astro.params;
const isPreview = Astro.url.searchParams.has('preview') || !!Astro.cookies.get('preview')?.value;
const article = await getArtikkel(slug!, { preview: isPreview });
if (!article) return Astro.redirect('/artikler');

const formattedDate = new Date(article.publishedAt).toLocaleDateString('nb-NO', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const headings = extractHeadings(article.innhold);

const seoTitle = article.seoTittel || article.tittel;
const seoDesc = article.seoBeskrivelse || getPlainText(article.innhold, 200);
const seoImage = article.seoBilde?.url;

const articleJsonLd = articleSchema({
  headline: seoTitle,
  description: seoDesc,
  slug: slug!,
  datePublished: article.publishedAt,
  dateModified: article.updatedAt || article.publishedAt,
});
---

<Layout title={seoTitle} description={seoDesc} ogType="article" publishedAt={article.publishedAt} ogImage={seoImage}>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  {isPreview && (
    <div class="preview-banner">
      Forhåndsvisning — <a href={`/api/preview?exit&returnTo=${Astro.url.pathname}`}>Avslutt</a>
    </div>
  )}
  <div class="article-page">
    <div class="article-container">
      <nav class="breadcrumb" aria-label="Brødsmuler">
        <a href="/">Hjem</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <a href="/artikler">Artikler</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <span aria-current="page">{article.tittel}</span>
      </nav>

      <header class="article-header">
        <Heading level={1} size="2xlarge" className="article-title">
          {article.tittel}
        </Heading>
        <div class="article-meta">
          <span class="meta-item">
            <span class="material-symbols-outlined" aria-hidden="true">calendar_today</span>
            <time datetime={article.publishedAt}>{formattedDate}</time>
          </span>
        </div>
      </header>

      <div class="article-layout">
        <article class="article-content">
          <BlocksRenderer blocks={article.innhold} class="article-body" />
        </article>

        {headings.length > 0 && (
          <aside class="article-sidebar">
            <nav class="toc" aria-label="Innhold">
              <div class="toc-title">Innhold</div>
              <ul class="toc-list">
                {headings.map(h => (
                  <li class={h.level === 3 ? 'toc-sub' : ''}>
                    <a href={`#${h.id}`}>{h.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )}
      </div>

      <nav class="article-footer" aria-label="Navigasjon">
        <a href="/artikler" class="back-link">
          <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
          Tilbake til artikler
        </a>
      </nav>
    </div>
  </div>
</Layout>

<style>
  .preview-banner {
    position: sticky;
    top: 0;
    z-index: 100;
    background: #d97706;
    color: #fff;
    text-align: center;
    padding: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .preview-banner a {
    color: #fff;
    text-decoration: underline;
    margin-left: 0.25rem;
  }

  .article-page {
    padding: var(--ds-size-6) var(--ds-size-4);
  }

  @media (min-width: 768px) {
    .article-page {
      padding: var(--ds-size-10) var(--ds-size-4);
    }
  }

  .article-container {
    max-width: 1120px;
    margin: 0 auto;
  }

  /* Breadcrumbs */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: #64748b;
    margin-bottom: var(--ds-size-6);
    flex-wrap: wrap;
  }

  html.dark .breadcrumb {
    color: #94a3b8;
  }

  .breadcrumb a {
    color: #136dec;
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  html.dark .breadcrumb a {
    color: #5ba0f5;
  }

  .breadcrumb-sep {
    color: #cbd5e1;
  }

  html.dark .breadcrumb-sep {
    color: #475569;
  }

  .breadcrumb [aria-current] {
    color: #0d131b;
    font-weight: 500;
  }

  html.dark .breadcrumb [aria-current] {
    color: #f1f5f9;
  }

  /* Header */
  .article-header {
    margin-bottom: var(--ds-size-8);
    max-width: 720px;
  }

  :global(.article-title) {
    margin: 0 0 var(--ds-size-4);
    color: #0d131b;
    letter-spacing: -0.02em;
    line-height: 1.15;
    font-weight: 800;
  }

  html.dark :global(.article-title) {
    color: #f1f5f9;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: var(--ds-size-4);
    flex-wrap: wrap;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    color: #64748b;
  }

  html.dark .meta-item {
    color: #94a3b8;
  }

  .meta-item .material-symbols-outlined {
    font-size: 18px;
    color: #94a3b8;
  }

  html.dark .meta-item .material-symbols-outlined {
    color: #64748b;
  }

  /* Two-column layout */
  .article-layout {
    display: flex;
    gap: var(--ds-size-10);
  }

  .article-content {
    flex: 1;
    min-width: 0;
    max-width: 720px;
  }

  :global(.article-body) {
    line-height: 1.7;
  }

  :global(.article-body h2),
  :global(.article-body h3) {
    scroll-margin-top: 100px;
  }

  /* Sidebar / TOC */
  .article-sidebar {
    display: none;
    width: 280px;
    flex-shrink: 0;
  }

  @media (min-width: 1024px) {
    .article-sidebar {
      display: block;
    }
  }

  .toc {
    position: sticky;
    top: 100px;
    padding: var(--ds-size-5);
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
  }

  html.dark .toc {
    background: #1a2332;
    border-color: #334155;
  }

  .toc-title {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #64748b;
    margin-bottom: var(--ds-size-3);
  }

  html.dark .toc-title {
    color: #94a3b8;
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc-list li {
    margin-bottom: 0.25rem;
  }

  .toc-list li.toc-sub {
    padding-left: var(--ds-size-4);
  }

  .toc-list a {
    display: block;
    padding: 0.375rem 0.5rem;
    font-size: 0.875rem;
    color: #334155;
    text-decoration: none;
    border-radius: 6px;
    transition: background-color 0.15s ease, color 0.15s ease;
    line-height: 1.4;
  }

  html.dark .toc-list a {
    color: #cbd5e1;
  }

  .toc-list a:hover {
    background: #f1f5f9;
    color: #136dec;
  }

  html.dark .toc-list a:hover {
    background: #243042;
    color: #5ba0f5;
  }

  /* Footer navigation */
  .article-footer {
    margin-top: var(--ds-size-10);
    padding-top: var(--ds-size-6);
    border-top: 1px solid #e2e8f0;
  }

  html.dark .article-footer {
    border-color: #334155;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #136dec;
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  html.dark .back-link {
    color: #5ba0f5;
  }

  .back-link .material-symbols-outlined {
    font-size: 20px;
  }
</style>
