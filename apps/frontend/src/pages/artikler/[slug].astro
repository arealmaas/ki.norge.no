---
import Layout from '../../components/layout/Layout.astro';
import BlocksRenderer from '../../components/shared/BlocksRenderer.astro';

import { getArtikkel, getArtikler, getPlainText, type Artikkel } from '../../lib/umbraco';
import { articleSchema } from '../../lib/seo';

const { slug } = Astro.params;
const isPreview = Astro.url.searchParams.has('preview') || !!Astro.cookies.get('preview')?.value;
const article = await getArtikkel(slug!, { preview: isPreview });
if (!article) return Astro.redirect('/artikler');

const formattedDate = new Date(article.publishedAt).toLocaleDateString('nb-NO', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const seoTitle = article.seoTittel || article.tittel;
const seoDesc = article.seoBeskrivelse || getPlainText(article.innhold, 200);
const seoImage = article.seoBilde?.url;

const articleJsonLd = articleSchema({
  headline: seoTitle,
  description: seoDesc,
  slug: slug!,
  datePublished: article.publishedAt,
  dateModified: article.updatedAt || article.publishedAt,
});

// Fetch other articles for "Flere artikler" section
const allArticlesRes = await getArtikler(10);
const otherArticles = allArticlesRes.data.filter(a => a.slug !== slug).slice(0, 3);
---

<Layout title={seoTitle} description={seoDesc} ogType="article" publishedAt={article.publishedAt} ogImage={seoImage}>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <div class="article-page">
    <!-- Hero -->
    <section class="article-hero">
      <div class="article-hero-inner">
        <div class="article-hero-text">
          <h1 class="article-title">{article.tittel}</h1>
          <p class="article-meta">{formattedDate}</p>
        </div>
        <div class="article-hero-image">
          <div class="article-hero-placeholder"></div>
        </div>
      </div>
    </section>

    <!-- Lead -->
    {article.innhold && (
      <section class="article-lead">
        <p class="article-lead-text">{getPlainText(article.innhold, 300)}</p>
      </section>
    )}

    <!-- Body -->
    <article class="article-body-section">
      <BlocksRenderer blocks={article.innhold} class="article-body" />
    </article>

    <!-- Flere artikler -->
    {otherArticles.length > 0 && (
      <section class="more-articles">
        <h2 class="more-articles-heading">Flere artikler</h2>
        <div class="more-articles-grid">
          {otherArticles.map(a => (
            <a href={`/artikler/${a.slug}`} class="more-article-card">
              <div class="more-article-text">
                <h3 class="more-article-title">{a.tittel}</h3>
                <span class="more-article-date">
                  {new Date(a.publishedAt).toLocaleDateString('nb-NO', { year: 'numeric', month: 'long', day: 'numeric' })}
                </span>
                <p class="more-article-lead">{getPlainText(a.innhold, 80)}</p>
              </div>
              <div class="more-article-image"></div>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>

<style>
  .article-page {
    padding-top: var(--ds-size-4);
  }

  /* Hero */
  .article-hero {
    max-width: 1230px;
    margin: 0 auto;
    padding: 24px 24px 48px;
  }

  .article-hero-inner {
    display: flex;
    gap: 24px;
    align-items: center;
  }

  .article-hero-text {
    flex: 1;
    min-width: 0;
  }

  .article-title {
    font-size: 2.5rem;
    font-weight: 700;
    color: #000;
    margin: 0 0 24px;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  @media (min-width: 768px) {
    .article-title {
      font-size: 3rem;
    }
  }

  .article-meta {
    font-size: 20px;
    font-weight: 500;
    color: rgba(0, 0, 0, 0.75);
    margin: 0;
  }

  .article-hero-image {
    width: 400px;
    flex-shrink: 0;
    display: none;
  }

  @media (min-width: 1024px) {
    .article-hero-image {
      display: block;
    }
  }

  .article-hero-placeholder {
    width: 100%;
    height: 300px;
    background: linear-gradient(90deg, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.2) 100%), linear-gradient(180deg, rgba(255,255,255,0.2) 71.6%, rgba(0,0,0,0.2) 100%);
    border-radius: 16px;
  }

  /* Lead */
  .article-lead {
    max-width: 830px;
    margin: 0 auto;
    padding: 64px 24px;
  }

  .article-lead-text {
    font-size: 21px;
    font-weight: 400;
    color: rgba(0, 0, 0, 0.75);
    line-height: 1.7;
    letter-spacing: 0.005em;
    margin: 0;
  }

  /* Body */
  .article-body-section {
    max-width: 830px;
    margin: 0 auto;
    padding: 0 24px 64px;
  }

  :global(.article-body) {
    font-size: 21px;
    line-height: 1.7;
    color: rgba(0, 0, 0, 0.75);
    letter-spacing: 0.005em;
  }

  :global(.article-body h2) {
    font-size: 36px;
    font-weight: 500;
    color: #1a2a6d;
    margin: 48px 0 24px;
    line-height: 1.3;
    letter-spacing: -0.005em;
  }

  :global(.article-body h3) {
    font-size: 24px;
    font-weight: 500;
    color: #1a2a6d;
    margin: 32px 0 16px;
    line-height: 1.3;
  }

  :global(.article-body h2),
  :global(.article-body h3) {
    scroll-margin-top: 100px;
  }

  :global(.article-body p) {
    margin: 0 0 16px;
  }

  :global(.article-body ul),
  :global(.article-body ol) {
    margin: 8px 0 16px;
    padding-left: 24px;
  }

  :global(.article-body li) {
    margin-bottom: 4px;
  }

  /* More articles */
  .more-articles {
    max-width: 1120px;
    margin: 0 auto;
    padding: 64px 24px 120px;
  }

  .more-articles-heading {
    font-size: 40px;
    font-weight: 700;
    color: #000;
    margin: 0 0 32px;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .more-articles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  @media (min-width: 768px) {
    .more-articles-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .more-article-card {
    display: flex;
    flex-direction: column;
    gap: 24px;
    background: rgba(0, 0, 0, 0.05);
    border-radius: 8px;
    padding: 24px;
    height: 384px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.15s;
  }

  .more-article-card:hover {
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
  }

  .more-article-text {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .more-article-title {
    font-size: 24px;
    font-weight: 600;
    color: #000;
    margin: 0;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .more-article-date {
    font-size: 18px;
    font-weight: 500;
    color: rgba(0, 0, 0, 0.55);
    line-height: 1.45;
  }

  .more-article-lead {
    font-size: 18px;
    font-weight: 500;
    color: rgba(0, 0, 0, 0.55);
    margin: 0;
    line-height: 1.45;
  }

  .more-article-image {
    flex: 1;
    background: var(--image-fallback-bg, #D9D9D9);
    border-radius: 24px;
    min-height: 120px;
  }
</style>
