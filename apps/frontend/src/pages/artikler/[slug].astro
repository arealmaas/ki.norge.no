---
import Layout from '../../components/layout/Layout.astro';

import { getArtikkel, getArtikler, getPlainText, getMediaUrl, type Artikkel } from '../../lib/umbraco';
import { articleSchema } from '../../lib/seo';

const { slug } = Astro.params;
const isPreview = Astro.url.searchParams.has('preview') || !!Astro.cookies.get('preview')?.value;
const article = await getArtikkel(slug!, { preview: isPreview });
if (!article) return Astro.redirect('/artikler');

const formattedDate = new Date(article.publishedAt).toLocaleDateString('nb-NO', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const seoTitle = article.seoTittel || article.tittel;
const seoDesc = article.seoBeskrivelse || article.ingress || getPlainText(article.innhold, 200);
const heroImage = article.artikkelBilde || article.seoBilde;
const seoImage = article.seoBilde?.url || article.artikkelBilde?.url;

const articleJsonLd = articleSchema({
  headline: seoTitle,
  description: seoDesc,
  slug: slug!,
  datePublished: article.publishedAt,
  dateModified: article.updatedAt || article.publishedAt,
});

// Fetch other articles for "Flere artikler" section
const allArticlesRes = await getArtikler(10);
const otherArticles = allArticlesRes.data.filter(a => a.slug !== slug).slice(0, 3);

const bakgrunn = article.bakgrunn || 'hvit';
const isLightBlueBg = bakgrunn === 'lyseblaa';
---

<Layout title={seoTitle} description={seoDesc} ogType="article" publishedAt={article.publishedAt} ogImage={seoImage}>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd).replace(/</g, '\\u003c')} />
  <div class="article-page grid">
    <!-- Artikkelhode: title + ingress + image, optionally on full-bleed colored background -->
    <section class={`article-hero ${isLightBlueBg ? 'col-all article-hero--bg-lyseblaa' : (heroImage ? 'col-center-10' : 'col-center-6')}`}>
      {isLightBlueBg ? (
        <div class={`grid article-hero-bg-grid`}>
          <div class={`article-hero-inner ${heroImage ? 'col-center-10' : 'col-center-6'}`}>
            <div class="article-hero-text">
              <h1 class="article-title">{article.tittel}</h1>
              {article.ingress && <p class="article-ingress">{article.ingress}</p>}
            </div>
            {heroImage?.url && (
              <div class="article-hero-image">
                <img src={getMediaUrl(heroImage)} alt={article.bildeAlt || ''} class="article-hero-img" />
              </div>
            )}
          </div>
        </div>
      ) : (
        <div class="article-hero-inner">
          <div class="article-hero-text">
            <h1 class="article-title">{article.tittel}</h1>
            {article.ingress && <p class="article-ingress">{article.ingress}</p>}
          </div>
          {heroImage?.url && (
            <div class="article-hero-image">
              <img src={getMediaUrl(heroImage)} alt={article.bildeAlt || ''} class="article-hero-img" />
            </div>
          )}
        </div>
      )}
    </section>

    <!-- Body blocks: each is col-center-6 -->
    {article.innhold?.map(block => {
        if (block.contentType === 'artikkelFremheving') {
          const c = block.content;
          const classes = [
            'article-fremheving',
            'col-center-6',
            c.visBakgrunn ? 'article-fremheving--bg' : '',
            c.visAnforselstegn ? 'article-fremheving--quote' : '',
            c.bilde?.url ? 'article-fremheving--with-image' : '',
          ].filter(Boolean).join(' ');
          return (
            <div class={classes}>
              {c.bilde?.url && (
                <div class="article-fremheving-image">
                  <img src={getMediaUrl(c.bilde)} alt={c.bildeAlt || ''} />
                </div>
              )}
              <div class="article-fremheving-content">
                {c.tittel && <h3 class="article-fremheving-title">{c.tittel}</h3>}
                {c.visAnforselstegn ? (
                  <blockquote class="article-fremheving-text article-fremheving-text--quote">
                    <span aria-hidden="true" class="article-fremheving-quote-mark article-fremheving-quote-mark--open">«</span>
                    <div set:html={c.tekst} />
                    <span aria-hidden="true" class="article-fremheving-quote-mark article-fremheving-quote-mark--close">»</span>
                  </blockquote>
                ) : (
                  <div class="article-fremheving-text" set:html={c.tekst} />
                )}
                {c.kilde && (
                  <footer class="article-fremheving-source">
                    <cite>{c.kilde}</cite>
                  </footer>
                )}
              </div>
            </div>
          );
        }
        if (block.contentType === 'artikkelInfoBoks') {
          return (
            <div class="article-info-box col-center-6">
              {block.content.tittel && <h3 class="info-box-title">{block.content.tittel}</h3>}
              <div class="info-box-body" set:html={block.content.innhold} />
            </div>
          );
        }
        if (block.contentType === 'artikkelHero') {
          // Legacy artikkelHero block — element type removed, render as InfoBox-style fallback
          return (
            <div class="article-info-box col-center-6">
              {block.content.tittel && <h3 class="info-box-title">{block.content.tittel}</h3>}
              {block.content.tekst && <div class="info-box-body" set:html={block.content.tekst} />}
            </div>
          );
        }
        if (block.contentType === 'artikkelTrekkspill') {
          return (
            <details class="article-accordion col-center-6">
              <summary class="article-accordion-summary">
                {block.content.tittel}
                <svg class="article-accordion-chevron" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m6 9 6 6 6-6"/>
                </svg>
              </summary>
              <div class="article-accordion-body" set:html={block.content.innhold} />
            </details>
          );
        }
        if (block.contentType === 'artikkelSitat') {
          return (
            <blockquote class="article-quote col-center-6">
              <p class="article-quote-text">{block.content.sitat}</p>
              {block.content.kilde && (
                <footer class="article-quote-source">
                  <cite>{block.content.kilde}</cite>
                </footer>
              )}
            </blockquote>
          );
        }
        if (block.contentType === 'artikkelCallout') {
          const variant = block.content.variant || 'info';
          return (
            <div class={`article-callout article-callout--${variant} col-center-6`} role={variant === 'advarsel' ? 'alert' : 'note'}>
              {block.content.tittel && <p class="article-callout-title">{block.content.tittel}</p>}
              <div class="article-callout-body" set:html={block.content.innhold} />
            </div>
          );
        }
        if (block.contentType === 'artikkelBildeSeksjon') {
          return (
            <figure class="article-image-section col-center-6">
              {block.content.bilde?.url ? (
                <img src={getMediaUrl(block.content.bilde)} alt={block.content.bildeAlt || ''} class="stub-img" />
              ) : (
                <div class="article-image-placeholder"></div>
              )}
              {block.content.bildetekst && <figcaption>{block.content.bildetekst}</figcaption>}
            </figure>
          );
        }
        // Default: artikkelTekst or tekst
        return (
          <div class="article-text-block col-center-6" set:html={block.content.innhold} />
        );
      })}

    <!-- Flere artikler: col-center-10 -->
    {otherArticles.length > 0 && (
      <section class="more-articles col-center-10">
        <h2 class="more-articles-heading">Flere artikler</h2>
        <div class="more-articles-grid">
          {otherArticles.map(a => (
            <a href={`/artikler/${a.slug}`} class="more-article-card">
              <div class="more-article-text">
                <h3 class="more-article-title">{a.tittel}</h3>
                <span class="more-article-date">
                  {new Date(a.publishedAt).toLocaleDateString('nb-NO', { year: 'numeric', month: 'long', day: 'numeric' })}
                </span>
                <p class="more-article-lead">{getPlainText(a.innhold, 80)}</p>
              </div>
              <div class="more-article-image"></div>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>

<style>
  .article-page {
    padding-top: 0; /* hero handles its own top padding (incl. clearance for absolute header) */
    row-gap: 48px; /* vertikal avstand mellom grid-barn */
  }

  /* Hero / Ingress / Artikkelhode */
  .article-hero {
    padding: 100px 0;
  }

  /* Light-blue full-bleed background variant: extends edge-to-edge,
     including up behind the transparent site header */
  .article-hero--bg-lyseblaa {
    background: #e5f2f7;
    padding: 140px 0 80px; /* extra top padding so content clears header */
    margin: 0;
  }

  /* When in bg-lyseblaa, the inner grid wrapper handles column placement */
  .article-hero-bg-grid {
    /* uses .grid class — already styled by grid.css */
  }

  .article-hero-inner {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  @media (min-width: 1024px) {
    .article-hero-inner {
      flex-direction: row;
      align-items: center;
    }
  }

  .article-hero-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .article-title {
    font-size: 2rem;
    font-weight: 700;
    color: #000;
    margin: 0;
    line-height: 1.3;
    letter-spacing: -0.5px;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  @media (min-width: 768px) {
    .article-title {
      font-size: 2.5rem;
    }
  }

  @media (min-width: 1024px) {
    .article-title {
      font-size: 36px;
    }
  }

  .article-ingress {
    font-size: 21px;
    font-weight: 400;
    color: rgba(0, 0, 0, 0.75);
    line-height: 1.7;
    letter-spacing: 0.5px;
    margin: 0;
  }

  @media (min-width: 1024px) {
    .article-ingress {
      font-size: 24px;
    }
  }

  .article-hero-image {
    flex-shrink: 0;
    width: 100%;
  }

  @media (min-width: 1024px) {
    .article-hero-image {
      width: 407px;
    }
  }

  .article-hero-img {
    width: 100%;
    height: auto;
    border-radius: 16px;
    display: block;
    object-fit: cover;
  }

  @media (min-width: 1024px) {
    .article-hero-img {
      height: 331px;
    }
  }

  /* Info box - light blue */
  /* Accordion / trekkspill */
  .article-accordion {
    border: 1px solid #b6d8e4;
    border-radius: 8px;
    overflow: hidden;
    margin: 24px 0;
    transition: border-color 0.15s;
  }

  .article-accordion:hover {
    border-color: #1a2a6d;
  }

  .article-accordion[open] {
    border-color: #1a2a6d;
  }

  .article-accordion-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    font-size: 1.125rem;
    font-weight: 500;
    color: #1a2a6d;
    cursor: pointer;
    list-style: none;
    background: #e5f2f7;
  }

  .article-accordion-summary::-webkit-details-marker {
    display: none;
  }

  .article-accordion-chevron {
    flex-shrink: 0;
    transition: transform 0.2s ease;
    color: #1a2a6d;
  }

  .article-accordion[open] > .article-accordion-summary .article-accordion-chevron {
    transform: rotate(180deg);
  }

  .article-accordion-body {
    padding: 20px 24px;
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(0, 0, 0, 0.75);
    background: white;
  }

  .article-accordion-body :global(p) {
    margin: 0 0 12px;
  }

  .article-accordion-body :global(p:last-child) {
    margin-bottom: 0;
  }

  /* Sitat / blockquote */
  .article-quote {
    margin: 32px 0;
    padding: 24px 32px;
    border-left: 4px solid #1a2a6d;
    background: #f8fafc;
    border-radius: 0 8px 8px 0;
  }

  .article-quote-text {
    font-size: 1.25rem;
    font-style: italic;
    line-height: 1.6;
    color: #1e293b;
    margin: 0;
  }

  .article-quote-source {
    margin-top: 12px;
    font-size: 0.9rem;
    color: rgba(0, 0, 0, 0.6);
  }

  .article-quote-source cite {
    font-style: normal;
  }

  /* Callout / varselboks */
  .article-callout {
    margin: 24px 0;
    padding: 20px 24px;
    border-radius: 8px;
    border-left: 4px solid;
  }

  .article-callout--info {
    background: #e5f2f7;
    border-left-color: #0062ba;
  }

  .article-callout--obs {
    background: #fef9c3;
    border-left-color: #ca8a04;
  }

  .article-callout--advarsel {
    background: #fef2f2;
    border-left-color: #dc2626;
  }

  .article-callout--suksess {
    background: #f0fdf4;
    border-left-color: #16a34a;
  }

  .article-callout-title {
    font-weight: 600;
    font-size: 1rem;
    margin: 0 0 8px;
    color: #1e293b;
  }

  .article-callout-body {
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(0, 0, 0, 0.8);
  }

  .article-callout-body :global(p) {
    margin: 0 0 8px;
  }

  .article-callout-body :global(p:last-child) {
    margin-bottom: 0;
  }

  /* Fremheving (unified highlight block) */
  .article-fremheving {
    display: flex;
    flex-direction: column;
    gap: 24px;
    border-radius: 24px;
    padding: 32px;
    margin: 16px 0;
  }
  .article-fremheving--bg {
    background: #e5f2f7;
  }
  @media (min-width: 768px) {
    .article-fremheving--with-image {
      flex-direction: row;
      align-items: flex-start;
    }
    .article-fremheving-image {
      flex-shrink: 0;
      width: 35%;
    }
  }
  .article-fremheving-image img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 12px;
  }
  .article-fremheving-content {
    flex: 1;
    min-width: 0;
  }
  .article-fremheving-title {
    font-size: 21px;
    font-weight: 500;
    color: #1a2a6d;
    margin: 0 0 16px;
  }
  .article-fremheving-text {
    font-size: 18px;
    line-height: 1.7;
    color: rgba(0, 0, 0, 0.8);
  }
  .article-fremheving-text :global(p) {
    margin: 0 0 12px;
  }
  .article-fremheving-text :global(p:last-child) {
    margin-bottom: 0;
  }
  /* Quote variant: « and » Norwegian quote marks */
  .article-fremheving-text--quote {
    position: relative;
    font-style: italic;
    margin: 0;
  }
  .article-fremheving-quote-mark {
    font-size: 2.5em;
    font-style: normal;
    color: rgba(0, 0, 0, 0.4);
    line-height: 0.5;
    vertical-align: -0.2em;
  }
  .article-fremheving-quote-mark--open {
    margin-right: 0.1em;
  }
  .article-fremheving-quote-mark--close {
    margin-left: 0.1em;
  }
  .article-fremheving-source {
    margin-top: 12px;
    font-size: 14px;
    color: rgba(0, 0, 0, 0.55);
  }
  .article-fremheving-source cite {
    font-style: normal;
  }

  /* Legacy Info box (artikkelInfoBoks) — kept for back-compat */
  .article-info-box {
    background: #e5f2f7;
    border-radius: 24px;
    padding: 48px;
    margin: 32px 0;
  }
  .info-box-title {
    font-size: 21px;
    font-weight: 500;
    color: #1a2a6d;
    margin: 0 0 16px;
  }
  .info-box-body {
    font-size: 21px;
    line-height: 1.7;
    color: rgba(0,0,0,0.75);
  }

  /* Legacy artikkelHero block — element type removed.
     If old content still has these blocks, they fall back to InfoBox styling. */

  /* Image section */
  .article-image-section {
    margin: 32px 0;
  }
  .article-image-section img {
    width: 100%;
    border-radius: 8px;
    display: block;
  }
  .article-image-placeholder {
    width: 100%;
    height: 400px;
    background: var(--image-fallback-bg, #D9D9D9);
    border-radius: 8px;
  }
  .article-image-section figcaption {
    font-size: 14px;
    color: rgba(0,0,0,0.55);
    margin-top: 8px;
    text-align: center;
  }

  /* Text block */
  .article-text-block {
    font-size: 21px;
    line-height: 1.7;
    color: rgba(0,0,0,0.75);
    letter-spacing: 0.005em;
  }
  .article-text-block :global(h2) {
    font-size: 36px;
    font-weight: 500;
    color: #1a2a6d;
    margin: 48px 0 24px;
  }
  .article-text-block :global(h3) {
    font-size: 24px;
    font-weight: 500;
    color: #1a2a6d;
    margin: 32px 0 16px;
  }
  .article-text-block :global(p) {
    margin: 0 0 16px;
  }
  .article-text-block :global(ul), .article-text-block :global(ol) {
    margin: 8px 0 16px;
    padding-left: 24px;
  }

  /* More articles */
  .more-articles {
    padding: 64px 0 120px;
  }

  .more-articles-heading {
    font-size: 32px;
    font-weight: 700;
    color: #000;
    margin: 0 0 24px;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  @media (min-width: 1024px) {
    .more-articles-heading {
      font-size: 40px;
      margin-bottom: 32px;
    }
  }

  .more-articles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 768px) {
    .more-articles-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
  }

  @media (min-width: 1024px) {
    .more-articles-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .more-article-card {
    display: flex;
    flex-direction: column;
    gap: 24px;
    background: rgba(0, 0, 0, 0.05);
    border-radius: 8px;
    padding: 24px;
    min-height: 280px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.15s;
  }

  .more-article-card:hover {
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
  }

  .more-article-text {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .more-article-title {
    font-size: 24px;
    font-weight: 600;
    color: #000;
    margin: 0;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .more-article-date {
    font-size: 18px;
    font-weight: 500;
    color: rgba(0, 0, 0, 0.55);
    line-height: 1.45;
  }

  .more-article-lead {
    font-size: 18px;
    font-weight: 500;
    color: rgba(0, 0, 0, 0.55);
    margin: 0;
    line-height: 1.45;
  }

  .more-article-image {
    flex: 1;
    background: var(--image-fallback-bg, #D9D9D9);
    border-radius: 24px;
    min-height: 120px;
  }
</style>
