---
import Layout from '../../components/layout/Layout.astro';
import BlocksRenderer from '../../components/shared/BlocksRenderer.astro';
import ContactCard from '../../components/shared/ContactCard.astro';
import SidebarCard from '../../components/shared/SidebarCard.astro';

import { getArtikkel, getPlainText, extractHeadings, type Artikkel } from '../../lib/umbraco';
import { articleSchema } from '../../lib/seo';

const { slug } = Astro.params;
const isPreview = Astro.url.searchParams.has('preview') || !!Astro.cookies.get('preview')?.value;
const article = await getArtikkel(slug!, { preview: isPreview });
if (!article) return Astro.redirect('/artikler');

const formattedDate = new Date(article.publishedAt).toLocaleDateString('nb-NO', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const headings = extractHeadings(article.innhold);

const seoTitle = article.seoTittel || article.tittel;
const seoDesc = article.seoBeskrivelse || getPlainText(article.innhold, 200);
const seoImage = article.seoBilde?.url;

const articleJsonLd = articleSchema({
  headline: seoTitle,
  description: seoDesc,
  slug: slug!,
  datePublished: article.publishedAt,
  dateModified: article.updatedAt || article.publishedAt,
});
---

<Layout title={seoTitle} description={seoDesc} ogType="article" publishedAt={article.publishedAt} ogImage={seoImage}>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <div class="article-page">
    <div class="article-container">
      <nav class="breadcrumb" aria-label="Brødsmuler">
        <a href="/">Forside</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <a href="/artikler">Artikler</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <span aria-current="page">{article.tittel}</span>
      </nav>

      <header class="article-header">
        <h1 class="article-title">{article.tittel}</h1>
        <div class="article-meta">
          <span class="meta-date">
            <time datetime={article.publishedAt}>{formattedDate}</time>
          </span>
        </div>
      </header>

      <div class="article-layout">
        <article class="article-content">
          <BlocksRenderer blocks={article.innhold} class="article-body" />
        </article>

        {headings.length > 0 && (
          <aside class="article-sidebar">
            <SidebarCard title="Innhold">
              <nav aria-label="Innhold">
                <ul class="toc-list">
                  {headings.map(h => (
                    <li class={h.level === 3 ? 'toc-sub' : ''}>
                      <a href={`#${h.id}`}>{h.text}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            </SidebarCard>
          </aside>
        )}
      </div>
    </div>

    <ContactCard />
  </div>
</Layout>

<style>
  .article-page {
    padding-top: var(--ds-size-4);
  }

  .article-container {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 var(--ds-size-4);
  }

  /* Breadcrumbs */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: #64748b;
    margin-bottom: var(--ds-size-6);
    padding-bottom: var(--ds-size-4);
    border-bottom: 1px solid #e2e8f0;
    flex-wrap: wrap;
  }

  .breadcrumb a {
    color: #64748b;
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .breadcrumb-sep {
    color: #cbd5e1;
  }

  .breadcrumb [aria-current] {
    color: #64748b;
  }

  /* Header */
  .article-header {
    margin-bottom: var(--ds-size-8);
    max-width: 720px;
  }

  .article-title {
    font-size: 2.25rem;
    font-weight: 800;
    margin: 0 0 var(--ds-size-4);
    color: #0d131b;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  @media (min-width: 768px) {
    .article-title {
      font-size: 3rem;
    }
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: var(--ds-size-4);
  }

  .meta-date {
    font-size: 0.875rem;
    color: #64748b;
  }

  /* Two-column layout */
  .article-layout {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-10);
  }

  @media (min-width: 1024px) {
    .article-layout {
      flex-direction: row;
    }
  }

  .article-content {
    flex: 1;
    min-width: 0;
    max-width: 720px;
  }

  :global(.article-body) {
    line-height: 1.7;
  }

  :global(.article-body h2),
  :global(.article-body h3) {
    scroll-margin-top: 100px;
  }

  /* Sidebar */
  .article-sidebar {
    width: 100%;
  }

  @media (min-width: 1024px) {
    .article-sidebar {
      width: 300px;
      flex-shrink: 0;
      position: sticky;
      top: 100px;
      align-self: flex-start;
    }
  }

  /* TOC list inside SidebarCard */
  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc-list li {
    margin-bottom: 0.25rem;
  }

  .toc-list li.toc-sub {
    padding-left: var(--ds-size-4);
  }

  .toc-list a {
    display: block;
    padding: 0.375rem 0.5rem;
    font-size: 0.875rem;
    color: #334155;
    text-decoration: none;
    border-radius: 6px;
    transition: background-color 0.15s ease, color 0.15s ease;
    line-height: 1.4;
  }

  .toc-list a:hover {
    background: #f1f5f9;
    color: #136dec;
  }
</style>
