---
import Layout from '../../components/layout/Layout.astro';
import ArticleCard from '../../components/shared/ArticleCard.astro';
import { Heading, Paragraph, Button } from '@digdir/designsystemet-react';
import { getArtikler, type Artikkel, type BlockNode } from '../../lib/strapi';

// Helper to extract text from blocks for excerpt
function getExcerpt(blocks?: BlockNode[]): string {
  if (!blocks || blocks.length === 0) return '';
  const firstParagraph = blocks.find(b => b.type === 'paragraph');
  if (!firstParagraph?.children) return '';
  return firstParagraph.children
    .filter(c => c.type === 'text')
    .map(c => c.text || '')
    .join('')
    .slice(0, 200) + '...';
}

// Fetch articles from Strapi
let articles: Artikkel[] = [];
try {
  const response = await getArtikler();
  articles = response.data;
} catch (error) {
  console.error('Failed to fetch articles:', error);
}
---

<Layout title="Artikler" description="Nyheter, analyser og veiledning om kunstig intelligens i offentlig sektor.">
  <section class="page-hero">
    <div class="hero-container">
      <span class="page-badge">Artikler</span>
      <Heading level={1} size="2xlarge" className="page-title">Siste nytt</Heading>
      <Paragraph size="large" className="page-lead">
        Hold deg oppdatert pa nyheter, analyser og veiledning om kunstig intelligens i norsk offentlig sektor.
      </Paragraph>
    </div>
  </section>

  <div class="page-content">
    <div class="articles-grid">
      {articles.length > 0 ? (
        articles.map((article) => (
          <ArticleCard
            title={article.tittel}
            excerpt={getExcerpt(article.innhold)}
            slug={article.slug}
            publishedAt={article.publishedAt}
            category="Nyhet"
          />
        ))
      ) : (
        <div class="empty-state">
          <span class="material-symbols-outlined empty-icon">article</span>
          <Paragraph>Ingen artikler funnet.</Paragraph>
        </div>
      )}
    </div>

    {articles.length > 12 && (
      <nav class="pagination">
        <Button variant="secondary" size="small" disabled>Forrige</Button>
        <Paragraph size="small" className="pagination-info">Side 1 av 1</Paragraph>
        <Button variant="secondary" size="small" disabled>Neste</Button>
      </nav>
    )}
  </div>
</Layout>

<style>
  .page-hero {
    background: linear-gradient(
      135deg,
      var(--ds-color-neutral-background-default) 0%,
      var(--ds-color-accent-surface-default) 100%
    );
    padding: var(--ds-size-12) var(--ds-size-4);
  }

  .hero-container {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .page-badge {
    display: inline-flex;
    font-size: var(--ds-font-size-0);
    font-weight: var(--ds-font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ds-color-accent-text-default);
    background-color: var(--ds-color-neutral-surface-default);
    padding: var(--ds-size-1) var(--ds-size-3);
    border-radius: var(--ds-border-radius-full);
    margin-bottom: var(--ds-size-4);
  }

  :global(.page-title) {
    margin: 0 0 var(--ds-size-4);
  }

  :global(.page-lead) {
    margin: 0;
    color: var(--ds-color-neutral-text-subtle);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .page-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--ds-size-10) var(--ds-size-4);
  }

  .articles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--ds-size-6);
    margin-bottom: var(--ds-size-10);
  }

  @media (min-width: 640px) {
    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .articles-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .empty-state {
    grid-column: 1 / -1;
    text-align: center;
    padding: var(--ds-size-12);
    background-color: var(--ds-color-neutral-surface-default);
    border-radius: var(--ds-border-radius-lg);
  }

  .empty-icon {
    font-size: 48px;
    color: var(--ds-color-neutral-text-subtle);
    opacity: 0.5;
    margin-bottom: var(--ds-size-4);
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--ds-size-4);
  }

  :global(.pagination-info) {
    margin: 0;
    color: var(--ds-color-neutral-text-subtle);
  }
</style>
