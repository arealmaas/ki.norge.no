---
import Layout from '../../components/layout/Layout.astro';
import ArticleCard from '../../components/shared/ArticleCard.astro';
import { Heading, Paragraph, Button } from '@digdir/designsystemet-react';
import { getArtikler, getPlainText, type Artikkel } from '../../lib/umbraco';

// Fetch articles from Umbraco
let articles: Artikkel[] = [];
try {
  const response = await getArtikler();
  articles = response.data;
} catch (error) {
  console.error('Failed to fetch articles:', error);
}

// Extract unique categories from article content (using simple keyword detection)
// In a real setup these would come from article metadata/merkelapper
const categoryKeywords: Record<string, string[]> = {
  'Nyhet': ['nyhet', 'lansering', 'oppdatering'],
  'Analyse': ['analyse', 'rapport', 'undersøkelse', 'studie'],
  'Veiledning': ['veiledning', 'guide', 'hvordan', 'tips'],
};

function getArticleCategory(article: Artikkel): string {
  const text = (article.tittel + ' ' + getPlainText(article.innhold, 200)).toLowerCase();
  for (const [category, keywords] of Object.entries(categoryKeywords)) {
    if (keywords.some(kw => text.includes(kw))) return category;
  }
  return 'Nyhet';
}

const articlesWithCategory = articles.map(a => ({
  ...a,
  category: getArticleCategory(a),
}));

const availableCategories = [...new Set(articlesWithCategory.map(a => a.category))].sort();
---

<Layout title="Artikler" description="Nyheter, analyser og veiledning om kunstig intelligens i offentlig sektor.">
  <section class="page-hero">
    <div class="hero-container">
      <span class="page-badge">Artikler</span>
      <Heading level={1} size="2xlarge" className="page-title">Siste nytt</Heading>
      <Paragraph size="large" className="page-lead">
        Hold deg oppdatert på nyheter, analyser og veiledning om kunstig intelligens i norsk offentlig sektor.
      </Paragraph>
    </div>
  </section>

  <div class="page-content">
    {availableCategories.length > 1 && (
      <nav class="filter-nav" aria-label="Artikkelkategorier">
        <div class="filter-pills">
          <button class="filter-pill filter-pill--active" data-filter="alle">Alle</button>
          {availableCategories.map(cat => (
            <button class="filter-pill" data-filter={cat}>{cat}</button>
          ))}
        </div>
      </nav>
    )}

    <div class="articles-grid">
      {articlesWithCategory.length > 0 ? (
        articlesWithCategory.map((article) => (
          <div class="article-wrapper" data-category={article.category}>
            <ArticleCard
              title={article.tittel}
              excerpt={getPlainText(article.innhold, 200)}
              slug={article.slug}
              publishedAt={article.publishedAt}
              category={article.category}
            />
          </div>
        ))
      ) : (
        <div class="empty-state-box">
          <span class="material-symbols-outlined">article</span>
          <Paragraph>Ingen artikler funnet.</Paragraph>
        </div>
      )}
    </div>
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const pills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
    const articles = document.querySelectorAll<HTMLElement>('.article-wrapper');

    if (pills.length === 0) return;

    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        const filter = pill.dataset.filter;

        // Update active pill
        pills.forEach(p => p.classList.remove('filter-pill--active'));
        pill.classList.add('filter-pill--active');

        // Show/hide articles
        articles.forEach(article => {
          if (filter === 'alle' || article.dataset.category === filter) {
            article.style.display = '';
          } else {
            article.style.display = 'none';
          }
        });
      });
    });
  });
</script>

<style>
  .page-hero {
    background: linear-gradient(
      135deg,
      var(--ds-color-neutral-background-default) 0%,
      var(--ds-color-accent-surface-default) 100%
    );
    padding: var(--ds-size-12) var(--ds-size-4);
  }

  .hero-container {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .page-badge {
    display: inline-flex;
    font-size: var(--ds-font-size-0);
    font-weight: var(--ds-font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ds-color-accent-text-default);
    background-color: var(--ds-color-neutral-surface-default);
    padding: var(--ds-size-1) var(--ds-size-3);
    border-radius: var(--ds-border-radius-full);
    margin-bottom: var(--ds-size-4);
  }

  :global(.page-title) {
    margin: 0 0 var(--ds-size-4);
  }

  :global(.page-lead) {
    margin: 0;
    color: var(--ds-color-neutral-text-subtle);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .page-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--ds-size-10) var(--ds-size-4);
  }

  .filter-nav {
    margin-bottom: var(--ds-size-8);
  }

  .articles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--ds-size-6);
    margin-bottom: var(--ds-size-10);
  }

  @media (min-width: 640px) {
    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .articles-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .empty-state-box {
    grid-column: 1 / -1;
    text-align: center;
    padding: var(--ds-size-12);
    background-color: var(--ds-color-neutral-surface-default);
    border-radius: var(--ds-border-radius-lg);
  }

  .empty-state-box .material-symbols-outlined {
    font-size: 48px;
    color: var(--ds-color-neutral-text-subtle);
    opacity: 0.5;
    margin-bottom: var(--ds-size-4);
  }
</style>
