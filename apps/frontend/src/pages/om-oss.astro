---
import Layout from '../components/layout/Layout.astro';
import BlocksRenderer from '../components/shared/BlocksRenderer.astro';
import { Heading, Paragraph, Link } from '@digdir/designsystemet-react';
import { getSide } from '../lib/strapi';

// Check for preview mode
const isPreview = Astro.url.searchParams.has('preview') || Astro.cookies.has('preview');

// Fetch page content from Strapi
let page = null;
try {
  page = await getSide('om-oss', { preview: isPreview });
} catch (error) {
  console.error('Failed to fetch om-oss page:', error);
}

const title = page?.tittel || 'Om oss';
const seoDescription = page?.seoBeskrivelse || 'Lar mer om KI Norge og vart arbeid med kunstig intelligens i offentlig sektor.';
---

<Layout title={title} description={seoDescription}>
  <section class="page-hero">
    <div class="hero-container">
      <span class="page-badge">Om KI Norge</span>
      <Heading level={1} size="2xlarge" className="page-title">{title}</Heading>
      <Paragraph size="large" className="page-lead">
        Et samarbeid mellom Nkom, Datatilsynet og Digdir for a fremme ansvarlig bruk av kunstig intelligens i offentlig sektor.
      </Paragraph>
    </div>
  </section>

  <div class="page-content">
    {page?.innhold ? (
      <BlocksRenderer blocks={page.innhold} className="content-blocks" />
    ) : (
      <div class="not-found">
        <span class="material-symbols-outlined empty-icon">info</span>
        <Heading level={2} size="medium">Siden er ikke tilgjengelig</Heading>
        <Paragraph>
          Denne siden er ikke publisert ennå. Vennligst prøv igjen senere.
        </Paragraph>
        <Link href="/">Gå til forsiden</Link>
      </div>
    )}
  </div>
</Layout>

<style>
  .page-hero {
    background: linear-gradient(
      135deg,
      var(--ds-color-neutral-background-default) 0%,
      var(--ds-color-accent-surface-default) 100%
    );
    padding: var(--ds-size-12) var(--ds-size-4);
  }

  .hero-container {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .page-badge {
    display: inline-flex;
    font-size: var(--ds-font-size-0);
    font-weight: var(--ds-font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ds-color-accent-text-default);
    background-color: var(--ds-color-neutral-surface-default);
    padding: var(--ds-size-1) var(--ds-size-3);
    border-radius: var(--ds-border-radius-full);
    margin-bottom: var(--ds-size-4);
  }

  :global(.page-title) {
    margin: 0 0 var(--ds-size-4);
  }

  :global(.page-lead) {
    margin: 0;
    color: var(--ds-color-neutral-text-subtle);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .page-content {
    max-width: 800px;
    margin: 0 auto;
    padding: var(--ds-size-10) var(--ds-size-4);
  }

  :global(.content-blocks) {
    line-height: 1.7;
  }

  :global(.content-blocks h2) {
    margin-top: var(--ds-size-10);
    margin-bottom: var(--ds-size-4);
  }

  :global(.content-blocks h3) {
    margin-top: var(--ds-size-8);
    margin-bottom: var(--ds-size-3);
  }

  :global(.content-blocks p) {
    margin-bottom: var(--ds-size-4);
    color: var(--ds-color-neutral-text-subtle);
  }

  :global(.content-blocks ul),
  :global(.content-blocks ol) {
    margin-bottom: var(--ds-size-4);
    padding-left: var(--ds-size-6);
    color: var(--ds-color-neutral-text-subtle);
  }

  :global(.content-blocks li) {
    margin-bottom: var(--ds-size-2);
  }

  .not-found {
    text-align: center;
    padding: var(--ds-size-12);
    background-color: var(--ds-color-neutral-surface-default);
    border-radius: var(--ds-border-radius-lg);
  }

  .empty-icon {
    font-size: 48px;
    color: var(--ds-color-neutral-text-subtle);
    opacity: 0.5;
    margin-bottom: var(--ds-size-4);
  }

  .not-found :global(h2) {
    margin: 0 0 var(--ds-size-4);
  }

  .not-found :global(p) {
    margin: 0 0 var(--ds-size-6);
    color: var(--ds-color-neutral-text-subtle);
  }
</style>
