---
import Layout from '../components/layout/Layout.astro';
import BlocksRenderer from '../components/shared/BlocksRenderer.astro';
import PartnersSection from '../components/shared/PartnersSection.astro';
import { getOmOss, getOmOssSeksjoner, getMediaUrl, getPlainText } from '../lib/umbraco';

const omOss = await getOmOss();
const seksjonerRes = await getOmOssSeksjoner();
const seksjoner = seksjonerRes.data;

const heroTittel = omOss?.heroTittel || 'KI Norge';
const heroUndertittel = omOss?.heroUndertittel || 'Verdigrunnlag';

const seoTitle = omOss?.seoTittel || 'Om oss';
const seoDesc = omOss?.seoBeskrivelse || 'Om KI Norge – en nasjonal satsing for ansvarlig bruk av kunstig intelligens.';
---

<Layout title={seoTitle} description={seoDesc}>
  <div class="om-oss-page">
    <!-- Hero -->
    <section class="om-oss-hero">
      <h1 class="om-oss-hero-title">{heroTittel}</h1>
      <p class="om-oss-hero-subtitle">{heroUndertittel}</p>
    </section>

    <!-- Intro -->
    {omOss?.introTekst && (
      <section class="om-oss-intro">
        <div class="om-oss-intro-inner">
          <BlocksRenderer blocks={omOss.introTekst} class="om-oss-intro-text" />
        </div>
      </section>
    )}

    <!-- Alternating stubs -->
    <div class="om-oss-seksjoner">
      {seksjoner.map((seksjon, index) => (
        <section class:list={['om-oss-stub', index % 2 === 0 ? 'stub--image-left' : 'stub--image-right']}>
          <div class="stub-image" aria-hidden="true">
            {seksjon.bilde ? (
              <img src={getMediaUrl(seksjon.bilde)} alt={seksjon.bilde.alternativeText || seksjon.tittel} loading="lazy" />
            ) : (
              <div class="stub-image-placeholder"></div>
            )}
          </div>
          <div class="stub-content">
            <h2 class="stub-title">{seksjon.tittel}</h2>
            <div class="stub-text">
              <BlocksRenderer blocks={seksjon.tekst} />
            </div>
          </div>
        </section>
      ))}
    </div>

    <!-- Partners -->
    <PartnersSection />
  </div>
</Layout>

<style>
  .om-oss-page {
    margin-top: -72px;
  }

  /* Hero */
  .om-oss-hero {
    background-color: #8bc9ce;
    height: 584px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px;
    text-align: center;
  }

  .om-oss-hero-title {
    font-size: 3rem;
    font-weight: 700;
    color: white;
    margin: 0;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  @media (min-width: 768px) {
    .om-oss-hero-title {
      font-size: 6rem;
    }
  }

  .om-oss-hero-subtitle {
    font-size: 1.25rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.75);
    margin: 48px 0 0;
    letter-spacing: -0.0025em;
  }

  @media (min-width: 768px) {
    .om-oss-hero-subtitle {
      font-size: 1.5rem;
    }
  }

  /* Intro */
  .om-oss-intro {
    padding: 54px 24px;
  }

  .om-oss-intro-inner {
    max-width: 884px;
    margin: 0 auto;
  }

  :global(.om-oss-intro-text) {
    font-size: 1.5rem;
    line-height: 1.7;
    color: #000;
    text-align: center;
    letter-spacing: 0.005em;
  }

  :global(.om-oss-intro-text p) {
    margin: 0;
  }

  /* Alternating stubs */
  .om-oss-seksjoner {
    display: flex;
    flex-direction: column;
    gap: 54px;
    max-width: 930px;
    margin: 0 auto;
    padding: 0 24px 54px;
  }

  .om-oss-stub {
    display: flex;
    flex-direction: column;
    gap: 32px;
    align-items: center;
  }

  @media (min-width: 768px) {
    .om-oss-stub {
      flex-direction: row;
      gap: 99px;
    }

    .stub--image-right {
      flex-direction: row-reverse;
    }
  }

  .stub-image {
    flex: 1;
    min-width: 0;
  }

  .stub-image img {
    width: 100%;
    height: 487px;
    object-fit: cover;
    border-radius: 4px;
    display: block;
    background-color: var(--image-fallback-bg, #D9D9D9);
  }

  .stub-image-placeholder {
    width: 100%;
    height: 487px;
    background-color: var(--image-fallback-bg, #D9D9D9);
    border-radius: 4px;
  }

  .stub-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 32px;
    justify-content: center;
  }

  .stub-title {
    font-size: 2rem;
    font-weight: 400;
    color: #000;
    margin: 0;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  @media (min-width: 768px) {
    .stub-title {
      font-size: 3rem;
    }
  }

  .stub-text {
    font-size: 1.125rem;
    font-weight: 500;
    color: rgba(0, 0, 0, 0.75);
    line-height: 1.3;
    letter-spacing: -0.0025em;
  }

  :global(.stub-text p) {
    margin: 0;
  }
</style>
