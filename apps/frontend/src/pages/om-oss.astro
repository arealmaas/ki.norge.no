---
// TODO: Make this page CMS-driven. The omOss and omOssSeksjon content types
// already exist in Umbraco. Replace hardcoded stubs with getOmOss() for
// hero/intro and getOmOssSeksjoner() for the alternating stubs.
import Layout from '../components/layout/Layout.astro';
import PartnersSection from '../components/shared/PartnersSection.astro';

const stubs = [
  {
    tittel: 'Hvorfor KI Norge?',
    tekst: 'Mange virksomheter vil ta i bruk kunstig intelligens, men vet ikke helt hvor de skal begynne, eller om de gjør det riktig. Det er der KI Norge kommer inn.',
  },
  {
    tittel: 'Veiledning',
    tekst: 'Sammen med Datatilsynet og Nasjonal kommunikasjonsmyndighet (Nkom) gir vi praktisk veiledning, særlig for deg som ikke har et eget juridisk team eller KI-eksperter i staben. Vi hjelper deg å forstå hvilke krav som gjelder, identifisere risiko og finne ut hva du faktisk trenger å forholde deg til.',
  },
  {
    tittel: 'Den regulatoriske KI-sandkassen',
    tekst: 'I KI-sandkassen kan du utvikle, teste og trene KI-løsninger i trygge og kontrollerte omgivelser, før du lanserer dem i markedet eller tar dem i bruk internt. Du får juridisk veiledning knyttet til personvern, grunnleggende rettigheter og sikkerhet, og hjelp til å oppfylle kravene i KI-forordningen og annet relevant regelverk.',
  },
];
---

<Layout title="Om oss" description="Om KI Norge – en nasjonal satsing for ansvarlig bruk av kunstig intelligens.">
  <div class="om-oss-page">
    <!-- Hero -->
    <section class="om-oss-hero">
      <h1 class="om-oss-hero-title">KI Norge</h1>
      <p class="om-oss-hero-subtitle">Verdigrunnlag</p>
    </section>

    <!-- Intro -->
    <section class="om-oss-intro">
      <div class="om-oss-intro-inner">
        <p class="om-oss-intro-text">KI Norge er en nasjonal satsing under Digitaliseringsdirektoratet (Digdir). Formålet er å gjøre det enklere for norske virksomheter å ta i bruk KI på en måte som er trygg, lovlig og verdiskapende, enten du driver en liten privat bedrift eller jobber i en offentlig virksomhet.</p>
      </div>
    </section>

    <!-- Alternating stubs -->
    <div class="om-oss-seksjoner">
      {stubs.map((stub, index) => (
        <section class:list={['om-oss-stub', index % 2 === 0 ? 'stub--image-left' : 'stub--image-right']}>
          <div class="stub-image" aria-hidden="true">
            <div class="stub-image-placeholder"></div>
          </div>
          <div class="stub-content">
            <h2 class="stub-title">{stub.tittel}</h2>
            <p class="stub-text">{stub.tekst}</p>
          </div>
        </section>
      ))}
    </div>

    <!-- Partners -->
    <PartnersSection />
  </div>
</Layout>

<style>
  .om-oss-page {
    margin-top: -72px;
  }

  /* Hero */
  .om-oss-hero {
    background-color: #8bc9ce;
    height: 584px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px;
    text-align: center;
  }

  .om-oss-hero-title {
    font-size: 3rem;
    font-weight: 700;
    color: white;
    margin: 0;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  @media (min-width: 768px) {
    .om-oss-hero-title {
      font-size: 6rem;
    }
  }

  .om-oss-hero-subtitle {
    font-size: 1.25rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.75);
    margin: 48px 0 0;
    letter-spacing: -0.0025em;
  }

  @media (min-width: 768px) {
    .om-oss-hero-subtitle {
      font-size: 1.5rem;
    }
  }

  /* Intro */
  .om-oss-intro {
    padding: 54px 24px;
  }

  .om-oss-intro-inner {
    max-width: 884px;
    margin: 0 auto;
  }

  .om-oss-intro-text {
    font-size: 1.5rem;
    line-height: 1.7;
    color: #000;
    text-align: center;
    letter-spacing: 0.005em;
    margin: 0;
  }

  /* Alternating stubs */
  .om-oss-seksjoner {
    display: flex;
    flex-direction: column;
    gap: 54px;
    max-width: 930px;
    margin: 0 auto;
    padding: 0 24px 54px;
  }

  .om-oss-stub {
    display: flex;
    flex-direction: column;
    gap: 32px;
    align-items: center;
  }

  @media (min-width: 768px) {
    .om-oss-stub {
      flex-direction: row;
      gap: 99px;
    }

    .stub--image-right {
      flex-direction: row-reverse;
    }
  }

  .stub-image {
    flex: 1;
    min-width: 0;
  }

  .stub-image img {
    width: 100%;
    height: 487px;
    object-fit: cover;
    border-radius: 4px;
    display: block;
    background-color: var(--image-fallback-bg, #D9D9D9);
  }

  .stub-image-placeholder {
    width: 100%;
    height: 487px;
    background-color: var(--image-fallback-bg, #D9D9D9);
    border-radius: 4px;
  }

  .stub-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 32px;
    justify-content: center;
  }

  .stub-title {
    font-size: 2rem;
    font-weight: 400;
    color: #000;
    margin: 0;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  @media (min-width: 768px) {
    .stub-title {
      font-size: 3rem;
    }
  }

  .stub-text {
    font-size: 1.125rem;
    font-weight: 500;
    color: rgba(0, 0, 0, 0.75);
    line-height: 1.3;
    letter-spacing: -0.0025em;
    margin: 0;
  }
</style>
