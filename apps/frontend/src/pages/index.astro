---
import Layout from '../components/layout/Layout.astro';
import Hero from '../components/landing/Hero.astro';
import GuidanceCards from '../components/landing/GuidanceCards.astro';
import ExamplesShowcase from '../components/landing/ExamplesShowcase.astro';
import ThreeTips from '../components/landing/ThreeTips.astro';
import SandboxSection from '../components/landing/SandboxSection.astro';
import UpcomingEvents from '../components/landing/UpcomingEvents.astro';
import { getEksempler, getPlainText, getSide, type Eksempel } from '../lib/umbraco';
import { websiteSchema } from '../lib/seo';

// Fetch examples for ExamplesShowcase section
let eksempler: Eksempel[] = [];
try {
  const eksemplerRes = await getEksempler();
  eksempler = (eksemplerRes.data || []).slice(0, 3);
} catch (error) {
  console.error('Failed to fetch examples for homepage:', error);
}

// Transform examples for ExamplesShowcase component
const examples = eksempler.map(e => ({
  title: e.tittel,
  organization: e.organisasjon || 'Offentlig sektor',
  slug: e.slug,
  description: e.beskrivelse ? getPlainText(e.beskrivelse, 120) : undefined,
  image: e.bilde?.url,
}));

// Fetch homepage content from CMS (optional)
let forside = null;
try {
  forside = await getSide('forside');
} catch (error) {
  // Homepage content is optional
}

const title = forside?.seoTittel || forside?.tittel || 'Hjem';
const seoDescription = forside?.seoBeskrivelse || 'KI Norge - Norges nasjonale strategi for kunstig intelligens. Veiledning, regulatorisk sandkasse og gode eksempler for offentlig sektor.';
const seoImage = forside?.seoBilde?.url;

const websiteJsonLd = websiteSchema(seoDescription);
---

<Layout title={title} description={seoDescription} ogImage={seoImage}>
  <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
  <Hero />
  <GuidanceCards />
  <ExamplesShowcase examples={examples} />
  <ThreeTips />
  <SandboxSection />
  <UpcomingEvents />
</Layout>
