---
import Layout from '../../components/layout/Layout.astro';
import BlocksRenderer from '../../components/shared/BlocksRenderer.astro';
import ContactCard from '../../components/shared/ContactCard.astro';
import SidebarCard from '../../components/shared/SidebarCard.astro';

import { getEksempel, getEksempler, getPlainText, getMediaUrl, type Eksempel } from '../../lib/umbraco';

const { slug } = Astro.params;
const isPreview = Astro.url.searchParams.has('preview') || !!Astro.cookies.get('preview')?.value;

const caseItem = await getEksempel(slug!, { preview: isPreview });
if (!caseItem) return Astro.redirect('/eksempler');

// Find next case for "Neste steg" sidebar card
const allCases = await getEksempler();
const currentIndex = allCases.data.findIndex(c => c.slug === slug);
let nextCase: Eksempel | null = null;
if (currentIndex !== -1 && currentIndex < allCases.data.length - 1) {
  nextCase = allCases.data[currentIndex + 1];
} else if (allCases.data.length > 1) {
  nextCase = allCases.data[0];
}

const seoTitle = caseItem.seoTittel || caseItem.tittel;
const seoDesc = caseItem.seoBeskrivelse || getPlainText(caseItem.beskrivelse, 200);
const seoImage = caseItem.seoBilde?.url;
---

<Layout title={seoTitle} description={seoDesc} ogType="article" ogImage={seoImage}>
  <div class="article-page">
    <div class="article-container">
      <nav class="breadcrumb" aria-label="Brødsmuler">
        <a href="/">Forside</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <a href="/eksempler">Caser</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <span aria-current="page">{caseItem.tittel}</span>
      </nav>

      <header class="article-header">
        <div class="article-hero">
          <div class="article-hero-text">
            <h1 class="article-title">{caseItem.tittel}</h1>

            {caseItem.merkelapper && caseItem.merkelapper.length > 0 && (
              <div class="tag-pills">
                {caseItem.merkelapper.map(tag => (
                  <span class="tag-pill">{tag.navn}</span>
                ))}
              </div>
            )}

            <p class="article-lead">{getPlainText(caseItem.beskrivelse, 200)}</p>
          </div>
          <div class="article-hero-image">
            {caseItem.bilde ? (
              <div class="article-hero-image-wrap">
                <img src={getMediaUrl(caseItem.bilde)} alt={caseItem.bilde.alternativeText || caseItem.tittel} loading="lazy" />
                <div class="article-hero-image-overlay"></div>
              </div>
            ) : (
              <div class="article-hero-image-placeholder">
                <div class="article-hero-image-overlay"></div>
              </div>
            )}
          </div>
        </div>
      </header>

      <div class="article-layout">
        <article class="article-content">
          <BlocksRenderer blocks={caseItem.beskrivelse} class="article-body" />
        </article>

        <aside class="article-sidebar">
          <SidebarCard title="Dette lærte vi" variant="highlight" icon="learn">
            <BlocksRenderer blocks={caseItem.resultater} />
            {caseItem.accordionSeksjoner?.map(section => (
              <details>
                <summary>{section.title}</summary>
                <div>
                  <BlocksRenderer blocks={section.body} />
                </div>
              </details>
            ))}
          </SidebarCard>

          {nextCase && (
            <SidebarCard title="Neste steg" icon="clock">
              <p><a href={`/eksempler/${nextCase.slug}`}>{nextCase.tittel}</a></p>
            </SidebarCard>
          )}
        </aside>
      </div>
    </div>

    <ContactCard />
  </div>
</Layout>

<style>
  .article-page {
    padding-top: var(--ds-size-4);
  }

  .article-container {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 var(--ds-size-4);
  }

  /* Breadcrumbs */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    color: #000;
    margin-bottom: var(--ds-size-6);
    flex-wrap: wrap;
  }

  .breadcrumb a {
    color: #000;
    text-decoration: underline;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .breadcrumb-sep {
    color: #cbd5e1;
  }

  .breadcrumb [aria-current] {
    color: #000;
    text-decoration: none;
  }

  /* Header */
  .article-header {
    margin-bottom: var(--ds-size-8);
  }

  .article-hero {
    display: flex;
    gap: var(--ds-size-8);
    align-items: flex-start;
  }

  .article-hero-text {
    flex: 1;
    min-width: 0;
    max-width: 720px;
  }

  .article-hero-image {
    display: none;
    width: 407px;
    flex-shrink: 0;
  }

  @media (min-width: 1024px) {
    .article-hero-image {
      display: block;
    }
  }

  .article-hero-image-wrap {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
  }

  .article-hero-image img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  .article-hero-image-placeholder {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
    border-radius: 16px;
    overflow: hidden;
  }

  .article-hero-image-overlay {
    position: absolute;
    inset: 0;
    border-radius: 16px;
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0.2) 71.6%, rgba(0, 0, 0, 0.2));
    pointer-events: none;
  }

  .article-title {
    font-size: 2.25rem;
    font-weight: 800;
    margin: 0 0 var(--ds-size-4);
    color: #0d131b;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  @media (min-width: 768px) {
    .article-title {
      font-size: 3rem;
    }
  }

  /* Tag pills */
  .tag-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: var(--ds-size-4);
  }

  .tag-pill {
    display: inline-flex;
    font-size: 0.8125rem;
    font-weight: 400;
    padding: 0.25rem 0.75rem;
    background-color: #f1f5f9;
    border: 1px solid #e2e8f0;
    border-radius: 9999px;
    color: #334155;
  }

  /* Lead text */
  .article-lead {
    font-size: var(--ds-font-size-5, 21px);
    line-height: 1.7;
    color: rgba(0,0,0,0.75);
    margin: 0;
  }

  /* Two-column layout */
  .article-layout {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-10);
  }

  @media (min-width: 1024px) {
    .article-layout {
      flex-direction: row;
    }
  }

  .article-content {
    flex: 1;
    min-width: 0;
    max-width: 720px;
  }

  :global(.article-body) {
    font-size: var(--ds-font-size-4, 18px);
    line-height: 1.7;
    color: rgba(0,0,0,0.75);
  }

  :global(.article-body h2) {
    font-size: var(--ds-font-size-7, 30px);
    font-weight: 500;
    color: #0d131b;
    scroll-margin-top: 100px;
  }

  :global(.article-body h3) {
    scroll-margin-top: 100px;
  }

  /* Sidebar */
  .article-sidebar {
    width: 100%;
  }

  @media (min-width: 1024px) {
    .article-sidebar {
      width: 340px;
      flex-shrink: 0;
      position: sticky;
      top: 100px;
      align-self: flex-start;
    }
  }
</style>
