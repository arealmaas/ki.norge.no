---
import Layout from '../../components/layout/Layout.astro';
import BlocksRenderer from '../../components/shared/BlocksRenderer.astro';
import ContactCard from '../../components/shared/ContactCard.astro';
import SidebarCard from '../../components/shared/SidebarCard.astro';

import { getEksempel, getEksempler, getPlainText, type Eksempel, type UmbracoBlock } from '../../lib/umbraco';

// Demo article for showcasing the page design
const DEMO_EKSEMPEL: Record<string, Eksempel> = {
  kunnskapsassistenten: {
    id: 'demo-1',
    documentId: 'demo-1',
    tittel: 'Kunnskapsassistenten',
    slug: 'kunnskapsassistenten',
    organisasjon: 'Digitaliseringsdirektoratet',
    beskrivelse: [
      { contentType: 'tekst', content: { innhold: `
        <p>Kunnskapsassistenten skal styrke – ikke erstatte – faglige vurderinger i staten. Piloten viser at den har størst verdi i starten av en kunnskapsprosess, og at vi må øke presisjonen, kunnskapsforberedelsen og kontrolltiltakene videre når oppgavene krever flere steg.</p>

        <h2>Utfordringen vi skulle løse</h2>
        <p>Målet har vært å undersøke hvordan KI kan støtte raske utredningsprosesser – på en trygg, åpen og faglig forsvarlig måte.</p>
        <p>Kunnskapsproduksjon i staten er krevende og tidkrevende. Informasjon er fragmentert, spredt på tvers av mange kilder og i stadig endring. I tillegg utvikler vi ikke kunnskapsgrunnlaget godt nok, og det øker risikoen for feilaktige beslutninger. Samling av informasjonsinnhenting bidrar til effektivitet, kvalitet og transparens.</p>

        <h2>Løsning</h2>
        <p>Kunnskapsassistenten er et spesialisert KI-verktøy for kunnskapsarbeid i offentlig sektor. Den hjelper brukerne med å finne, sammenstille og vurdere informasjon fra store mengder kilder, og har innebygde mekanismer for kontroll og etterprøvelighet.</p>
        <p>Kunnskapsassistenten skal støtte utforskende analyse, styrke menneskelig vurdering og faglig forankring slik at utredningsarbeidet og verifisering av informasjon blir bedre. I tråd med ansvarlig bruk fungerer den som et støtteverktøy – ikke en autonom beslutningstaker.</p>

        <h2>Resultat</h2>
        <p>Kunnskapsassistenten:</p>
        <ul>
          <li>Gir økt kunnskapstilgjengelighet for alle ansatte</li>
          <li>Reduserer tid brukt på informasjonsinnhenting og databehandling</li>
          <li>Økt kvalitet ved å presentere flere relevante datakilder</li>
          <li>Redusert behov for manuell koordinering på tvers av virksomheter</li>
          <li>Teknisk system som demonstrerer en ansvarlig, etterprøvelig og transparent bruk av KI</li>
          <li>Fortsatt avhengig av menneskelig vurdering i alle steg</li>
        </ul>
      `}}
    ] as UmbracoBlock[],
    resultater: 'Økt effektivitet i kunnskapsinnhenting, med resultater som viser trygg og ansvarlig bruk av KI.\nBrukertester viste at verktøyet oppleves som nyttig og pålitelig.\nPiloten viste at kunnskapsassistenten gir størst verdi i starten av en kunnskapsprosess – når brukere trenger bred orientering og bakgrunnskunnskap.\nI senere faser av et prosjekt styrker KI faglige vurderinger, men erstatter ikke menneskelig kompetanse.',
    merkelapper: [
      { id: 'm1', documentId: 'm1', navn: 'First project', slug: 'first-project', locale: 'nb-NO' },
      { id: 'm2', documentId: 'm2', navn: 'Se ansatte i retning', slug: 'se-ansatte-i-retning', locale: 'nb-NO' },
      { id: 'm3', documentId: 'm3', navn: 'LLM', slug: 'llm', locale: 'nb-NO' },
    ],
    status: 'pilot',
    createdAt: '2026-01-15T10:00:00Z',
    updatedAt: '2026-03-01T12:00:00Z',
    publishedAt: '2026-01-20T08:00:00Z',
    locale: 'nb-NO',
  },
};

const { slug } = Astro.params;
const isPreview = Astro.url.searchParams.has('preview') || !!Astro.cookies.get('preview')?.value;

// Try CMS first, fall back to demo article
let caseItem: Eksempel | null = null;
try {
  caseItem = await getEksempel(slug!, { preview: isPreview });
} catch {
  // CMS unavailable, will try demo fallback
}
if (!caseItem) {
  caseItem = DEMO_EKSEMPEL[slug!] || null;
}
if (!caseItem) return Astro.redirect('/eksempler');

// Find next case for "Neste steg" sidebar card
let nextCase: Eksempel | null = null;
try {
  const allCases = await getEksempler();
  const currentIndex = allCases.data.findIndex(c => c.slug === slug);
  if (currentIndex !== -1 && currentIndex < allCases.data.length - 1) {
    nextCase = allCases.data[currentIndex + 1];
  } else if (allCases.data.length > 1) {
    nextCase = allCases.data[0]; // Wrap around to first
  }
} catch {
  // Non-critical
}

const seoTitle = caseItem.seoTittel || caseItem.tittel;
const seoDesc = caseItem.seoBeskrivelse || getPlainText(caseItem.beskrivelse, 200);
const seoImage = caseItem.seoBilde?.url;
---

<Layout title={seoTitle} description={seoDesc} ogType="article" ogImage={seoImage}>
  <div class="article-page">
    <div class="article-container">
      <nav class="breadcrumb" aria-label="Brødsmuler">
        <a href="/">Forside</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <a href="/eksempler">Case</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <span aria-current="page">{caseItem.tittel}</span>
      </nav>

      <header class="article-header">
        <h1 class="article-title">{caseItem.tittel}</h1>

        {caseItem.merkelapper && caseItem.merkelapper.length > 0 && (
          <div class="tag-pills">
            {caseItem.merkelapper.map(tag => (
              <span class="tag-pill">{tag.navn}</span>
            ))}
          </div>
        )}

        <p class="article-lead">{getPlainText(caseItem.beskrivelse, 200)}</p>
      </header>

      <div class="article-layout">
        <article class="article-content">
          <BlocksRenderer blocks={caseItem.beskrivelse} class="article-body" />
        </article>

        <aside class="article-sidebar">
          {caseItem.resultater && (
            <SidebarCard title="Dette lærte vi" variant="highlight">
              <ul>
                {caseItem.resultater.split(/[\n•]/).filter(s => s.trim()).map(item => (
                  <li>{item.trim()}</li>
                ))}
              </ul>
            </SidebarCard>
          )}

          {nextCase && (
            <SidebarCard title="Neste steg">
              <p>{getPlainText(nextCase.beskrivelse, 120)}</p>
              <a href={`/eksempler/${nextCase.slug}`}>Les {nextCase.tittel} &rarr;</a>
            </SidebarCard>
          )}
        </aside>
      </div>
    </div>

    <ContactCard />
  </div>
</Layout>

<style>
  .article-page {
    padding-top: var(--ds-size-6);
  }

  @media (min-width: 768px) {
    .article-page {
      padding-top: var(--ds-size-10);
    }
  }

  .article-container {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 var(--ds-size-4);
  }

  /* Breadcrumbs */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: #64748b;
    margin-bottom: var(--ds-size-6);
    padding-bottom: var(--ds-size-4);
    border-bottom: 1px solid #e2e8f0;
    flex-wrap: wrap;
  }

  .breadcrumb a {
    color: #64748b;
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .breadcrumb-sep {
    color: #cbd5e1;
  }

  .breadcrumb [aria-current] {
    color: #64748b;
  }

  /* Header */
  .article-header {
    margin-bottom: var(--ds-size-8);
    max-width: 720px;
  }

  .article-title {
    font-size: 2.25rem;
    font-weight: 800;
    margin: 0 0 var(--ds-size-4);
    color: #0d131b;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  @media (min-width: 768px) {
    .article-title {
      font-size: 2.75rem;
    }
  }

  /* Tag pills */
  .tag-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: var(--ds-size-4);
  }

  .tag-pill {
    display: inline-flex;
    font-size: 0.8125rem;
    font-weight: 400;
    padding: 0.25rem 0.75rem;
    background-color: #f1f5f9;
    border: 1px solid #e2e8f0;
    border-radius: 9999px;
    color: #334155;
  }

  /* Lead text */
  .article-lead {
    font-size: 1.125rem;
    line-height: 1.6;
    color: #64748b;
    margin: 0;
  }

  /* Two-column layout */
  .article-layout {
    display: flex;
    gap: var(--ds-size-10);
  }

  .article-content {
    flex: 1;
    min-width: 0;
    max-width: 720px;
  }

  :global(.article-body) {
    line-height: 1.7;
  }

  :global(.article-body h2),
  :global(.article-body h3) {
    scroll-margin-top: 100px;
  }

  /* Sidebar */
  .article-sidebar {
    display: none;
    width: 300px;
    flex-shrink: 0;
  }

  @media (min-width: 1024px) {
    .article-sidebar {
      display: block;
      position: sticky;
      top: 100px;
      align-self: flex-start;
    }
  }
</style>
