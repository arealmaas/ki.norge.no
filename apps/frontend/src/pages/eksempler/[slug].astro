---
import Layout from '../../components/layout/Layout.astro';
import BlocksRenderer from '../../components/shared/BlocksRenderer.astro';
import ContactCard from '../../components/shared/ContactCard.astro';
import SidebarCard from '../../components/shared/SidebarCard.astro';

import { getEksempel, getEksempler, getPlainText, getMediaUrl, type Eksempel, type UmbracoBlock } from '../../lib/umbraco';

// Demo article for showcasing the page design
const DEMO_EKSEMPEL: Record<string, Eksempel> = {
  kunnskapsassistenten: {
    id: 'demo-1',
    documentId: 'demo-1',
    tittel: 'Kunnskapsassistenten',
    slug: 'kunnskapsassistenten',
    organisasjon: 'Digitaliseringsdirektoratet',
    beskrivelse: [
      { contentType: 'tekst', content: { innhold: `
        <p>Kunnskapsassistenten skal styrke – ikke erstatte – faglige vurderinger i staten. Piloten viser at den har størst verdi i starten av en kunnskapsprosess, og at vi må øke presisjonen, kunnskapsforberedelsen og kontrolltiltakene videre når oppgavene krever flere steg.</p>

        <h2>Utfordringen vi skulle løse</h2>
        <p>Målet har vært å undersøke hvordan KI kan støtte raske utredningsprosesser – på en trygg, åpen og faglig forsvarlig måte.</p>
        <p>Kunnskapsproduksjon i staten er krevende og tidkrevende. Informasjon er fragmentert, spredt på tvers av mange kilder og i stadig endring. I tillegg utvikler vi ikke kunnskapsgrunnlaget godt nok, og det øker risikoen for feilaktige beslutninger. Samling av informasjonsinnhenting bidrar til effektivitet, kvalitet og transparens.</p>

        <h2>Løsning</h2>
        <p>Kunnskapsassistenten er et spesialisert KI-verktøy for kunnskapsarbeid i offentlig sektor. Den hjelper brukerne med å finne, sammenstille og vurdere informasjon fra store mengder kilder, og har innebygde mekanismer for kontroll og etterprøvelighet.</p>
        <p>Kunnskapsassistenten skal støtte utforskende analyse, styrke menneskelig vurdering og faglig forankring slik at utredningsarbeidet og verifisering av informasjon blir bedre. I tråd med ansvarlig bruk fungerer den som et støtteverktøy – ikke en autonom beslutningstaker.</p>

        <h2>Resultat</h2>
        <p>Kunnskapsassistenten:</p>
        <ul>
          <li>Gir økt kunnskapstilgjengelighet for alle ansatte</li>
          <li>Reduserer tid brukt på informasjonsinnhenting og databehandling</li>
          <li>Økt kvalitet ved å presentere flere relevante datakilder</li>
          <li>Redusert behov for manuell koordinering på tvers av virksomheter</li>
          <li>Teknisk system som demonstrerer en ansvarlig, etterprøvelig og transparent bruk av KI</li>
          <li>Fortsatt avhengig av menneskelig vurdering i alle steg</li>
        </ul>
      `}}
    ] as UmbracoBlock[],
    resultater: 'Den største utfordringen er ikke teknologisk, men institusjonell: KI må oppleves som trygg, etterprøvbar og tillitsvekkende.',
    merkelapper: [
      { id: 'm1', documentId: 'm1', navn: 'Pilot prosjekt', slug: 'pilot-prosjekt', locale: 'nb-NO' },
      { id: 'm2', documentId: 'm2', navn: 'For ansatte i offentlig', slug: 'for-ansatte-i-offentlig', locale: 'nb-NO' },
      { id: 'm3', documentId: 'm3', navn: 'LLM', slug: 'llm', locale: 'nb-NO' },
    ],
    status: 'pilot',
    createdAt: '2026-01-15T10:00:00Z',
    updatedAt: '2026-03-01T12:00:00Z',
    publishedAt: '2026-01-20T08:00:00Z',
    locale: 'nb-NO',
  },
};

const { slug } = Astro.params;
const isPreview = Astro.url.searchParams.has('preview') || !!Astro.cookies.get('preview')?.value;

// Try CMS first, fall back to demo article
let caseItem: Eksempel | null = null;
try {
  caseItem = await getEksempel(slug!, { preview: isPreview });
} catch {
  // CMS unavailable, will try demo fallback
}
if (!caseItem) {
  caseItem = DEMO_EKSEMPEL[slug!] || null;
}
if (!caseItem) return Astro.redirect('/eksempler');

// Find next case for "Neste steg" sidebar card
let nextCase: Eksempel | null = null;
try {
  const allCases = await getEksempler();
  const currentIndex = allCases.data.findIndex(c => c.slug === slug);
  if (currentIndex !== -1 && currentIndex < allCases.data.length - 1) {
    nextCase = allCases.data[currentIndex + 1];
  } else if (allCases.data.length > 1) {
    nextCase = allCases.data[0]; // Wrap around to first
  }
} catch {
  // Non-critical
}

const seoTitle = caseItem.seoTittel || caseItem.tittel;
const seoDesc = caseItem.seoBeskrivelse || getPlainText(caseItem.beskrivelse, 200);
const seoImage = caseItem.seoBilde?.url;
---

<Layout title={seoTitle} description={seoDesc} ogType="article" ogImage={seoImage}>
  <div class="article-page">
    <div class="article-container">
      <nav class="breadcrumb" aria-label="Brødsmuler">
        <a href="/">Forside</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <a href="/eksempler">Caser</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <span aria-current="page">{caseItem.tittel}</span>
      </nav>

      <header class="article-header">
        <div class="article-hero">
          <div class="article-hero-text">
            <h1 class="article-title">{caseItem.tittel}</h1>

            {caseItem.merkelapper && caseItem.merkelapper.length > 0 && (
              <div class="tag-pills">
                {caseItem.merkelapper.map(tag => (
                  <span class="tag-pill">{tag.navn}</span>
                ))}
              </div>
            )}

            <p class="article-lead">{getPlainText(caseItem.beskrivelse, 200)}</p>
          </div>
          <div class="article-hero-image">
            {caseItem.bilde ? (
              <div class="article-hero-image-wrap">
                <img src={getMediaUrl(caseItem.bilde)} alt={caseItem.bilde.alternativeText || caseItem.tittel} loading="lazy" />
                <div class="article-hero-image-overlay"></div>
              </div>
            ) : (
              <div class="article-hero-image-placeholder">
                <div class="article-hero-image-overlay"></div>
              </div>
            )}
          </div>
        </div>
      </header>

      <div class="article-layout">
        <article class="article-content">
          <BlocksRenderer blocks={caseItem.beskrivelse} class="article-body" />
        </article>

        <aside class="article-sidebar">
          {caseItem.resultater && (
            <SidebarCard title="Dette lærte vi" variant="highlight" icon="learn">
              <p>{caseItem.resultater}</p>
              <details>
                <summary>Brukerbehov vi avdekket i piloten</summary>
                <div>
                  <p>Piloten viste at kunnskapsassistenten gir størst verdi i tidlige faser av arbeidet – når brukeren skal orientere seg, oppsummere og finne relevante dokumenter. Brukerne var tydelige om hvordan KI kan være nyttig: KI må styrke faglige vurderinger – ikke gjøre dem mer sårbare.</p>
                </div>
              </details>
              <details>
                <summary>Slik bygger vi tillit til KI</summary>
                <div>
                  <p>Gjennom åpenhet om hvordan modellen fungerer, tydelige begrensninger og mulighet for brukerne å etterprøve svarene. Tillit bygges over tid gjennom erfaring og transparens.</p>
                </div>
              </details>
            </SidebarCard>
          )}

          {nextCase && (
            <SidebarCard title="Neste steg" icon="clock">
              <p>Kunnskapsassistenten er en KI-chat i betaversjon. Kunnskapsgrunnlaget til chatten er et avgrenset utdrag av Kudos-databasen. Den er brukertestet av 89 brukere i departementer og direktorater.</p>
              <details>
                <summary>Neste steg/veien videre</summary>
                <div>
                  <p>Vi planlegger å utvide kunnskapsgrunnlaget, forbedre presisjonen og rulle ut til flere virksomheter i 2026.</p>
                </div>
              </details>
            </SidebarCard>
          )}
        </aside>
      </div>
    </div>

    <ContactCard />
  </div>
</Layout>

<style>
  .article-page {
    padding-top: var(--ds-size-6);
  }

  @media (min-width: 768px) {
    .article-page {
      padding-top: var(--ds-size-10);
    }
  }

  .article-container {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 var(--ds-size-4);
  }

  /* Breadcrumbs */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    color: #000;
    margin-bottom: var(--ds-size-6);
    flex-wrap: wrap;
  }

  .breadcrumb a {
    color: #000;
    text-decoration: underline;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .breadcrumb-sep {
    color: #cbd5e1;
  }

  .breadcrumb [aria-current] {
    color: #000;
    text-decoration: none;
  }

  /* Header */
  .article-header {
    margin-bottom: var(--ds-size-8);
  }

  .article-hero {
    display: flex;
    gap: var(--ds-size-8);
    align-items: flex-start;
  }

  .article-hero-text {
    flex: 1;
    min-width: 0;
    max-width: 720px;
  }

  .article-hero-image {
    display: none;
    width: 407px;
    flex-shrink: 0;
  }

  @media (min-width: 1024px) {
    .article-hero-image {
      display: block;
    }
  }

  .article-hero-image-wrap {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
  }

  .article-hero-image img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  .article-hero-image-placeholder {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
    border-radius: 16px;
    overflow: hidden;
  }

  .article-hero-image-overlay {
    position: absolute;
    inset: 0;
    border-radius: 16px;
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0.2) 71.6%, rgba(0, 0, 0, 0.2));
    pointer-events: none;
  }

  .article-title {
    font-size: 2.25rem;
    font-weight: 800;
    margin: 0 0 var(--ds-size-4);
    color: #0d131b;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  @media (min-width: 768px) {
    .article-title {
      font-size: 3rem;
    }
  }

  /* Tag pills */
  .tag-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: var(--ds-size-4);
  }

  .tag-pill {
    display: inline-flex;
    font-size: 0.8125rem;
    font-weight: 400;
    padding: 0.25rem 0.75rem;
    background-color: #f1f5f9;
    border: 1px solid #e2e8f0;
    border-radius: 9999px;
    color: #334155;
  }

  /* Lead text */
  .article-lead {
    font-size: var(--ds-font-size-5, 21px);
    line-height: 1.7;
    color: rgba(0,0,0,0.75);
    margin: 0;
  }

  /* Two-column layout */
  .article-layout {
    display: flex;
    gap: var(--ds-size-10);
  }

  .article-content {
    flex: 1;
    min-width: 0;
    max-width: 720px;
  }

  :global(.article-body) {
    font-size: var(--ds-font-size-4, 18px);
    line-height: 1.7;
    color: rgba(0,0,0,0.75);
  }

  :global(.article-body h2) {
    font-size: var(--ds-font-size-7, 30px);
    font-weight: 500;
    color: #0d131b;
    scroll-margin-top: 100px;
  }

  :global(.article-body h3) {
    scroll-margin-top: 100px;
  }

  /* Sidebar */
  .article-sidebar {
    display: none;
    width: 340px;
    flex-shrink: 0;
  }

  @media (min-width: 1024px) {
    .article-sidebar {
      display: block;
      position: sticky;
      top: 100px;
      align-self: flex-start;
    }
  }

</style>
