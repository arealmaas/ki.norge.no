---
import Layout from '../../components/layout/Layout.astro';
import ContactCard from '../../components/shared/ContactCard.astro';
import { getEksempler, getPlainText, getMediaUrl, type Eksempel } from '../../lib/umbraco';

let cases: Eksempel[] = [];
try {
  const eksemplerRes = await getEksempler();
  cases = eksemplerRes.data;
} catch (e) {
  console.error('Failed to fetch eksempler:', e);
}
---

<Layout title="Gode eksempler" description="Lær av andre offentlige virksomheters erfaringer med kunstig intelligens.">
  <div class="eksempler-page">
    <div class="eksempler-title-bar">
      <h1 class="eksempler-title">Gode eksempler</h1>
      <p class="eksempler-lead">Lær av andre offentlige virksomheters erfaringer med kunstig intelligens. Her deler vi suksesshistorier, lærdommer og beste praksis.</p>
    </div>

    <div class="eksempler-content">
      <div class="cases-grid">
        {cases.map(c => (
          <a href={`/eksempler/${c.slug}`} class="case-card">
            <div class="case-card-image-wrapper">
              {c.bilde ? (
                <img src={getMediaUrl(c.bilde)} alt="" loading="lazy" class="case-card-img" />
              ) : (
                <div class="case-card-placeholder"></div>
              )}
            </div>
            <div class="case-card-divider"></div>
            <div class="case-card-content">
              <span class="case-card-org">{c.organisasjon || 'Offentlig sektor'}</span>
              <h2 class="case-card-title">{c.tittel}</h2>
              {c.beskrivelse && (
                <p class="case-card-description">{getPlainText(c.beskrivelse, 120)}</p>
              )}
            </div>
          </a>
        ))}
      </div>

      {cases.length === 0 && (
        <p class="empty-state">Ingen eksempler funnet.</p>
      )}
    </div>

    <ContactCard />
  </div>
</Layout>

<style>
  .eksempler-page {
    padding-top: var(--ds-size-4);
  }

  .eksempler-title-bar {
    max-width: 800px;
    margin: 0 auto;
    padding: 24px var(--ds-size-4) 24px;
    border-bottom: 1px solid #b8bcc1;
  }

  .eksempler-title {
    font-size: 1.625rem;
    font-weight: 500;
    margin: 0 0 8px;
    color: #000;
  }

  .eksempler-lead {
    font-size: 1.125rem;
    line-height: 1.5;
    color: rgba(0, 0, 0, 0.65);
    margin: 0;
  }

  .eksempler-content {
    max-width: 1280px;
    margin: 0 auto;
    padding: var(--ds-size-8) var(--ds-size-4);
  }

  .cases-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--ds-size-6);
  }

  @media (min-width: 640px) {
    .cases-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .cases-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .case-card {
    display: flex;
    flex-direction: column;
    background-color: #E2F0FC;
    border-radius: 8px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.2s ease;
  }

  .case-card:hover {
    box-shadow: var(--ds-shadow-md);
  }

  .case-card-image-wrapper {
    display: flex;
    justify-content: center;
    padding: 24px;
    padding-bottom: 0;
  }

  .case-card-img {
    width: 90%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
    border-radius: 24px;
  }

  .case-card-placeholder {
    width: 90%;
    aspect-ratio: 16 / 9;
    background-color: var(--image-fallback-bg, #D9D9D9);
    border-radius: 24px;
  }

  .case-card-divider {
    width: 90%;
    height: 1px;
    background-color: #D9D9D9;
    margin: 24px auto 0;
    border-radius: 0.5px;
  }

  .case-card-content {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-1);
    padding: var(--ds-size-5);
  }

  .case-card-org {
    color: var(--ds-color-neutral-text-subtle);
    font-size: var(--ds-font-size-0);
    font-weight: var(--ds-font-weight-medium);
  }

  .case-card-title {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
    color: #000;
  }

  .case-card-description {
    color: var(--ds-color-neutral-text-subtle);
    margin: 0;
    line-height: 1.5;
    font-size: 0.8125rem;
  }

  .empty-state {
    text-align: center;
    padding: var(--ds-size-12);
    color: var(--ds-color-neutral-text-subtle);
    font-size: 1rem;
  }
</style>
