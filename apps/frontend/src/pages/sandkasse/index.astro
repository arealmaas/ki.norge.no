---
import Layout from '../../components/layout/Layout.astro';
import { getSandkasse, getMediaUrl, getPlainText } from '../../lib/umbraco';
import { breadcrumbSchema } from '../../lib/seo';

const isPreview = Astro.url.searchParams.has('preview') || !!Astro.cookies.get('preview')?.value;
const sandkasse = await getSandkasse({ preview: isPreview });

if (!sandkasse) {
  return Astro.redirect('/');
}

const seoTitle = sandkasse.seoTittel || sandkasse.tittel;
const seoDesc = sandkasse.seoBeskrivelse || sandkasse.ingress || getPlainText(sandkasse.innhold, 200);
const heroImage = sandkasse.artikkelBilde || sandkasse.seoBilde;
const seoImage = sandkasse.seoBilde?.url || sandkasse.artikkelBilde?.url;

const breadcrumbJsonLd = breadcrumbSchema([
  { name: 'Forside', url: '/' },
  { name: sandkasse.tittel, url: '/sandkasse' },
]);

const bakgrunn = sandkasse.bakgrunn || 'hvit';
const isLightBlueBg = bakgrunn === 'lyseblaa';
---

<Layout title={seoTitle} description={seoDesc} ogImage={seoImage}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} />
  <div class="article-page grid">
    <section class={`article-hero ${isLightBlueBg ? 'col-all article-hero--bg-lyseblaa' : (heroImage ? 'col-center-10' : 'col-center-6')}`}>
      {isLightBlueBg ? (
        <div class={`grid article-hero-bg-grid`}>
          <div class={`article-hero-inner ${heroImage ? 'col-center-10' : 'col-center-6'}`}>
            <div class="article-hero-text">
              <h1 class="article-title">{sandkasse.tittel}</h1>
              {sandkasse.ingress && <p class="article-ingress">{sandkasse.ingress}</p>}
            </div>
            {heroImage?.url && (
              <div class="article-hero-image">
                <img src={getMediaUrl(heroImage)} alt={sandkasse.bildeAlt || ''} class="article-hero-img" loading="eager" decoding="async" />
              </div>
            )}
          </div>
        </div>
      ) : (
        <div class="article-hero-inner">
          <div class="article-hero-text">
            <h1 class="article-title">{sandkasse.tittel}</h1>
            {sandkasse.ingress && <p class="article-ingress">{sandkasse.ingress}</p>}
          </div>
          {heroImage?.url && (
            <div class="article-hero-image">
              <img src={getMediaUrl(heroImage)} alt={sandkasse.bildeAlt || ''} class="article-hero-img" loading="eager" decoding="async" />
            </div>
          )}
        </div>
      )}
    </section>

    {sandkasse.innhold?.map(block => {
        if (block.contentType === 'artikkelByline') {
          const c = block.content;
          const date = c.dato;
          const formatted = date ? new Date(date).toLocaleDateString('nb-NO', { year: 'numeric', month: 'long', day: 'numeric' }) : '';
          const parts = [c.navn, c.stilling, c.virksomhet ? `i ${c.virksomhet}` : ''].filter(Boolean).join(' ');
          if (!parts && !formatted) return null;
          return (
            <div class="article-byline col-center-6">
              {parts && <span class="article-byline-author">{parts}</span>}
              {parts && formatted && <span class="article-byline-sep">·</span>}
              {formatted && <time class="article-byline-date" datetime={date}>{formatted}</time>}
            </div>
          );
        }
        if (block.contentType === 'artikkelInnholdFra') {
          const c = block.content;
          if (!c.virksomhet && !c.dato) return null;
          const date = c.dato;
          const formatted = date ? new Date(date).toLocaleDateString('nb-NO', { year: 'numeric', month: 'long', day: 'numeric' }) : '';
          return (
            <aside class="article-innhold-fra col-center-6">
              {c.virksomhet && (
                <>
                  <span class="article-innhold-fra-label">Innhold fra</span>
                  <strong class="article-innhold-fra-org">{c.virksomhet}</strong>
                </>
              )}
              {formatted && (
                <span class="article-innhold-fra-date">Sist oppdatert {formatted}</span>
              )}
            </aside>
          );
        }
        if (block.contentType === 'artikkelKontaktkort') {
          const c = block.content;
          return (
            <aside class="article-kontaktkort col-center-6">
              {c.tittel && <h3 class="article-kontaktkort-title">{c.tittel}</h3>}
              <p class="article-kontaktkort-name">{c.navn}</p>
              {c.stilling && <p class="article-kontaktkort-row">{c.stilling}</p>}
              {c.virksomhet && <p class="article-kontaktkort-row">{c.virksomhet}</p>}
              {c.epost && <p class="article-kontaktkort-row"><a href={`mailto:${c.epost}`}>{c.epost}</a></p>}
              {c.telefon && <p class="article-kontaktkort-row"><a href={`tel:${c.telefon.replace(/\s/g, '')}`}>{c.telefon}</a></p>}
            </aside>
          );
        }
        if (block.contentType === 'artikkelProsessteg') {
          const c = block.content;
          return (
            <section class="article-prosessteg col-center-6">
              {c.tittel && <h2 class="article-prosessteg-title">{c.tittel}</h2>}
              <ol class="article-prosessteg-list">
                {c.steg.map((s, i) => (
                  <li class="article-prosessteg-item">
                    <div class="article-prosessteg-header">
                      <span class="article-prosessteg-number">{i + 1}</span>
                      {s.tittel && <span class="article-prosessteg-label">{s.tittel}</span>}
                    </div>
                    <div class="article-prosessteg-body" set:html={s.beskrivelse} />
                  </li>
                ))}
              </ol>
            </section>
          );
        }
        if (block.contentType === 'artikkelFremheving') {
          const c = block.content;
          const classes = [
            'article-fremheving',
            'col-center-6',
            c.visBakgrunn ? 'article-fremheving--bg' : '',
            c.visAnforselstegn ? 'article-fremheving--quote' : '',
            c.bilde?.url ? 'article-fremheving--with-image' : '',
          ].filter(Boolean).join(' ');
          return (
            <div class={classes}>
              {c.bilde?.url && (
                <div class="article-fremheving-image">
                  <img src={getMediaUrl(c.bilde)} alt={c.bildeAlt || ''} loading="lazy" decoding="async" />
                </div>
              )}
              <div class="article-fremheving-content">
                {c.tittel && <h3 class="article-fremheving-title">{c.tittel}</h3>}
                {c.visAnforselstegn ? (
                  <blockquote class="article-fremheving-text article-fremheving-text--quote">
                    <span aria-hidden="true" class="article-fremheving-quote-mark article-fremheving-quote-mark--open">«</span>
                    <div set:html={c.tekst} />
                    <span aria-hidden="true" class="article-fremheving-quote-mark article-fremheving-quote-mark--close">»</span>
                  </blockquote>
                ) : (
                  <div class="article-fremheving-text" set:html={c.tekst} />
                )}
                {c.kilde && (
                  <footer class="article-fremheving-source">
                    <cite>{c.kilde}</cite>
                  </footer>
                )}
              </div>
            </div>
          );
        }
        if (block.contentType === 'artikkelInfoBoks') {
          return (
            <div class="article-info-box col-center-6">
              {block.content.tittel && <h3 class="info-box-title">{block.content.tittel}</h3>}
              <div class="info-box-body" set:html={block.content.innhold} />
            </div>
          );
        }
        if (block.contentType === 'artikkelTrekkspill') {
          return (
            <details class="article-accordion col-center-6">
              <summary class="article-accordion-summary">
                {block.content.tittel}
                <svg class="article-accordion-chevron" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m6 9 6 6 6-6"/>
                </svg>
              </summary>
              <div class="article-accordion-body" set:html={block.content.innhold} />
            </details>
          );
        }
        if (block.contentType === 'artikkelSitat') {
          return (
            <blockquote class="article-quote col-center-6">
              <p class="article-quote-text">{block.content.sitat}</p>
              {block.content.kilde && (
                <footer class="article-quote-source">
                  <cite>{block.content.kilde}</cite>
                </footer>
              )}
            </blockquote>
          );
        }
        if (block.contentType === 'artikkelCallout') {
          const variant = block.content.variant || 'info';
          return (
            <div class={`article-callout article-callout--${variant} col-center-6`} role={variant === 'advarsel' ? 'alert' : 'note'}>
              {block.content.tittel && <p class="article-callout-title">{block.content.tittel}</p>}
              <div class="article-callout-body" set:html={block.content.innhold} />
            </div>
          );
        }
        if (block.contentType === 'artikkelBildeSeksjon') {
          return (
            <figure class="article-image-section col-center-6">
              {block.content.bilde?.url ? (
                <img src={getMediaUrl(block.content.bilde)} alt={block.content.bildeAlt || ''} class="stub-img" loading="lazy" decoding="async" />
              ) : (
                <div class="article-image-placeholder"></div>
              )}
              {block.content.bildetekst && <figcaption>{block.content.bildetekst}</figcaption>}
            </figure>
          );
        }
        return (
          <div class="article-text-block col-center-6" set:html={block.content.innhold} />
        );
      })}
  </div>
</Layout>

<style>
  .article-page {
    padding-top: 0;
    row-gap: 48px;
    padding-bottom: 120px;
  }

  .article-hero {
    padding: 100px 0;
  }

  .article-hero--bg-lyseblaa {
    background: #e5f2f7;
    padding: 140px 0 80px;
    margin: 0;
  }

  .article-hero-inner {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  @media (min-width: 1024px) {
    .article-hero-inner {
      flex-direction: row;
      align-items: center;
    }
  }

  .article-hero-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .article-title {
    font-size: 2rem;
    font-weight: 700;
    color: #000;
    margin: 0;
    line-height: 1.3;
    letter-spacing: -0.5px;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  @media (min-width: 768px) { .article-title { font-size: 2.5rem; } }
  @media (min-width: 1024px) { .article-title { font-size: 36px; } }

  .article-ingress {
    font-size: 21px;
    font-weight: 400;
    color: rgba(0, 0, 0, 0.75);
    line-height: 1.7;
    letter-spacing: 0.5px;
    margin: 0;
  }

  @media (min-width: 1024px) { .article-ingress { font-size: 24px; } }

  .article-hero-image {
    flex-shrink: 0;
    width: 100%;
  }

  @media (min-width: 1024px) { .article-hero-image { width: 407px; } }

  .article-hero-img {
    width: 100%;
    height: auto;
    border-radius: 16px;
    display: block;
    object-fit: cover;
  }

  @media (min-width: 1024px) { .article-hero-img { height: 331px; } }

  .article-accordion {
    border: 1px solid #b6d8e4;
    border-radius: 8px;
    overflow: hidden;
    margin: 24px 0;
    transition: border-color 0.15s;
  }
  .article-accordion:hover { border-color: #1a2a6d; }
  .article-accordion[open] { border-color: #1a2a6d; }
  .article-accordion-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    font-size: 1.125rem;
    font-weight: 500;
    color: #1a2a6d;
    cursor: pointer;
    list-style: none;
    background: #e5f2f7;
  }
  .article-accordion-summary::-webkit-details-marker { display: none; }
  .article-accordion-chevron {
    flex-shrink: 0;
    transition: transform 0.2s ease;
    color: #1a2a6d;
  }
  .article-accordion[open] > .article-accordion-summary .article-accordion-chevron {
    transform: rotate(180deg);
  }
  .article-accordion-body {
    padding: 20px 24px;
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(0, 0, 0, 0.75);
    background: white;
  }
  .article-accordion-body :global(p) { margin: 0 0 12px; }
  .article-accordion-body :global(p:last-child) { margin-bottom: 0; }

  .article-quote {
    margin: 32px 0;
    padding: 24px 32px;
    border-left: 4px solid #1a2a6d;
    background: #f8fafc;
    border-radius: 0 8px 8px 0;
  }
  .article-quote-text {
    font-size: 1.25rem;
    font-style: italic;
    line-height: 1.6;
    color: #1e293b;
    margin: 0;
  }
  .article-quote-source {
    margin-top: 12px;
    font-size: 0.9rem;
    color: rgba(0, 0, 0, 0.6);
  }
  .article-quote-source cite { font-style: normal; }

  .article-callout {
    margin: 24px 0;
    padding: 20px 24px;
    border-radius: 8px;
    border-left: 4px solid;
  }
  .article-callout--info { background: #e5f2f7; border-left-color: #0062ba; }
  .article-callout--obs { background: #fef9c3; border-left-color: #ca8a04; }
  .article-callout--advarsel { background: #fef2f2; border-left-color: #dc2626; }
  .article-callout--suksess { background: #f0fdf4; border-left-color: #16a34a; }
  .article-callout-title {
    font-weight: 600;
    font-size: 1rem;
    margin: 0 0 8px;
    color: #1e293b;
  }
  .article-callout-body {
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(0, 0, 0, 0.8);
  }
  .article-callout-body :global(p) { margin: 0 0 8px; }
  .article-callout-body :global(p:last-child) { margin-bottom: 0; }

  .article-byline {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: baseline;
    font-size: 16px;
    color: rgba(0, 0, 0, 0.7);
  }
  .article-byline-author { font-weight: 500; color: #000; }
  .article-byline-sep { color: rgba(0, 0, 0, 0.4); }
  .article-byline-date { color: rgba(0, 0, 0, 0.55); }

  .article-innhold-fra {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px 0;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
  }
  .article-innhold-fra-label { font-size: 14px; color: rgba(0, 0, 0, 0.55); }
  .article-innhold-fra-org { font-size: 18px; font-weight: 600; color: #000; }
  .article-innhold-fra-date { font-size: 14px; color: rgba(0, 0, 0, 0.55); }

  .article-kontaktkort {
    background: #e5f2f7;
    border-radius: 16px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .article-kontaktkort-title { font-size: 21px; font-weight: 500; color: #1a2a6d; margin: 0 0 16px; }
  .article-kontaktkort-name { font-size: 18px; font-weight: 600; color: #000; margin: 0; }
  .article-kontaktkort-row { font-size: 16px; color: rgba(0, 0, 0, 0.75); margin: 0; }
  .article-kontaktkort-row a { color: #1a2a6d; text-decoration: none; }
  .article-kontaktkort-row a:hover { text-decoration: underline; }

  .article-prosessteg {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  .article-prosessteg-title {
    font-size: 24px;
    font-weight: 700;
    color: #000;
    margin: 0;
    line-height: 1.3;
  }
  .article-prosessteg-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  .article-prosessteg-item {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .article-prosessteg-header {
    display: flex;
    align-items: flex-end;
    gap: 16px;
  }
  .article-prosessteg-number {
    font-size: 64px;
    font-weight: 600;
    line-height: 1;
    color: rgba(0, 0, 0, 0.43);
    letter-spacing: 0.024px;
  }
  .article-prosessteg-label {
    font-size: 24px;
    font-weight: 500;
    color: #000;
    letter-spacing: 0.012px;
  }
  .article-prosessteg-body {
    font-size: 18px;
    line-height: 1.45;
    color: rgba(0, 0, 0, 0.7);
  }
  .article-prosessteg-body :global(p) { margin: 0 0 8px; }
  .article-prosessteg-body :global(p:last-child) { margin-bottom: 0; }

  .article-fremheving {
    display: flex;
    flex-direction: column;
    gap: 24px;
    border-radius: 24px;
    padding: 32px;
    margin: 16px 0;
  }
  .article-fremheving--bg { background: #e5f2f7; }
  @media (min-width: 768px) {
    .article-fremheving--with-image {
      flex-direction: row;
      align-items: flex-start;
    }
    .article-fremheving-image { flex-shrink: 0; width: 35%; }
  }
  .article-fremheving-image img { width: 100%; height: auto; display: block; border-radius: 12px; }
  .article-fremheving-content { flex: 1; min-width: 0; }
  .article-fremheving-title {
    font-size: 21px;
    font-weight: 500;
    color: #1a2a6d;
    margin: 0 0 16px;
  }
  .article-fremheving-text {
    font-size: 18px;
    line-height: 1.7;
    color: rgba(0, 0, 0, 0.8);
  }
  .article-fremheving-text :global(p) { margin: 0 0 12px; }
  .article-fremheving-text :global(p:last-child) { margin-bottom: 0; }
  .article-fremheving-text--quote {
    position: relative;
    font-style: italic;
    margin: 0;
  }
  .article-fremheving-quote-mark {
    font-size: 2.5em;
    font-style: normal;
    color: rgba(0, 0, 0, 0.4);
    line-height: 0.5;
    vertical-align: -0.2em;
  }
  .article-fremheving-quote-mark--open { margin-right: 0.1em; }
  .article-fremheving-quote-mark--close { margin-left: 0.1em; }
  .article-fremheving-source {
    margin-top: 12px;
    font-size: 14px;
    color: rgba(0, 0, 0, 0.55);
  }
  .article-fremheving-source cite { font-style: normal; }

  .article-info-box {
    background: #e5f2f7;
    border-radius: 24px;
    padding: 48px;
    margin: 32px 0;
  }
  .info-box-title {
    font-size: 21px;
    font-weight: 500;
    color: #1a2a6d;
    margin: 0 0 16px;
  }
  .info-box-body {
    font-size: 21px;
    line-height: 1.7;
    color: rgba(0,0,0,0.75);
  }

  .article-image-section { margin: 32px 0; }
  .article-image-section img { width: 100%; border-radius: 8px; display: block; }
  .article-image-placeholder {
    width: 100%;
    height: 400px;
    background: var(--image-fallback-bg, #D9D9D9);
    border-radius: 8px;
  }
  .article-image-section figcaption {
    font-size: 14px;
    color: rgba(0,0,0,0.55);
    margin-top: 8px;
    text-align: center;
  }

  .article-text-block {
    font-size: 21px;
    line-height: 1.7;
    color: rgba(0,0,0,0.75);
    letter-spacing: 0.005em;
  }
  .article-text-block :global(h2) {
    font-size: 36px;
    font-weight: 500;
    color: #1a2a6d;
    margin: 48px 0 24px;
  }
  .article-text-block :global(h3) {
    font-size: 24px;
    font-weight: 500;
    color: #1a2a6d;
    margin: 32px 0 16px;
  }
  .article-text-block :global(p) { margin: 0 0 16px; }
  .article-text-block :global(ul), .article-text-block :global(ol) {
    margin: 8px 0 16px;
    padding-left: 24px;
  }
</style>
