---
/**
 * Regulatorisk sandkasse landing page.
 * Based on Figma design 561:1761.
 * TODO: Make CMS-driven later. Currently hardcoded.
 */
import Layout from '../../components/layout/Layout.astro';

const processSteps = [
  { number: '1', title: 'Søknad', desc: 'Potensielle deltagere sender en søknad til sandkassen. De vil få svar på sin søknad, eventuell beskjed om klargjøring/retting av søknaden innen rimelig tid.' },
  { number: '2', title: 'Opptak', desc: 'Skal skissere sandkasseforløpet. Det vil inneholde spesifisering av hvilke spørsmål som skal behandles, hvor lang tid det er tenkt til å ta, mv.' },
  { number: '3', title: 'Planlegging', desc: 'Når sandkasseforløpet er ferdigstilt vil deltageren få et skriftlig bevis og sluttbevis.' },
  { number: '4', title: 'Sluttbevis', desc: 'Når sandkasseforløpet er ferdigstilt vil deltageren få et skriftlig bevis og sluttbevis.' },
];

const faqItems = [
  'Hvem kan søke om deltakelse i sandkassen?',
  'Hvor lang tid tar et sandkasseforløp?',
  'Hva koster det å delta?',
  'Hvilke krav stilles til KI-systemet?',
  'Hva skjer etter sandkasseforløpet?',
];
---

<Layout title="Regulatorisk sandkasse for KI" description="KI-sandkassen skal støtte norske virksomheter i å utvikle og ta i bruk ansvarlige og innovative KI-løsninger." headerTheme="dark">
  <div class="sandkasse-page">
    <!-- Hero -->
    <section class="sandkasse-hero">
      <div class="sandkasse-hero-inner">
        <h1 class="sandkasse-hero-title">KI-sandkassen</h1>
        <p class="sandkasse-hero-body">
          KI-sandkassen skal støtte norske virksomheter i å utvikle og ta i bruk ansvarlige og innovative KI-løsninger. Gjennom tett oppfølging og veiledning fra myndighetene får virksomhetene hjelp til å vurdere risiko og forstå relevant regelverk. Målet er at flere norske virksomheter skal lykkes med kunstig intelligens, og at KI-systemene følger lovverket.
        </p>
        <p class="sandkasse-hero-countdown">120 dager til du kan søke!</p>
        <div class="sandkasse-hero-illustrations">
          <img src="/sandkasse/sandkasse%20bucket.png" alt="" class="sandkasse-hero-img sandkasse-hero-img--bucket" aria-hidden="true" />
          <div class="sandkasse-hero-img-group">
            <img src="/sandkasse/sandkasse%20sandcastle.png" alt="" class="sandkasse-hero-img sandkasse-hero-img--sandcastle" aria-hidden="true" />
            <img src="/sandkasse/sandkasse%20shovel.png" alt="" class="sandkasse-hero-img sandkasse-hero-img--shovel" aria-hidden="true" />
          </div>
        </div>
      </div>
    </section>

    <!-- Hvem er det til for? -->
    <section class="sandkasse-section sandkasse-section--white">
      <div class="sandkasse-section-inner sandkasse-row">
        <div class="sandkasse-image-col">
          <img src="/sandkasse/sandkasse%20sandkasse.png" alt="" class="sandkasse-illustration" aria-hidden="true" />
        </div>
        <div class="sandkasse-text-col">
          <h2 class="sandkasse-section-title">Hvem er det til for?</h2>
          <div class="sandkasse-section-body">
            <p>Sandkassen er åpen for alle leverandører og fremtidige leverandører av KI-systemer. Den skal fortrinnsvis støtte små og mellomstore bedrifter og oppstartsbedrifter, men større aktører kan også søke.</p>
            <p>Vi velger sandkasseprosjekter basert på om KI-systemet</p>
            <ul>
              <li>er innovativt</li>
              <li>kan bidra til å understøtte offentlige hensyn og interesser</li>
              <li>har rettslige utfordringer som gjelder for resten av sektoren.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Slik foregår prosessen -->
    <section class="sandkasse-process">
      <div class="sandkasse-process-inner">
        <h2 class="sandkasse-process-title">Slik foregår prosessen</h2>
        <div class="sandkasse-process-grid">
          {processSteps.map(step => (
            <div class="process-step">
              <span class="process-step-number">{step.number}</span>
              <h3 class="process-step-title">{step.title}</h3>
              <p class="process-step-desc">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Hva får du ut av det? -->
    <section class="sandkasse-section sandkasse-section--white">
      <div class="sandkasse-section-inner sandkasse-row sandkasse-row--reverse">
        <div class="sandkasse-text-col">
          <h2 class="sandkasse-section-title">Hva får du ut av det?</h2>
          <div class="sandkasse-section-body">
            <p>Deltagere i sandkassen får tett oppfølging og veiledning i å vurdere risiko og forstå relevant regelverk.</p>
            <p>Når sandkasseforløpet er fullført, får deltakerne et skriftlig bevis og en sluttrapport. Sandkassedeltakeren kan bruke dokumentasjonen til å vise at de følger KI-loven.</p>
            <p>Det vil gjøre det lettere og raskere å få KI-systemet godkjent eller kontrollert.</p>
          </div>
        </div>
        <div class="sandkasse-image-col">
          <img src="/sandkasse/sandkasse%20sandkasse%202.png" alt="" class="sandkasse-illustration" aria-hidden="true" />
        </div>
      </div>
    </section>

    <!-- Ofte stilte spørsmål -->
    <section class="sandkasse-faq">
      <div class="sandkasse-faq-inner">
        <h2 class="sandkasse-faq-title">Ofte stilte spørsmål</h2>
        <div class="sandkasse-faq-list">
          {faqItems.map(q => (
            <details class="sandkasse-faq-item">
              <summary class="sandkasse-faq-question">
                <span>{q}</span>
                <span class="sandkasse-faq-icon">+</span>
              </summary>
              <div class="sandkasse-faq-answer">
                <p>Innhold kommer snart.</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .sandkasse-page {
    margin-top: -72px;
  }

  .sandkasse-page :global(.logo-link),
  .sandkasse-page :global(.nav-link),
  .sandkasse-page :global(.mobile-menu-toggle),
  .sandkasse-page :global(.menu-label) {
    color: white;
  }

  /* Hero */
  .sandkasse-hero {
    background: linear-gradient(180deg, #281ea8 0%, #20199a 40%, #1a1490 100%);
    padding: 140px 24px 80px;
    text-align: center;
    overflow: hidden;
  }

  .sandkasse-hero-inner {
    max-width: 860px;
    margin: 0 auto;
  }

  .sandkasse-hero-title {
    font-size: 64px;
    font-weight: 700;
    color: white;
    margin: 0 0 48px;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .sandkasse-hero-body {
    font-size: 20px;
    font-weight: 500;
    color: white;
    margin: 0 0 32px;
    line-height: 1.3;
    letter-spacing: -0.0025em;
  }

  .sandkasse-hero-countdown {
    font-size: 20px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.7);
    margin: 0 0 48px;
    line-height: 1.3;
  }

  .sandkasse-hero-illustrations {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    gap: 148px;
    max-width: 700px;
    margin: 0 auto;
  }

  .sandkasse-hero-img {
    object-fit: contain;
  }

  .sandkasse-hero-img-group {
    position: relative;
    width: 136.4px;
    height: 100px;
  }

  .sandkasse-hero-img--sandcastle {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 130px;
    width: 190px;
  }

  .sandkasse-hero-img--shovel {
    position: absolute;
    bottom: 62%;
    left: 39%;
    z-index: 1;
    height: 120px;
    width: 190px;
  }

  .sandkasse-hero-img--bucket {
    height: 150px;
  }

  @media (max-width: 768px) {
    .sandkasse-hero-title {
      font-size: 40px;
    }
    .sandkasse-hero-body {
      font-size: 16px;
    }

  }

  @media (max-width: 480px) {
    .sandkasse-hero-title {
      font-size: 32px;
    }
    .sandkasse-hero-illustrations {
      gap: 12px;
      margin-left: -80px;
    }

  }

  /* White content sections */
  .sandkasse-section--white {
    padding: 80px 24px;
  }

  .sandkasse-section-inner {
    max-width: 930px;
    margin: 0 auto;
  }

  .sandkasse-row {
    display: flex;
    flex-direction: column;
    gap: 32px;
    align-items: center;
  }

  @media (min-width: 768px) {
    .sandkasse-row {
      flex-direction: row;
      gap: 48px;
    }
    .sandkasse-row--reverse {
      flex-direction: row-reverse;
    }
  }

  .sandkasse-image-col {
    flex-shrink: 0;
    width: 280px;
  }

  .sandkasse-illustration {
    width: 100%;
    height: auto;
    border-radius: 4px;
    mix-blend-mode: darken;
  }

  .sandkasse-text-col {
    flex: 1;
    min-width: 0;
  }

  .sandkasse-section-title {
    font-size: 36px;
    font-weight: 400;
    color: #000;
    margin: 0 0 32px;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .sandkasse-section-body {
    font-size: 20px;
    font-weight: 500;
    color: rgba(0, 0, 0, 0.75);
    line-height: 1.3;
    letter-spacing: -0.0025em;
  }

  .sandkasse-section-body p {
    margin: 0 0 16px;
  }

  .sandkasse-section-body p:last-child {
    margin-bottom: 0;
  }

  .sandkasse-section-body ul {
    margin: 8px 0 0;
    padding-left: 24px;
  }

  .sandkasse-section-body li {
    margin-bottom: 4px;
  }

  /* Process section */
  .sandkasse-process {
    background: #20199a;
    padding: 80px 24px;
  }

  .sandkasse-process-inner {
    max-width: 1120px;
    margin: 0 auto;
  }

  .sandkasse-process-title {
    font-size: 36px;
    font-weight: 400;
    color: white;
    margin: 0 0 48px;
    line-height: 1.3;
  }

  .sandkasse-process-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
  }

  @media (min-width: 640px) {
    .sandkasse-process-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .sandkasse-process-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .process-step {
    display: flex;
    flex-direction: column;
  }

  .process-step-number {
    font-size: 128px;
    font-weight: 600;
    color: white;
    line-height: 1;
    margin-bottom: 8px;
  }

  .process-step-title {
    font-size: 24px;
    font-weight: 500;
    color: white;
    margin: 0 0 16px;
    line-height: 1.3;
  }

  .process-step-desc {
    font-size: 18px;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
    line-height: 1.3;
  }

  @media (max-width: 640px) {
    .process-step-number {
      font-size: 80px;
    }
  }

  /* FAQ section */
  .sandkasse-faq {
    background: #20199a;
    padding: 80px 24px;
  }

  .sandkasse-faq-inner {
    max-width: 1120px;
    margin: 0 auto;
  }

  .sandkasse-faq-title {
    font-size: 32px;
    font-weight: 400;
    color: white;
    margin: 0 0 32px;
    line-height: 1.3;
  }

  .sandkasse-faq-list {
    display: flex;
    flex-direction: column;
  }

  .sandkasse-faq-item {
    border-top: 1px solid #ccc;
    border-bottom: 1px solid #ccc;
    margin-bottom: -1px;
  }

  .sandkasse-faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 28px 16px;
    cursor: pointer;
    list-style: none;
    font-size: 21px;
    font-weight: 700;
    color: white;
  }

  .sandkasse-faq-question::-webkit-details-marker {
    display: none;
  }

  .sandkasse-faq-icon {
    font-size: 24px;
    color: rgba(255, 255, 255, 0.7);
    flex-shrink: 0;
    transition: transform 0.2s;
  }

  .sandkasse-faq-item[open] .sandkasse-faq-icon {
    transform: rotate(45deg);
  }

  .sandkasse-faq-answer {
    padding: 0 16px 28px 16px;
    font-size: 18px;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.5;
  }

  .sandkasse-faq-answer p {
    margin: 0;
  }
</style>
