---
import { Link } from '@digdir/designsystemet-react';
import Logo from '../shared/Logo.astro';


const navItems = [
  { href: '/veiledning', label: 'Veiledning' },
  { href: '/eksempler', label: 'Eksempler' },
];

const currentPath = Astro.url.pathname;
---

<header class="header">
  <a href="#main-content" class="skip-link">
    Hopp til hovedinnhold
  </a>
  <div class="header-container">
    <Link href="/" className="logo-link" aria-label="KI Norge - Hjem">
      <Logo />
    </Link>

    <nav class="nav-desktop" aria-label="Hovednavigasjon">
      <ul class="nav-list">
        {navItems.map((item) => (
          <li>
            <Link
              href={item.href}
              className={`nav-link ${currentPath.startsWith(item.href) ? 'active' : ''}`}
              aria-current={currentPath.startsWith(item.href) ? 'page' : undefined}
            >
              {item.label}
            </Link>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <button
        type="button"
        class="mobile-menu-toggle"
        aria-label="Åpne meny"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-mobile-menu-toggle
      >
        <span class="menu-label">Meny</span>
        <svg class="menu-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
        <svg class="close-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Menu backdrop -->
  <div id="menu-backdrop" class="menu-backdrop" hidden></div>

  <!-- Navigation Menu -->
  <nav id="mobile-nav" class="nav-mobile" aria-label="Meny" hidden>
    <ul class="mobile-nav-list">
      {navItems.map((item) => (
        <li>
          <Link
            href={item.href}
            className={`mobile-nav-link ${currentPath.startsWith(item.href) ? 'active' : ''}`}
            aria-current={currentPath.startsWith(item.href) ? 'page' : undefined}
          >
            {item.label}
          </Link>
        </li>
      ))}
      <li>
        <Link href="/artikler" className="mobile-nav-link">
          Artikler
        </Link>
      </li>
      <li>
        <Link href="/sandkasse" className="mobile-nav-link">
          Sandkasse
        </Link>
      </li>
      <li>
        <Link href="/kontakt" className="mobile-nav-link">
          Kontakt oss
        </Link>
      </li>
    </ul>
  </nav>
</header>

<script>
  function initMobileMenu() {
    const toggle = document.querySelector('[data-mobile-menu-toggle]');
    const nav = document.getElementById('mobile-nav');
    const backdrop = document.getElementById('menu-backdrop');

    if (!toggle || !nav || !backdrop) return;

    function openMenu() {
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Lukk meny');
      nav.hidden = false;
      backdrop.hidden = false;
      // Trigger reflow before adding class so transition runs
      void nav.offsetHeight;
      nav.classList.add('active');
      backdrop.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Åpne meny');
      nav.classList.remove('active');
      backdrop.classList.remove('active');
      document.body.style.overflow = '';
      // Wait for transition to finish before hiding
      setTimeout(() => {
        nav.hidden = true;
        backdrop.hidden = true;
      }, 300);
    }

    toggle.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      if (isExpanded) closeMenu();
      else openMenu();
    });

    backdrop.addEventListener('click', closeMenu);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !nav.hidden) closeMenu();
    });
  }

  // Initialize on page load
  initMobileMenu();

  // Re-initialize after Astro page transitions
  document.addEventListener('astro:after-swap', initMobileMenu);
</script>

<style>
  .header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: transparent;
  }

  .skip-link {
    position: absolute;
    left: -9999px;
    z-index: 999;
    padding: var(--ds-size-2) var(--ds-size-4);
    background-color: var(--ds-color-accent-base-default);
    color: white;
    text-decoration: none;
    border-radius: var(--ds-border-radius-md);
  }

  .skip-link:focus {
    left: var(--ds-size-4);
    top: var(--ds-size-4);
  }

  .header-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: var(--ds-size-4) var(--ds-size-4);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ds-size-6);
  }

  :global(.logo-link) {
    text-decoration: none;
    color: var(--ds-color-neutral-text-default);
    display: flex;
    align-items: center;
  }

  .nav-desktop {
    display: none;
  }

  @media (min-width: 1024px) {
    .nav-desktop {
      display: block;
      flex: 1;
    }
  }

  .nav-list {
    display: flex;
    gap: var(--ds-size-1);
    list-style: none;
    margin: 0;
    padding: 0;
    justify-content: flex-end;
  }

  :global(.nav-link) {
    text-decoration: none;
    color: var(--ds-color-neutral-text-default);
    font-size: var(--ds-font-size-1);
    font-weight: var(--ds-font-weight-medium);
    padding: var(--ds-size-2) var(--ds-size-3);
    border-radius: var(--ds-border-radius-md);
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  :global(.nav-link:hover) {
    background-color: rgba(255, 255, 255, 0.2);
  }

  :global(.nav-link.active) {
    background-color: rgba(255, 255, 255, 0.2);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--ds-size-3);
  }

  .mobile-menu-toggle {
    display: flex;
    align-items: center;
    gap: var(--ds-size-2);
    padding: var(--ds-size-2) var(--ds-size-4);
    background: rgba(255, 255, 255, 0.4);
    border: none;
    border-radius: 9999px;
    cursor: pointer;
    color: var(--ds-color-neutral-text-default);
    font-family: inherit;
    font-size: var(--ds-font-size-1);
    font-weight: var(--ds-font-weight-medium);
    transition: all 0.2s ease;
  }

  .mobile-menu-toggle:hover {
    background: rgba(255, 255, 255, 0.6);
  }

  .mobile-menu-toggle:focus-visible {
    outline: 2px solid var(--ds-color-accent-border-default);
    outline-offset: 2px;
  }

  .menu-label {
    display: inline;
  }

  .close-icon {
    display: none;
  }

  .mobile-menu-toggle[aria-expanded="true"] .menu-icon {
    display: none;
  }

  .mobile-menu-toggle[aria-expanded="true"] .close-icon {
    display: block;
  }

  /* Menu backdrop */
  .menu-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0);
    backdrop-filter: blur(0px);
    -webkit-backdrop-filter: blur(0px);
    z-index: 98;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease, background 0.3s ease, backdrop-filter 0.3s ease, -webkit-backdrop-filter 0.3s ease;
  }

  .menu-backdrop.active {
    background: rgba(0, 0, 0, 0.15);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    pointer-events: auto;
    opacity: 1;
  }

  /* Navigation menu */
  .nav-mobile {
    position: fixed;
    top: 64px;
    right: 16px;
    width: calc(100% - 32px);
    max-width: 280px;
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 16px;
    padding: var(--ds-size-3);
    overflow-y: auto;
    z-index: 99;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.5);
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .nav-mobile.active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .nav-mobile[hidden] {
    display: none;
  }

  .mobile-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-1);
  }

  :global(.mobile-nav-link) {
    display: block;
    text-decoration: none;
    color: #000;
    font-size: 1rem;
    font-weight: 500;
    padding: 10px 14px;
    border-radius: 10px;
    transition: background-color 0.15s ease;
  }

  :global(.mobile-nav-link:hover) {
    background-color: rgba(0, 0, 0, 0.06);
  }

  :global(.mobile-nav-link.active) {
    background-color: rgba(0, 0, 0, 0.08);
  }

  /* Dark header theme — for pages with dark hero backgrounds */
  :global([data-header-theme="dark"]) :global(.logo-link) {
    color: white;
  }

  :global([data-header-theme="dark"]) :global(.nav-link) {
    color: white;
  }

  :global([data-header-theme="dark"]) .mobile-menu-toggle {
    color: white;
  }

  :global([data-header-theme="dark"]) .menu-label {
    color: white;
  }
</style>
