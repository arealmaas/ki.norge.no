---
import Header from './Header.astro';
import Footer from './Footer.astro';
import PreviewBanner from '../shared/PreviewBanner.astro';
import SearchDialog from '../shared/SearchDialog.tsx';
import BackToTop from '../shared/BackToTop.astro';
import '../../styles/global.css';
import '../../styles/grid.css';
import '../../styles/search-dialog.css';

interface Props {
  title: string;
  description?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  publishedAt?: string;
  headerTheme?: 'light' | 'dark';
}

const {
  title,
  description = 'Norges nasjonale strategi for kunstig intelligens',
  ogType = 'website',
  ogImage,
  publishedAt,
  headerTheme = 'light',
} = Astro.props;

const isPreview = Astro.url.searchParams.has('preview') || Astro.cookies.has('preview');
const currentPath = Astro.url.pathname;
// Use Astro.site (configured in astro.config.mjs) — never trust Astro.url
// origin since it returns localhost when behind Azure's reverse proxy.
const siteUrl = Astro.site?.href.replace(/\/$/, '') || 'https://ki.norge.no';
const canonicalUrl = `${siteUrl}${currentPath}`;
const fullTitle = `${title} | KI Norge`;
// Default OG image used on every page unless overridden.
// Note: SVG works on most platforms (Slack, Teams, LinkedIn) but Twitter/X
// prefers PNG/JPG — replace with a 1200x630 PNG when designer makes one.
const DEFAULT_OG_IMAGE = '/og-image.svg';
const ogImageUrl = `${siteUrl}${ogImage || DEFAULT_OG_IMAGE}`;
---

<!doctype html>
<html lang="nb" data-ds-color-mode="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#1a2a6d" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{fullTitle}</title>
    {isPreview && <meta name="robots" content="noindex" />}
    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="KI Norge" />
    <meta property="og:locale" content="nb_NO" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Light mode only (dark mode not supported) -->
    <meta name="color-scheme" content="light" />
  </head>
  <body data-header-theme={headerTheme}>
    <a href="#main-content" class="skip-to-main">Hopp til hovedinnhold</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <BackToTop />
    <SearchDialog client:load />
    {isPreview && <PreviewBanner currentPath={currentPath} />}
    <script is:inline>
      document.querySelectorAll('a[href]').forEach(function(a) {
        if (!a.rel || !a.rel.includes('noopener')) {
          a.rel = a.rel ? a.rel + ' noopener' : 'noopener';
        }
      });
    </script>
  </body>
</html>

<style>
  main {
    flex: 1;
    padding-top: 72px;
  }

  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .skip-to-main {
    position: absolute;
    top: 0;
    left: 0;
    padding: var(--ds-size-3, 12px) var(--ds-size-4, 16px);
    background: var(--ds-color-accent-base-default, #1a2a6d);
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    z-index: 1000;
    transform: translateY(-100%);
    transition: transform 0.15s ease;
  }

  .skip-to-main:focus {
    transform: translateY(0);
    outline: 2px solid #fff;
    outline-offset: -4px;
  }

</style>
