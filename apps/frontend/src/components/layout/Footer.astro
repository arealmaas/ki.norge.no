---
import { Link } from '@digdir/designsystemet-react';
import Logo from '../shared/Logo.astro';

const resourceLinks = [
  { href: '/veiledning', label: 'Veiledning' },
  { href: '/sandkasse', label: 'Regulatorisk sandkasse' },
  { href: '/eksempler', label: 'Eksempler' },
  { href: '/artikler', label: 'Artikler' },
  { href: '/faq', label: 'Ofte stilte spørsmål' },
  { href: '/sok', label: 'Søk' },
];

const aboutLinks = [
  { href: '/om-oss', label: 'Om oss' },
  { href: '/kontakt', label: 'Kontakt oss' },
  { href: '/personvern', label: 'Personvern' },
  { href: '/tilgjengelighet', label: 'Tilgjengelighet' },
];
---

<footer class="footer">
  <div class="footer-main">
    <div class="footer-container">
      <!-- Brand Column -->
      <div class="footer-brand">
        <div class="footer-logo">
          <Logo />
        </div>
        <p class="footer-description">
          Et tverrsektorielt samarbeid for å fremme ansvarlig og sikker bruk av kunstig intelligens i den norske forvaltningen.
        </p>
      </div>

      <!-- Resources Column -->
      <div class="footer-section">
        <h4 class="footer-heading">Innhold</h4>
        <ul class="footer-list">
          {resourceLinks.map((link) => (
            <li>
              <Link href={link.href} className="footer-link">
                {link.label}
              </Link>
            </li>
          ))}
        </ul>
      </div>

      <!-- About Column -->
      <div class="footer-section">
        <h4 class="footer-heading">Om portalen</h4>
        <ul class="footer-list">
          {aboutLinks.map((link) => (
            <li>
              <Link href={link.href} className="footer-link">
                {link.label}
              </Link>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <!-- Copyright -->
  <div class="footer-bottom">
    <div class="footer-container">
      <p class="copyright">
        {new Date().getFullYear()} Digitaliseringsdirektoratet
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--ds-color-neutral-surface-default);
    border-top: 1px solid var(--ds-color-neutral-border-subtle);
    margin-top: auto;
  }

  .footer-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 var(--ds-size-4);
  }

  @media (min-width: 1024px) {
    .footer-container {
      padding: 0 var(--ds-size-10);
    }
  }

  .footer-main {
    padding: var(--ds-size-12) 0;
  }

  .footer-main .footer-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--ds-size-10);
  }

  @media (min-width: 768px) {
    .footer-main .footer-container {
      grid-template-columns: 2fr 1fr 1fr;
      gap: var(--ds-size-12);
    }
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-6);
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: var(--ds-size-3);
    color: var(--ds-color-accent-base-default);
  }

  .footer-description {
    margin: 0;
    color: var(--ds-color-neutral-text-subtle);
    font-size: 0.875rem;
    line-height: 1.6;
    max-width: 320px;
  }

  .footer-section {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-4);
  }

  .footer-heading {
    margin: 0;
    color: var(--ds-color-neutral-text-default);
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .footer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-2);
  }

  :global(.footer-link) {
    color: var(--ds-color-neutral-text-subtle);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.2s ease;
  }

  :global(.footer-link:hover) {
    color: var(--ds-color-accent-text-default);
  }

  /* Copyright */
  .footer-bottom {
    padding: var(--ds-size-6) 0;
  }

  .copyright {
    margin: 0;
    text-align: center;
    color: var(--ds-color-neutral-text-subtle);
    font-size: 0.75rem;
  }
</style>
