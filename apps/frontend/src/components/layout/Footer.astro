---
import { Link } from '@digdir/designsystemet-react';
import Logo from '../shared/Logo.astro';

const partners = [
  { name: 'Nkom', subtitle: 'Nasjonal kommunikasjonsmyndighet', url: 'https://www.nkom.no' },
  { name: 'Datatilsynet', subtitle: 'Personvernmyndigheten', url: 'https://www.datatilsynet.no' },
  { name: 'Digdir', subtitle: 'Digitaliseringsdirektoratet', url: 'https://www.digdir.no' },
];

const resourceLinks = [
  { href: '/veiledning', label: 'Veiledningsmateriell' },
  { href: '/sandkasse', label: 'Regulatorisk sandkasse' },
  { href: '/eksempler', label: 'Case-bibliotek' },
  { href: '/ressurser', label: 'Verktøykasse' },
];

const aboutLinks = [
  { href: '/om-oss', label: 'Om oss' },
  { href: '/kontakt', label: 'Kontakt oss' },
  { href: '/personvern', label: 'Personvern' },
];
---

<footer class="footer">
  <div class="footer-main">
    <div class="footer-container">
      <!-- Brand Column -->
      <div class="footer-brand">
        <div class="footer-logo">
          <Logo />
        </div>
        <p class="footer-description">
          Et tverrsektorielt samarbeid for a fremme ansvarlig og sikker bruk av kunstig intelligens i den norske forvaltningen.
        </p>
      </div>

      <!-- Resources Column -->
      <div class="footer-section">
        <h4 class="footer-heading">Ressurser</h4>
        <ul class="footer-list">
          {resourceLinks.map((link) => (
            <li>
              <Link href={link.href} className="footer-link">
                {link.label}
              </Link>
            </li>
          ))}
        </ul>
      </div>

      <!-- About Column -->
      <div class="footer-section">
        <h4 class="footer-heading">Om portalen</h4>
        <ul class="footer-list">
          {aboutLinks.map((link) => (
            <li>
              <Link href={link.href} className="footer-link">
                {link.label}
              </Link>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <!-- Partners Section -->
  <div class="footer-partners">
    <div class="footer-container">
      <p class="partners-label">Partnere i KI Norge</p>
      <div class="partners-logos">
        {partners.map((partner) => (
          <a
            href={partner.url}
            class="partner-item"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="partner-name">{partner.name}</span>
            <span class="partner-subtitle">{partner.subtitle}</span>
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- Copyright -->
  <div class="footer-bottom">
    <div class="footer-container">
      <p class="copyright">
        &copy; {new Date().getFullYear()} Digitaliseringsdirektoratet (Digdir) for KI Norge. Alle rettigheter reservert.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: #ffffff;
    border-top: 1px solid #e2e8f0;
    margin-top: auto;
  }

  :global(html.dark) .footer {
    background-color: #0f172a;
    border-top-color: #1e293b;
  }

  .footer-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 var(--ds-size-4);
  }

  @media (min-width: 1024px) {
    .footer-container {
      padding: 0 var(--ds-size-10);
    }
  }

  .footer-main {
    padding: var(--ds-size-12) 0;
  }

  .footer-main .footer-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--ds-size-10);
  }

  @media (min-width: 768px) {
    .footer-main .footer-container {
      grid-template-columns: 2fr 1fr 1fr;
      gap: var(--ds-size-12);
    }
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-6);
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: var(--ds-size-3);
    color: #136dec;
  }

  .footer-description {
    margin: 0;
    color: #64748b;
    font-size: 0.875rem;
    line-height: 1.6;
    max-width: 320px;
  }

  .footer-section {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-4);
  }

  .footer-heading {
    margin: 0;
    color: #0f172a;
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  :global(html.dark) .footer-heading {
    color: #ffffff;
  }

  .footer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-2);
  }

  :global(.footer-link) {
    color: #64748b;
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.2s ease;
  }

  :global(.footer-link:hover) {
    color: #136dec;
  }

  /* Partners Section */
  .footer-partners {
    border-top: 1px solid #f1f5f9;
    padding: var(--ds-size-10) 0;
  }

  :global(html.dark) .footer-partners {
    border-top-color: #1e293b;
  }

  .partners-label {
    margin: 0 0 var(--ds-size-8) 0;
    text-align: center;
    color: #94a3b8;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
  }

  .partners-logos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--ds-size-10);
    filter: grayscale(1);
    opacity: 0.6;
    transition: opacity 0.3s ease;
  }

  .partners-logos:hover {
    opacity: 1;
  }

  .partner-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--ds-size-2);
    text-decoration: none;
  }

  .partner-name {
    color: #475569;
    font-size: 1.5rem;
    font-weight: 900;
    letter-spacing: -0.025em;
  }

  :global(html.dark) .partner-name {
    color: #cbd5e1;
  }

  .partner-subtitle {
    color: #64748b;
    font-size: 0.625rem;
    font-weight: 500;
  }

  /* Copyright */
  .footer-bottom {
    padding: var(--ds-size-6) 0;
  }

  .copyright {
    margin: 0;
    text-align: center;
    color: #94a3b8;
    font-size: 0.75rem;
  }
</style>
