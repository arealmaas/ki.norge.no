---
import { Heading, Paragraph, Link } from '@digdir/designsystemet-react';

const pillars = [
  {
    title: 'Veiledning',
    description: 'Omfattende ressurser og retningslinjer for ansvarlig bruk av KI i offentlig sektor.',
    href: '/veiledning',
    icon: 'menu_book',
    color: '#136dec',
  },
  {
    title: 'Regulatorisk sandkasse',
    description: 'Test og utvikle KI-løsninger i et trygt miljø med veiledning fra eksperter.',
    href: '/sandkasse',
    icon: 'science',
    color: '#8b5cf6',
  },
  {
    title: 'Gode eksempler',
    description: 'Lær av andres suksesshistorier og beste praksis for KI-implementering.',
    href: '/eksempler',
    icon: 'lightbulb',
    color: '#10b981',
  },
];
---

<section class="pillars">
  <div class="pillars-container">
    <div class="pillars-header">
      <Heading level={2} size="large" className="pillars-heading">Våre hovedområder</Heading>
      <Paragraph size="medium" className="pillars-intro">
        KI Norge tilbyr tre hovedtjenester for å støtte offentlig sektors arbeid med kunstig intelligens
      </Paragraph>
    </div>
    <div class="pillars-grid">
      {pillars.map((pillar) => (
        <Link href={pillar.href} className="pillar-card">
          <div class="pillar-icon-wrapper" style={`--icon-color: ${pillar.color};`}>
            <span class="material-symbols-outlined pillar-icon">{pillar.icon}</span>
          </div>
          <Heading level={3} size="medium" className="pillar-title">{pillar.title}</Heading>
          <Paragraph size="small" className="pillar-description">{pillar.description}</Paragraph>
          <span class="pillar-link">
            Les mer
            <svg class="arrow-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </span>
        </Link>
      ))}
    </div>
  </div>
</section>

<style>
  .pillars {
    padding: var(--ds-size-12) var(--ds-size-4);
    background-color: var(--ds-color-neutral-surface-default);
  }

  .pillars-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .pillars-header {
    text-align: center;
    margin-bottom: var(--ds-size-10);
  }

  :global(.pillars-heading) {
    margin: 0 0 var(--ds-size-3);
  }

  :global(.pillars-intro) {
    color: var(--ds-color-neutral-text-subtle);
    margin: 0 auto;
    max-width: 600px;
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--ds-size-6);
  }

  @media (min-width: 768px) {
    .pillars-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  :global(.pillar-card) {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--ds-size-8) var(--ds-size-6);
    background-color: var(--ds-color-neutral-background-default);
    border: 1px solid var(--ds-color-neutral-border-subtle);
    border-radius: var(--ds-border-radius-lg);
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }

  :global(.pillar-card:hover) {
    border-color: var(--ds-color-accent-border-default);
    box-shadow: var(--ds-shadow-lg);
    transform: translateY(-4px);
  }

  .pillar-icon-wrapper {
    width: 72px;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: color-mix(in srgb, var(--icon-color) 15%, transparent);
    border-radius: var(--ds-border-radius-full);
    margin-bottom: var(--ds-size-5);
    transition: transform 0.3s ease;
  }

  :global(.pillar-card:hover) .pillar-icon-wrapper {
    transform: scale(1.05);
  }

  .pillar-icon {
    font-size: 32px;
    color: var(--icon-color);
  }

  :global(.pillar-title) {
    margin: 0 0 var(--ds-size-2);
  }

  :global(.pillar-description) {
    color: var(--ds-color-neutral-text-subtle);
    margin: 0 0 var(--ds-size-4);
    line-height: 1.6;
    flex: 1;
  }

  .pillar-link {
    display: inline-flex;
    align-items: center;
    gap: var(--ds-size-1);
    font-size: var(--ds-font-size-1);
    font-weight: var(--ds-font-weight-medium);
    color: var(--ds-color-accent-text-default);
    transition: gap 0.2s ease;
  }

  :global(.pillar-card:hover) .pillar-link {
    gap: var(--ds-size-2);
  }

  .arrow-icon {
    transition: transform 0.2s ease;
  }

  :global(.pillar-card:hover) .arrow-icon {
    transform: translateX(4px);
  }
</style>
