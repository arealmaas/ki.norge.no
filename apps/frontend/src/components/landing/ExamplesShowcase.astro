---
import { Heading, Paragraph } from '@digdir/designsystemet-react';

interface Example {
  title: string;
  organization: string;
  slug: string;
  image?: string;
  description?: string;
}

interface Props {
  examples?: Example[];
}

const { examples = [] } = Astro.props;

const displayExamples: Example[] = examples.length > 0 ? examples : [
  { title: 'KI hos Oslo universitetssykehus', organization: 'Ullensag', slug: 'oslo-saksbehandling', description: 'Vi bruker maskinlæring og bildegjenkjenning for raskere og bedre diagnostisering.' },
  { title: 'Kunnskapsassistenten', organization: 'Virksomhet', slug: 'nav-prediktiv', description: 'Vi har bygget en chatbot som hjelper med å finne informasjon om digitaliseringsforskundet.' },
  { title: 'Spacemaker', organization: 'Virksomhet', slug: 'sykehus-radiologi', description: '' },
];

const tabs = [
  { label: 'Se alle eksempler', active: true },
  { label: 'Offentlige virksomheter', active: false },
  { label: 'Private virksomheter', active: false },
];
---

<section class="examples-showcase">
  <div class="examples-showcase-container">
    <div class="examples-showcase-header">
      <Heading level={2} size="xlarge" className="examples-showcase-heading">
        Se hvordan andre har brukt KI
      </Heading>
      <Paragraph size="medium" className="examples-showcase-subtext">
        Finn inspirasjon og lær av andre.
      </Paragraph>
    </div>

    <div class="examples-showcase-tabs">
      {tabs.map((tab) => (
        <button
          class:list={['examples-tab', { 'examples-tab--active': tab.active }]}
          type="button"
        >
          {tab.label}
        </button>
      ))}
    </div>

    <div class="examples-showcase-grid">
      {displayExamples.slice(0, 3).map((example) => (
        <a href={`/eksempler/${example.slug}`} class="showcase-card">
          <div class="showcase-card-image">
            {example.image ? (
              <img src={example.image} alt="" loading="lazy" />
            ) : (
              <div class="showcase-card-placeholder"></div>
            )}
          </div>
          <div class="showcase-card-content">
            <span class="showcase-card-org">{example.organization}</span>
            <Heading level={3} size="xsmall" className="showcase-card-title">
              {example.title}
            </Heading>
            {example.description && (
              <Paragraph size="small" className="showcase-card-description">
                {example.description}
              </Paragraph>
            )}
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .examples-showcase {
    padding: var(--ds-size-12) var(--ds-size-4);
  }

  .examples-showcase-container {
    max-width: 1280px;
    margin: 0 auto;
  }

  .examples-showcase-header {
    margin-bottom: var(--ds-size-6);
  }

  :global(.examples-showcase-heading) {
    margin: 0 0 var(--ds-size-2);
  }

  :global(.examples-showcase-subtext) {
    color: var(--ds-color-neutral-text-subtle);
    margin: 0;
  }

  .examples-showcase-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ds-size-2);
    margin-bottom: var(--ds-size-8);
  }

  .examples-tab {
    display: inline-flex;
    align-items: center;
    padding: var(--ds-size-2) var(--ds-size-4);
    font-size: var(--ds-font-size-1);
    font-weight: var(--ds-font-weight-medium);
    border: 1px solid var(--ds-color-neutral-border-subtle);
    border-radius: var(--ds-border-radius-full);
    background-color: var(--ds-color-neutral-surface-default);
    color: var(--ds-color-neutral-text-default);
    cursor: pointer;
    transition: all 0.15s ease;
    font-family: inherit;
  }

  .examples-tab:hover {
    border-color: var(--ds-color-accent-border-default);
    color: var(--ds-color-accent-text-default);
  }

  .examples-tab--active {
    background-color: var(--ds-color-accent-surface-default);
    border-color: var(--ds-color-accent-border-default);
    color: var(--ds-color-accent-text-default);
    font-weight: var(--ds-font-weight-semibold);
  }

  .examples-showcase-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--ds-size-6);
  }

  @media (min-width: 640px) {
    .examples-showcase-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .examples-showcase-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .showcase-card {
    display: flex;
    flex-direction: column;
    background-color: var(--ds-color-neutral-surface-default);
    border: 1px solid var(--ds-color-neutral-border-subtle);
    border-radius: var(--ds-border-radius-lg);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .showcase-card:hover {
    border-color: var(--ds-color-accent-border-default);
    box-shadow: var(--ds-shadow-md);
  }

  .showcase-card-image {
    width: 100%;
    overflow: hidden;
    background-color: var(--ds-color-neutral-background-default);
  }

  .showcase-card-image img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }

  .showcase-card-placeholder {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #e5e7eb;
  }

  .showcase-card-content {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-1);
    padding: var(--ds-size-5);
  }

  .showcase-card-org {
    color: var(--ds-color-neutral-text-subtle);
    font-size: var(--ds-font-size-0);
    font-weight: var(--ds-font-weight-medium);
  }

  :global(.showcase-card-title) {
    margin: 0;
    line-height: 1.3;
  }

  :global(.showcase-card-description) {
    color: var(--ds-color-neutral-text-subtle);
    margin: 0;
    line-height: 1.5;
    font-size: 0.8125rem;
  }
</style>
