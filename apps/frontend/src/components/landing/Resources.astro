---
import { Heading, Paragraph, Link } from '@digdir/designsystemet-react';

interface Props {
  resources?: Array<{
    title: string;
    description: string;
    href: string;
    type: string;
  }>;
}

const { resources = [] } = Astro.props;
const hasResources = resources.length > 0;
---

{hasResources && (
  <section class="resources">
    <div class="resources-container">
      <div class="resources-header">
        <div class="resources-header-text">
          <Heading level={2} size="large" className="resources-heading">Populaere ressurser</Heading>
          <Paragraph size="medium" className="resources-intro">
            De mest brukte veiledningene og verktoyene
          </Paragraph>
        </div>
        <Link href="/veiledning" className="resources-link">Se alle ressurser</Link>
      </div>
      <div class="resources-grid">
        {resources.map((resource, index) => (
          <Link href={resource.href} className="resource-card">
            <div class="resource-number">{String(index + 1).padStart(2, '0')}</div>
            <div class="resource-content">
              <span class="resource-type">{resource.type}</span>
              <Heading level={3} size="small" className="resource-title">{resource.title}</Heading>
              <Paragraph size="xsmall" className="resource-description">{resource.description}</Paragraph>
            </div>
            <div class="resource-arrow">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </div>
          </Link>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .resources {
    padding: var(--ds-size-12) var(--ds-size-4);
    background-color: var(--ds-color-neutral-surface-default);
  }

  .resources-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .resources-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--ds-size-8);
    flex-wrap: wrap;
    gap: var(--ds-size-4);
  }

  .resources-header-text {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-2);
  }

  :global(.resources-heading) {
    margin: 0;
  }

  :global(.resources-intro) {
    margin: 0;
    color: var(--ds-color-neutral-text-subtle);
  }

  :global(.resources-link) {
    font-size: var(--ds-font-size-1);
    font-weight: var(--ds-font-weight-medium);
  }

  .resources-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--ds-size-3);
  }

  @media (min-width: 768px) {
    .resources-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  :global(.resource-card) {
    display: flex;
    align-items: center;
    gap: var(--ds-size-4);
    padding: var(--ds-size-5);
    background-color: var(--ds-color-neutral-background-default);
    border: 1px solid var(--ds-color-neutral-border-subtle);
    border-radius: var(--ds-border-radius-lg);
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }

  :global(.resource-card:hover) {
    border-color: var(--ds-color-accent-border-default);
    box-shadow: var(--ds-shadow-md);
    transform: translateX(4px);
  }

  .resource-number {
    font-size: var(--ds-font-size-4);
    font-weight: var(--ds-font-weight-bold);
    color: var(--ds-color-accent-text-default);
    opacity: 0.3;
    line-height: 1;
    flex-shrink: 0;
  }

  .resource-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-1);
  }

  .resource-type {
    font-size: var(--ds-font-size-0);
    font-weight: var(--ds-font-weight-semibold);
    color: var(--ds-color-accent-text-default);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  :global(.resource-title) {
    margin: 0;
    line-height: 1.3;
  }

  :global(.resource-description) {
    color: var(--ds-color-neutral-text-subtle);
    margin: 0;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .resource-arrow {
    flex-shrink: 0;
    color: var(--ds-color-accent-text-default);
    opacity: 0;
    transform: translateX(-8px);
    transition: all 0.2s ease;
  }

  :global(.resource-card:hover) .resource-arrow {
    opacity: 1;
    transform: translateX(0);
  }
</style>
