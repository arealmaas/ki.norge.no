---
import { Heading } from '@digdir/designsystemet-react';

const stats = [
  { value: '3', label: 'Samarbeidspartnere', description: 'Nkom, Datatilsynet, Digdir' },
  { value: '100+', label: 'Veiledningsressurser', description: 'For offentlig sektor' },
  { value: '50+', label: 'Sandkasseprosjekter', description: 'Under utvikling' },
  { value: '1000+', label: 'Brukere', description: 'Av plattformen' },
];
---

<section class="stats">
  <div class="stats-container">
    <div class="stats-header">
      <Heading level={2} size="large" className="stats-heading">KI Norge i tall</Heading>
    </div>
    <div class="stats-grid">
      {stats.map((stat, index) => (
        <div class="stat-card" style={`--delay: ${index * 0.1}s`}>
          <span class="stat-value">{stat.value}</span>
          <span class="stat-label">{stat.label}</span>
          <span class="stat-description">{stat.description}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .stats {
    padding: var(--ds-size-12) var(--ds-size-4);
    background-color: var(--ds-color-neutral-background-default);
  }

  .stats-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .stats-header {
    text-align: center;
    margin-bottom: var(--ds-size-10);
  }

  :global(.stats-heading) {
    margin: 0;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--ds-size-4);
  }

  @media (min-width: 768px) {
    .stats-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--ds-size-6);
    }
  }

  .stat-card {
    text-align: center;
    padding: var(--ds-size-6) var(--ds-size-4);
    background-color: var(--ds-color-neutral-surface-default);
    border-radius: var(--ds-border-radius-lg);
    border: 1px solid var(--ds-color-neutral-border-subtle);
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-1);
    transition: all 0.3s ease;
  }

  .stat-card:hover {
    border-color: var(--ds-color-accent-border-default);
    transform: translateY(-2px);
    box-shadow: var(--ds-shadow-md);
  }

  .stat-value {
    font-size: var(--ds-font-size-9);
    font-weight: var(--ds-font-weight-bold);
    color: var(--ds-color-accent-text-default);
    line-height: 1;
  }

  @media (min-width: 768px) {
    .stat-value {
      font-size: 3.5rem;
    }
  }

  .stat-label {
    font-size: var(--ds-font-size-1);
    font-weight: var(--ds-font-weight-semibold);
    color: var(--ds-color-neutral-text-default);
    margin-top: var(--ds-size-2);
  }

  .stat-description {
    font-size: var(--ds-font-size-0);
    color: var(--ds-color-neutral-text-subtle);
  }
</style>
