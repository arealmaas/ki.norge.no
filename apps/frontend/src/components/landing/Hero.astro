---
---

<section class="hero">
  <img
    class="hero-bg"
    src="/frontend-top_gradient.png"
    alt=""
    aria-hidden="true"
  />
  <div class="hero-container">
    <div class="hero-content">
      <h1 class="hero-title">
        <span class="hero-title-small">Norge satser på</span>
        <span class="hero-title-large">trygg og verdiskapende</span>
        <span class="hero-title-large">bruk av <strong>kunstig intelligens</strong></span>
      </h1>
    </div>
    <div class="hero-visual">
      <img
        class="hero-robot"
        src="/frontpage-ai_robot-alpha.png"
        alt="Illustrasjon av en robot"
        width="500"
        height="500"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: var(--ds-size-12) var(--ds-size-4);
    padding-top: 100px;
    min-height: 400px;
    display: flex;
    align-items: center;
  }

  @media (min-width: 768px) {
    .hero {
      padding: var(--ds-size-14) var(--ds-size-4);
      padding-top: 120px;
      min-height: 500px;
    }
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .hero-container {
    position: relative;
    z-index: 1;
    max-width: 1280px;
    margin: 0 auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--ds-size-8);
  }

  @media (min-width: 1024px) {
    .hero-container {
      flex-direction: row;
      align-items: center;
    }
  }

  .hero-content {
    flex: 1;
  }

  @media (min-width: 1024px) {
    .hero-content {
      max-width: 55%;
    }
  }

  .hero-title {
    margin: 0;
    display: flex;
    flex-direction: column;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #000000;
  }

  .hero-title-small {
    font-size: 24px;
    font-weight: 700;
  }

  @media (min-width: 768px) {
    .hero-title-small {
      font-size: 32px;
    }
  }

  .hero-title-large {
    font-size: 40px;
    font-weight: 700;
  }

  @media (min-width: 768px) {
    .hero-title-large {
      font-size: 56px;
    }
  }

  @media (min-width: 1024px) {
    .hero-title-large {
      font-size: 64px;
    }
  }

  .hero-title-large strong {
    font-weight: 900;
  }

  .hero-visual {
    flex-shrink: 0;
  }

  @media (min-width: 1024px) {
    .hero-visual {
      flex: 0 0 auto;
    }
  }

  .hero-robot {
    width: 280px;
    height: auto;
    display: block;
    filter: contrast(1.3);
  }

  @media (min-width: 768px) {
    .hero-robot {
      width: 380px;
    }
  }

  @media (min-width: 1024px) {
    .hero-robot {
      width: 440px;
    }
  }
</style>
