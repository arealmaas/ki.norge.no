---
import { Link } from '@digdir/designsystemet-react';

interface Example {
  title: string;
  organization: string;
  slug: string;
  image?: string;
}

interface Props {
  examples?: Example[];
}

const { examples = [] } = Astro.props;

// Default examples if none provided
const displayExamples: Example[] = examples.length > 0 ? examples : [
  { title: 'Effektivisering av saksbehandling med KI', organization: 'Oslo Kommune', slug: 'oslo-saksbehandling' },
  { title: 'Prediktiv analyse for raskere oppfolging', organization: 'NAV', slug: 'nav-prediktiv' },
  { title: 'Stotteverktoy for radiologer i sanntid', organization: 'Sykehuspartner', slug: 'sykehus-radiologi' },
  { title: 'Smart trafikkstyring med sensorer og KI', organization: 'Trondheim Kommune', slug: 'trondheim-trafikk' },
];

const hasExamples = displayExamples.length > 0;

// Placeholder images
const placeholderImages = [
  'https://lh3.googleusercontent.com/aida-public/AB6AXuC8g6yS7kZkdK6gqtiJaak5i23M9xMHtkZEwB1JRInSi7czgeErdanJdHB7jh1TFFX3ToeUiqYr5ChwqRTraj_HA07Peirc5TOrNBkqo25PGcSt95zztIfv7X-qD8tHXM0fDtT_NKkHh4T9FkM_ywQx5NzqjyKNOsKGIei50c6KBiW5QcWCeOili-yrk0AHv4gT5upBB4gXHfP9YkmouWinpez320mhEoXCZ62YNQCqjySaqbVabn7NpBfxTximu_3uF03UUdLLoQrz',
  'https://lh3.googleusercontent.com/aida-public/AB6AXuB9jwgOe84PVN2Qg7Gqu0RkJHO1Sdb0HQtEdjVxBRrNlLBfz8t8zoOh0hT5Nb4HvnN9kRcIs8G3Y31Xr2V9LcepDFFiY3ylzd6Z7ZonAddgbJfhKAFpyDs7DC9uObDiGgfsJWDE2xN9gy4jdpZizntx5i6sIXyfEW90x1yPeZX-5Nv5eS5VHwzlYCtt5Fg3Y20eWE7CjGNC99vzGrXocfTKSBXhlSzL0e8dhYRCguQ8LKqZMOzFm5BVjQz-uIZN0Dl1O3e1ZCDNbHgU',
  'https://lh3.googleusercontent.com/aida-public/AB6AXuCsU49vh5Zi91EMo8t3relyycF21yFwqrCPUTNyq5_qzL-pCvFxC3H3D1f4xKEhTojd_3DfW6odwrBVCFAeboaOeMEqqK_30P4U8bemeFakWvd6xUpZA52I64E5WZiYutVMH2ms_B6Ar1j9HDnnDhViG7wC2nutbz-Pyt2DU9syMutHi0-8BU1KeacPmLWzpYzaBnWBZzHXNsEnnm5O-zaQ1zrl-791sjos28R5VuEF1T4nEXqZ1CeRaEjddh6QwXo2TxREK_AmHrh9',
  'https://lh3.googleusercontent.com/aida-public/AB6AXuBHhMsIjhTWHJJ9ZAUSvfiIsVpslbeWED4JGGjLn1EK8apbBEjq0yZKp4bFOFZcaAZvLOLTY1BfLCCi2jfYczVPl2YwEam_srgRmwVi_jJOhQsLHYeaII4_3oFJfHocdIaX__ZS9KENTFpn9LWvzuJCfHT6zvyhAg5Qk4ok8BExBP9ReWERsERQs7hnvXygIvTSVudllbgdELaYcIXEOPG0oQ5EweOToh9Y6hC3JHbZbqVlxfI3durJfdqgL-JymAjyuDbCJN_4_kd3',
];
---

{hasExamples && (
  <section class="examples-section">
    <div class="examples-container">
      <div class="examples-header">
        <h2 class="examples-heading">Eksempler til inspirasjon</h2>
        <Link href="/eksempler" className="examples-link">
          Se alle eksempler <span class="material-symbols-outlined link-arrow">arrow_forward</span>
        </Link>
      </div>

      <div class="examples-grid">
        {displayExamples.slice(0, 4).map((example, index) => (
          <Link href={`/eksempler/${example.slug}`} className="example-card">
            <div class="example-image">
              <img
                src={example.image || placeholderImages[index % placeholderImages.length]}
                alt=""
                loading="lazy"
              />
            </div>
            <div class="example-content">
              <span class="example-org">{example.organization}</span>
              <span class="example-title">{example.title}</span>
            </div>
          </Link>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .examples-section {
    padding: 0 var(--ds-size-4);
    margin-bottom: var(--ds-size-14);
  }

  .examples-container {
    max-width: 1280px;
    margin: 0 auto;
  }

  .examples-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: var(--ds-size-8);
    flex-wrap: wrap;
    gap: var(--ds-size-4);
  }

  .examples-heading {
    margin: 0;
    font-size: 1.875rem;
    font-weight: 700;
    color: #0d131b;
    letter-spacing: -0.025em;
  }

  :global(html.dark) .examples-heading {
    color: #ffffff;
  }

  :global(.examples-link) {
    display: flex;
    align-items: center;
    gap: 4px;
    color: #136dec;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }

  :global(.examples-link:hover) {
    text-decoration: underline;
  }

  .link-arrow {
    font-size: 14px !important;
  }

  .examples-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--ds-size-6);
  }

  @media (min-width: 640px) {
    .examples-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .examples-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  :global(.example-card) {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-4);
    padding: var(--ds-size-4);
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease;
  }

  :global(html.dark .example-card) {
    background-color: #0f172a;
    border-color: #1e293b;
  }

  :global(.example-card:hover) {
    border-color: rgba(19, 109, 236, 0.5);
  }

  .example-image {
    aspect-ratio: 1;
    width: 100%;
    border-radius: 8px;
    overflow: hidden;
    background-color: #f1f5f9;
  }

  .example-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .example-content {
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-2);
  }

  .example-org {
    color: #136dec;
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .example-title {
    color: #0d131b;
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.4;
  }

  :global(html.dark) .example-title {
    color: #ffffff;
  }
</style>
