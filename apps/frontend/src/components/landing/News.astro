---
import { Link } from '@digdir/designsystemet-react';
import ArticleCard from '../shared/ArticleCard.astro';

interface Props {
  articles?: Array<{
    title: string;
    excerpt: string;
    slug: string;
    publishedAt: string;
    category?: string;
    image?: string;
  }>;
}

const { articles = [] } = Astro.props;
const hasArticles = articles.length > 0;
---

{hasArticles && (
  <section class="news">
    <div class="news-container">
      <div class="news-header">
        <h2 class="news-heading">Siste nytt</h2>
        <Link href="/artikler" className="news-link">Se alle artikler</Link>
      </div>
      <div class="news-grid">
        {articles.slice(0, 3).map((article) => (
          <ArticleCard
            title={article.title}
            excerpt={article.excerpt}
            slug={article.slug}
            publishedAt={article.publishedAt}
            category={article.category}
            image={article.image}
          />
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .news {
    padding: 0 var(--ds-size-4);
    margin-bottom: var(--ds-size-14);
  }

  .news-container {
    max-width: 1280px;
    margin: 0 auto;
  }

  .news-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: var(--ds-size-8);
    flex-wrap: wrap;
    gap: var(--ds-size-4);
  }

  .news-heading {
    margin: 0;
    font-size: 1.875rem;
    font-weight: 700;
    color: #0d131b;
    letter-spacing: -0.025em;
  }

  :global(html.dark) .news-heading {
    color: #ffffff;
  }

  :global(.news-link) {
    color: #136dec;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }

  :global(.news-link:hover) {
    text-decoration: underline;
  }

  .news-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--ds-size-8);
  }

  @media (min-width: 768px) {
    .news-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
