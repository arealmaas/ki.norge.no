---
import { Heading, Paragraph } from '@digdir/designsystemet-react';

const audiences = [
  {
    title: 'Offentlige virksomheter',
    description: 'Kommuner, fylkeskommuner og statlige etater som ønsker å ta i bruk KI på en ansvarlig måte.',
    icon: 'apartment',
    features: ['Veiledning for anskaffelse', 'Regulatorisk støtte', 'Beste praksis'],
  },
  {
    title: 'Utviklere og teknologer',
    description: 'Tekniske fagpersoner som bygger KI-løsninger for offentlig sektor.',
    icon: 'code',
    features: ['Tekniske retningslinjer', 'Sandkassemiljø', 'API-dokumentasjon'],
  },
  {
    title: 'Ledere og beslutningstakere',
    description: 'Ledere som trenger innsikt i KI-strategi og governance.',
    icon: 'groups',
    features: ['Strategisk veiledning', 'Risikostyring', 'Suksesshistorier'],
  },
];
---

<section class="audiences">
  <div class="audiences-container">
    <div class="audiences-header">
      <Heading level={2} size="large" className="audiences-heading">Hvem er vi for?</Heading>
      <Paragraph size="medium" className="audiences-intro">
        KI Norge støtter alle som jobber med kunstig intelligens i offentlig sektor
      </Paragraph>
    </div>
    <div class="audiences-grid">
      {audiences.map((audience) => (
        <div class="audience-card">
          <div class="audience-icon-wrapper">
            <span class="material-symbols-outlined audience-icon">{audience.icon}</span>
          </div>
          <Heading level={3} size="medium" className="audience-title">{audience.title}</Heading>
          <Paragraph size="small" className="audience-description">{audience.description}</Paragraph>
          <ul class="audience-features">
            {audience.features.map((feature) => (
              <li class="audience-feature">
                <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                {feature}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .audiences {
    padding: var(--ds-size-12) var(--ds-size-4);
    background-color: var(--ds-color-neutral-background-default);
  }

  .audiences-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .audiences-header {
    text-align: center;
    margin-bottom: var(--ds-size-10);
  }

  :global(.audiences-heading) {
    margin: 0 0 var(--ds-size-3);
  }

  :global(.audiences-intro) {
    color: var(--ds-color-neutral-text-subtle);
    margin: 0 auto;
    max-width: 500px;
  }

  .audiences-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--ds-size-6);
  }

  @media (min-width: 768px) {
    .audiences-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .audience-card {
    padding: var(--ds-size-6);
    background-color: var(--ds-color-neutral-surface-default);
    border-radius: var(--ds-border-radius-lg);
    border: 1px solid var(--ds-color-neutral-border-subtle);
    transition: all 0.3s ease;
  }

  .audience-card:hover {
    border-color: var(--ds-color-accent-border-default);
    box-shadow: var(--ds-shadow-md);
  }

  .audience-icon-wrapper {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--ds-color-accent-surface-default);
    border-radius: var(--ds-border-radius-lg);
    margin-bottom: var(--ds-size-4);
  }

  .audience-icon {
    font-size: 28px;
    color: var(--ds-color-accent-text-default);
  }

  :global(.audience-title) {
    margin: 0 0 var(--ds-size-2);
  }

  :global(.audience-description) {
    color: var(--ds-color-neutral-text-subtle);
    margin: 0 0 var(--ds-size-5);
    line-height: 1.6;
  }

  .audience-features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--ds-size-2);
  }

  .audience-feature {
    display: flex;
    align-items: center;
    gap: var(--ds-size-2);
    font-size: var(--ds-font-size-1);
    color: var(--ds-color-neutral-text-default);
  }

  .check-icon {
    color: var(--ds-color-accent-text-default);
    flex-shrink: 0;
  }
</style>
