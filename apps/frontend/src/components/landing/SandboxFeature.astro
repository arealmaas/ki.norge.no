---
import { Heading, Paragraph, Button } from '@digdir/designsystemet-react';
---

<section class="sandbox-feature">
  <div class="sandbox-bg" aria-hidden="true">
    <div class="radial-gradient"></div>
    <div class="pattern-overlay"></div>
  </div>

  <div class="sandbox-container">
    <span class="sandbox-badge">Regulatorisk sandkasse</span>

    <Heading level={2} size="xlarge" className="sandbox-title">
      Test KI-losninger i et trygt miljo
    </Heading>

    <Paragraph size="large" className="sandbox-description">
      Den regulatoriske sandkassen gir virksomheter mulighet til a teste innovative KI-losninger med veiledning fra eksperter fra Datatilsynet og Nkom.
    </Paragraph>

    <div class="sandbox-features">
      <div class="feature-item">
        <span class="feature-icon material-symbols-outlined">verified_user</span>
        <span class="feature-text">Juridisk veiledning</span>
      </div>
      <div class="feature-item">
        <span class="feature-icon material-symbols-outlined">support_agent</span>
        <span class="feature-text">Ekspertbistand</span>
      </div>
      <div class="feature-item">
        <span class="feature-icon material-symbols-outlined">science</span>
        <span class="feature-text">Testmiljo</span>
      </div>
    </div>

    <div class="sandbox-actions">
      <Button
        asChild
        variant="primary"
        size="large"
      >
        <a href="/sandkasse">Les mer om sandkassen</a>
      </Button>
      <Button
        asChild
        variant="secondary"
        size="large"
      >
        <a href="/sandkasse/prosjekter">Se pagaende prosjekter</a>
      </Button>
    </div>
  </div>
</section>

<style>
  .sandbox-feature {
    position: relative;
    padding: var(--ds-size-14) var(--ds-size-4);
    overflow: hidden;
  }

  .sandbox-bg {
    position: absolute;
    inset: 0;
    background-color: var(--stitch-bg-dark);
    z-index: 0;
  }

  .radial-gradient {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 80% 50% at 50% 0%,
      rgba(19, 109, 236, 0.25) 0%,
      transparent 70%
    );
  }

  .pattern-overlay {
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    opacity: 0.5;
  }

  .sandbox-container {
    position: relative;
    z-index: 1;
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--ds-size-5);
  }

  .sandbox-badge {
    display: inline-flex;
    font-size: var(--ds-font-size-0);
    font-weight: var(--ds-font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #5ba0f5;
    background-color: rgba(19, 109, 236, 0.2);
    padding: var(--ds-size-1) var(--ds-size-3);
    border-radius: var(--ds-border-radius-full);
    border: 1px solid rgba(19, 109, 236, 0.3);
  }

  :global(.sandbox-title) {
    margin: 0;
    color: #f1f5f9;
    line-height: 1.2;
  }

  :global(.sandbox-description) {
    margin: 0;
    color: #94a3b8;
    line-height: 1.6;
    max-width: 600px;
  }

  .sandbox-features {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--ds-size-6);
    margin-top: var(--ds-size-2);
  }

  .feature-item {
    display: flex;
    align-items: center;
    gap: var(--ds-size-2);
    color: #e2e8f0;
  }

  .feature-icon {
    color: #5ba0f5;
    font-size: 24px;
  }

  .feature-text {
    font-size: var(--ds-font-size-1);
    font-weight: var(--ds-font-weight-medium);
  }

  .sandbox-actions {
    display: flex;
    gap: var(--ds-size-3);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--ds-size-4);
  }

  .sandbox-actions :global(a) {
    text-decoration: none;
  }

  /* Override secondary button for dark background */
  .sandbox-actions :global(button[data-variant="secondary"]),
  .sandbox-actions :global(a):last-child {
    color: #f1f5f9;
    border-color: rgba(255, 255, 255, 0.3);
  }

  .sandbox-actions :global(button[data-variant="secondary"]:hover),
  .sandbox-actions :global(a):last-child:hover {
    background-color: rgba(255, 255, 255, 0.1);
  }
</style>
