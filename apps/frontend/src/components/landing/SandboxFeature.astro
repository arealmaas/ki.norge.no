---
import { Button } from '@digdir/designsystemet-react';
---

<section class="sandbox-feature">
  <div class="sandbox-bg" aria-hidden="true">
    <div class="radial-gradient"></div>
    <div class="pattern-overlay"></div>
  </div>

  <div class="sandbox-container">
    <div class="sandbox-content">
      <span class="sandbox-badge">Regulatorisk sandkasse</span>

      <h2 class="sandbox-title">
        Test innovative KI-løsninger i trygge rammer
      </h2>

      <p class="sandbox-description">
        Vår regulatoriske sandkasse gir virksomheter mulighet til å utforske hvordan nye KI-løsninger kan etterleve regelverket. Her samarbeider dere direkte med tilsynsmyndigheter for å finne gode løsninger på komplekse problemstillinger.
      </p>

      <Button
        asChild
        variant="primary"
        size="large"
      >
        <a href="/sandkasse" class="sandbox-cta">Søk om plass</a>
      </Button>
    </div>
  </div>
</section>

<style>
  .sandbox-feature {
    position: relative;
    width: 100%;
    background-color: var(--stitch-bg-dark);
    padding: var(--ds-size-14) 0;
    margin-bottom: var(--ds-size-14);
    overflow: hidden;
  }

  .sandbox-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .radial-gradient {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 50% 50%,
      rgba(19, 109, 236, 0.4) 0%,
      transparent 70%
    );
    opacity: 0.25;
  }

  .pattern-overlay {
    position: absolute;
    inset: 0;
    background-image: url('https://www.transparenttextures.com/patterns/cubes.png');
    opacity: 0.25;
  }

  .sandbox-container {
    position: relative;
    z-index: 1;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 var(--ds-size-4);
  }

  @media (min-width: 1024px) {
    .sandbox-container {
      padding: 0 var(--ds-size-10);
    }
  }

  .sandbox-content {
    max-width: 768px;
  }

  .sandbox-badge {
    display: inline-flex;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ds-color-accent-base-default);
    background-color: rgba(19, 109, 236, 0.2);
    padding: var(--ds-size-1) var(--ds-size-3);
    border-radius: 9999px;
    border: 1px solid rgba(19, 109, 236, 0.3);
    margin-bottom: var(--ds-size-6);
  }

  .sandbox-title {
    margin: 0 0 var(--ds-size-6) 0;
    color: white;
    font-size: 2.25rem;
    font-weight: 900;
    line-height: 1.2;
  }

  @media (min-width: 768px) {
    .sandbox-title {
      font-size: 3rem;
    }
  }

  .sandbox-description {
    margin: 0 0 var(--ds-size-10) 0;
    color: #94a3b8;
    font-size: 1.125rem;
    line-height: 1.7;
  }

  @media (min-width: 768px) {
    .sandbox-description {
      font-size: 1.25rem;
    }
  }

  .sandbox-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 200px;
    height: 56px;
    padding: 0 var(--ds-size-8);
    background-color: var(--ds-color-accent-base-default);
    color: white;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: 12px;
    box-shadow: 0 20px 25px -5px rgba(19, 109, 236, 0.2);
    transition: opacity 0.2s ease;
  }

  .sandbox-cta:hover {
    opacity: 0.9;
  }
</style>
