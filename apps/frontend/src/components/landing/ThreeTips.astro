---
import { Paragraph } from '@digdir/designsystemet-react';
import BlocksRenderer from '../shared/BlocksRenderer.astro';
import type { TipItem } from '../../lib/umbraco';
import { getPlainText, getMediaUrl } from '../../lib/umbraco';

interface Props {
  tittel?: string;
  tips?: TipItem[];
}

const { tittel, tips: cmsTips } = Astro.props;

const defaultTips = [
  {
    title: 'Start med problemet',
    description: 'Definer klart hva du ønsker å oppnå før du velger teknologi. Gode KI-prosjekter starter med et tydelig behov, og en forståelse over hvordan verdien skapes, gi verdi.',
    image: '/frontpage-target-alpha.png',
  },
  {
    title: 'Forstå dataene dine',
    description: 'Kartlegg hvilke data du har tilgang til, kvaliteten på dem, og om de er egnet for formålet. Det er datasettene som avgjør hvor godt modellen fungerer.',
    image: '/frontpage-datacloud-alpha.png',
  },
  {
    title: 'Sjekk rammer og ansvar',
    description: 'Forstå regelverket som gjelder for ditt bruksområde. Sørg for at løsningen ivaretar personvern, etiske hensyn og at du tar ansvar for prosessene.',
    image: '/frontpage-magnifying_glass-alpha.png',
  },
];

const tipImages = ['/frontpage-target-alpha.png', '/frontpage-datacloud-alpha.png', '/frontpage-magnifying_glass-alpha.png'];

const heading = tittel || 'Tre råd før du går i gang med KI';
const useCms = cmsTips && cmsTips.length > 0;
---

<section class="three-tips">
  <div class="three-tips-container">
    <div class="three-tips-header">
      <h2 class="three-tips-heading">
        {heading}
      </h2>
    </div>
    <div class="three-tips-grid">
      {useCms ? (
        cmsTips.map((tip, i) => (
          <div class="tip-card">
            <div class="tip-illustration">
              <img src={tip.tipsBilde ? getMediaUrl(tip.tipsBilde) : tipImages[i % tipImages.length]} alt="" width="140" height="140" loading="lazy" />
            </div>
            <h3 class="tip-title">{tip.tipsTitle}</h3>
            <div class="tip-description-rich">
              <BlocksRenderer blocks={tip.tipsTekst} />
            </div>
          </div>
        ))
      ) : (
        defaultTips.map((tip) => (
          <div class="tip-card">
            <div class="tip-illustration">
              <img src={tip.image} alt="" width="140" height="140" loading="lazy" />
            </div>
            <h3 class="tip-title">{tip.title}</h3>
            <Paragraph size="small" className="tip-description">
              {tip.description}
            </Paragraph>
          </div>
        ))
      )}
    </div>
  </div>
</section>

<style>
  .three-tips {
    padding: var(--ds-size-12) var(--ds-size-4);
    background-color: #E2F0FC;
  }

  .three-tips-container {
    max-width: 1280px;
    margin: 0 auto;
  }

  .three-tips-header {
    text-align: center;
    margin-bottom: var(--ds-size-10);
  }

  .three-tips-heading {
    margin: 0;
    font-size: 40px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--ds-color-neutral-text-default);
  }

  .three-tips-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--ds-size-8);
  }

  @media (min-width: 768px) {
    .three-tips-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .tip-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--ds-size-4);
  }

  .tip-illustration {
    margin-bottom: var(--ds-size-5);
    width: 100%;
    height: 192px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 24px;
  }

  .tip-illustration img {
    width: 120px;
    height: 120px;
    object-fit: contain;
    opacity: 0.85;
  }

  .tip-title {
    margin: 0 0 var(--ds-size-3);
    font-weight: var(--ds-font-weight-semibold);
    font-size: 1.125rem;
    color: var(--ds-color-neutral-text-default);
  }

  :global(.tip-description) {
    color: var(--ds-color-neutral-text-subtle);
    margin: 0;
    line-height: 1.6;
    max-width: 340px;
  }

  .tip-description-rich {
    color: var(--ds-color-neutral-text-subtle);
    line-height: 1.6;
    max-width: 340px;
    font-size: var(--ds-font-size-1, 0.875rem);
  }

  .tip-description-rich :global(p) {
    margin: 0;
  }
</style>
