---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<div class="info-card">
  <div class="info-card-header">
    <span class="info-card-icon" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="9" y1="9" x2="15" y2="9"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="12" y2="17"/></svg>
    </span>
    <span class="info-card-title">{title}</span>
  </div>
  <div class="info-card-body">
    <slot />
  </div>
</div>
<style>
  .info-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 24px 32px;
    margin: 24px 0;
  }
  .info-card-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
  }
  .info-card-icon {
    color: #334155;
    display: flex;
    align-items: center;
  }
  .info-card-title {
    font-weight: 700;
    font-size: 1rem;
    color: #000;
  }
  .info-card-body {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgba(0,0,0,0.75);
  }
  .info-card-body :global(p) {
    margin: 0 0 12px;
  }
  .info-card-body :global(p:last-child) {
    margin-bottom: 0;
  }
  .info-card-body :global(ol), .info-card-body :global(ul) {
    margin: 8px 0;
    padding-left: 24px;
  }
  .info-card-body :global(li) {
    margin-bottom: 4px;
  }
</style>
