---
interface Props {
  label?: string;
}
const { label = 'HVORFOR ER DETTE VIKTIG?' } = Astro.props;
---
<div class="info-banner">
  <p class="info-banner-label">{label}</p>
  <div class="info-banner-content">
    <slot />
  </div>
</div>
<style>
  .info-banner {
    background: #FEF9EC;
    border-radius: 8px;
    padding: 24px 32px;
    margin-bottom: 48px;
  }
  .info-banner-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(0,0,0,0.6);
    margin: 0 0 8px;
  }
  .info-banner-content {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgba(0,0,0,0.75);
  }
  .info-banner-content :global(p) {
    margin: 0;
  }
</style>
