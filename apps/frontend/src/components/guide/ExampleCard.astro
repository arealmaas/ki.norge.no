---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<div class="example-card">
  <div class="example-header">
    <span class="example-icon" aria-hidden="true">&#x1F44B;</span>
    <span class="example-title">{title}</span>
  </div>
  <div class="example-body">
    <slot />
  </div>
</div>
<style>
  .example-card {
    background: #f0faf0;
    border-radius: 8px;
    padding: 24px 32px;
    margin: 32px 0;
  }
  .example-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
  }
  .example-icon {
    font-size: 1.25rem;
  }
  .example-title {
    font-weight: 600;
    font-size: 1rem;
    color: #000;
  }
  .example-body {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgba(0,0,0,0.75);
  }
  .example-body :global(p) {
    margin: 0 0 12px;
  }
  .example-body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
