---
/**
 * Back-to-top button. Appears after the user scrolls down 600px.
 * Pure progressive enhancement — works without JS, just doesn't auto-show/hide.
 */
---

<button
  type="button"
  class="back-to-top"
  aria-label="Tilbake til toppen"
  data-back-to-top
>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="m18 15-6-6-6 6" />
  </svg>
</button>

<style>
  .back-to-top {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 90;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--ds-color-accent-base-default, #136dec);
    color: white;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.15);
    opacity: 0;
    transform: translateY(20px);
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease, background 0.15s ease;
  }
  .back-to-top:hover {
    background: var(--ds-color-accent-7, #0f57bd);
  }
  .back-to-top:focus-visible {
    outline: 3px solid var(--ds-color-accent-base-default, #136dec);
    outline-offset: 3px;
  }
  .back-to-top.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top {
      transition: none;
    }
  }

  @media print {
    .back-to-top { display: none !important; }
  }
</style>

<script is:inline>
  (function () {
    const btn = document.querySelector('[data-back-to-top]');
    if (!btn) return;

    let visible = false;
    function update() {
      const shouldShow = window.scrollY > 600;
      if (shouldShow !== visible) {
        btn.classList.toggle('is-visible', shouldShow);
        visible = shouldShow;
      }
    }
    window.addEventListener('scroll', update, { passive: true });
    btn.addEventListener('click', function () {
      window.scrollTo({ top: 0, behavior: 'smooth' });
      // Move focus to top so screen-reader users land at the start
      const h1 = document.querySelector('h1');
      if (h1) {
        h1.setAttribute('tabindex', '-1');
        h1.focus({ preventScroll: true });
      }
    });
    update();
  })();
</script>
