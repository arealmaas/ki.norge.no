---
interface AktueltItem {
  title: string;
  date: string;
  lead: string;
  image?: string;
  href?: string;
}

interface Props {
  items: AktueltItem[];
  heading?: string;
}

const { items, heading = 'Aktuelt' } = Astro.props;
---

<section class="aktuelt">
  <h2 class="aktuelt-heading">{heading}</h2>
  <div class="aktuelt-grid">
    {items.map((item) => {
      const Tag = item.href ? 'a' : 'div';
      return (
        <Tag class="aktuelt-card" {...(item.href ? { href: item.href } : {})}>
          <div class="aktuelt-text">
            <h3 class="aktuelt-title">{item.title}</h3>
            <span class="aktuelt-date">{item.date}</span>
            <p class="aktuelt-lead">{item.lead}</p>
          </div>
          <div class="aktuelt-image">
            {item.image ? (
              <img src={item.image} alt="" loading="lazy" />
            ) : (
              <div class="aktuelt-image-placeholder" />
            )}
          </div>
        </Tag>
      );
    })}
  </div>
</section>

<style>
  .aktuelt-heading {
    font-size: 40px;
    font-weight: 700;
    margin: 0 0 32px 0;
    color: #000;
  }

  .aktuelt-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  @media (min-width: 640px) {
    .aktuelt-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .aktuelt-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .aktuelt-card {
    background: rgba(0, 0, 0, 0.05);
    border-radius: 8px;
    padding: 24px;
    height: 384px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 24px;
    text-decoration: none;
    color: inherit;
  }

  a.aktuelt-card:hover {
    opacity: 0.9;
  }

  .aktuelt-text {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .aktuelt-title {
    font-size: 24px;
    font-weight: 600;
    margin: 0;
    color: #000;
  }

  .aktuelt-date {
    font-size: 18px;
    font-weight: 500;
    color: rgba(0, 0, 0, 0.55);
  }

  .aktuelt-lead {
    font-size: 18px;
    font-weight: 500;
    color: rgba(0, 0, 0, 0.55);
    line-height: 1.45;
    margin: 0;
  }

  .aktuelt-image {
    flex: 1;
    min-height: 0;
    border-radius: 24px;
    overflow: hidden;
    background: var(--image-fallback-bg, #D9D9D9);
  }

  .aktuelt-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .aktuelt-image-placeholder {
    width: 100%;
    height: 100%;
  }
</style>
