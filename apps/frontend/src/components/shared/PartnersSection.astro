---
const partners = [
  { name: 'Nkom', subtitle: 'Nasjonal kommunikasjonsmyndighet', url: 'https://www.nkom.no' },
  { name: 'Datatilsynet', subtitle: 'Personvernmyndigheten', url: 'https://www.datatilsynet.no' },
  { name: 'Digdir', subtitle: 'Digitaliseringsdirektoratet', url: 'https://www.digdir.no' },
];
---

<div class="footer-partners">
  <div class="footer-container">
    <p class="partners-label">Partnere i KI Norge</p>
    <div class="partners-logos">
      {partners.map((partner) => (
        <a
          href={partner.url}
          class="partner-item"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="partner-name">{partner.name}</span>
          <span class="partner-subtitle">{partner.subtitle}</span>
        </a>
      ))}
    </div>
  </div>
</div>

<style>
  .footer-partners {
    border-top: 1px solid var(--ds-color-neutral-border-subtle);
    padding: var(--ds-size-10) 0;
  }

  .footer-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 var(--ds-size-4);
  }

  @media (min-width: 1024px) {
    .footer-container {
      padding: 0 var(--ds-size-10);
    }
  }

  .partners-label {
    margin: 0 0 var(--ds-size-8) 0;
    text-align: center;
    color: var(--ds-color-neutral-text-subtle);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
  }

  .partners-logos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--ds-size-10);
    transition: opacity 0.3s ease;
  }

  .partner-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--ds-size-2);
    text-decoration: none;
  }

  .partner-name {
    color: var(--ds-color-neutral-text-default);
    font-size: 1.5rem;
    font-weight: 900;
    letter-spacing: -0.025em;
  }

  .partner-subtitle {
    color: var(--ds-color-neutral-text-subtle);
    font-size: 0.625rem;
    font-weight: 500;
  }
</style>
