---
/**
 * BlocksRenderer - Renders Umbraco Block List blocks to HTML using Designsystemet components
 *
 * Umbraco blocks come as: { contentType: "tekst", content: { innhold: "<p>HTML</p>" } }
 * Supports block types: tekst, advarsel, lenkeliste, faqInnhold
 * Also supports legacy Strapi v5 block format for backward compatibility during migration.
 */
import { Heading, Paragraph, Link } from '@digdir/designsystemet-react';
import type { UmbracoBlock, BlockNode, BlockChild } from '../../lib/umbraco';

interface Props {
  blocks?: UmbracoBlock[] | BlockNode[];
  class?: string;
}

const { blocks, class: className } = Astro.props;

// Detect if we're dealing with Umbraco blocks or legacy Strapi blocks
function isUmbracoBlock(block: any): block is UmbracoBlock {
  return block && typeof block === 'object' && 'contentType' in block && 'content' in block;
}

function isLegacyBlock(block: any): block is BlockNode {
  return block && typeof block === 'object' && 'type' in block && !('contentType' in block);
}

// ── Umbraco block rendering ─────────────────────────────────────

function renderUmbracoBlock(block: UmbracoBlock): string {
  const content = block.content || {};

  switch (block.contentType) {
    case 'tekst': {
      // Rich text editor output — already HTML
      const html = content.innhold as string || '';
      return html;
    }

    case 'advarsel': {
      const tittel = content.tittel as string || '';
      const innhold = content.innhold as string || '';
      const type = (content.type as string || 'info').toLowerCase();
      const typeClass = `advarsel--${type}`;
      return `<div class="advarsel ${typeClass}">${tittel ? `<strong class="advarsel-tittel">${tittel}</strong>` : ''}${innhold}</div>`;
    }

    case 'lenkeliste': {
      const tittel = content.tittel as string || '';
      const lenker = content.lenker;
      let links: { tekst: string; url: string; ekstern?: boolean }[] = [];

      if (typeof lenker === 'string') {
        try { links = JSON.parse(lenker); } catch { /* ignore */ }
      } else if (Array.isArray(lenker)) {
        links = lenker.map((l: any) => ({
          tekst: l.content?.tekst || l.tekst || '',
          url: l.content?.url || l.url || '',
          ekstern: l.content?.ekstern || l.ekstern || false,
        }));
      }

      const linksHtml = links.map(l =>
        `<li><a href="${l.url}"${l.ekstern ? ' target="_blank" rel="noopener noreferrer"' : ''}>${l.tekst}${l.ekstern ? ' ↗' : ''}</a></li>`
      ).join('');

      return `${tittel ? `<h3>${tittel}</h3>` : ''}<ul class="ds-list">${linksHtml}</ul>`;
    }

    case 'faqInnhold': {
      const sporsmal = content.sporsmal as string || '';
      const svar = content.svar as string || '';
      return `<div class="faq-block"><h3 class="faq-block-q">${sporsmal}</h3><div class="faq-block-a">${svar}</div></div>`;
    }

    default:
      return '';
  }
}

// ── Legacy Strapi block rendering (kept during migration) ───────

function renderTextChild(child: BlockChild): string {
  if (!child.text) return '';

  let text = child.text;

  if (child.bold) text = `<strong>${text}</strong>`;
  if (child.italic) text = `<em>${text}</em>`;
  if (child.underline) text = `<u>${text}</u>`;
  if (child.strikethrough) text = `<s>${text}</s>`;
  if (child.code) text = `<code>${text}</code>`;

  return text;
}

function renderChildren(children?: BlockChild[]): string {
  if (!children) return '';

  return children.map(child => {
    if (child.type === 'link' && child.url) {
      const linkText = child.children?.map(c => renderTextChild(c)).join('') || '';
      return `<a href="${child.url}">${linkText}</a>`;
    }
    return renderTextChild(child);
  }).join('');
}

function renderListItems(children?: BlockChild[]): string {
  if (!children) return '';

  return children.map(item => {
    const content = item.children?.map(c => renderTextChild(c)).join('') || '';
    return `<li>${content}</li>`;
  }).join('');
}

function renderLegacyBlock(block: BlockNode): string {
  switch (block.type) {
    case 'paragraph':
      return `<p>${renderChildren(block.children)}</p>`;

    case 'heading': {
      const level = block.level || 2;
      const headingText = block.children?.map(c => c.text || '').join('') || '';
      const headingId = headingText.toLowerCase().replace(/[^a-zæøå0-9]+/g, '-').replace(/(^-|-$)/g, '');
      return `<h${level} id="${headingId}">${renderChildren(block.children)}</h${level}>`;
    }

    case 'list':
      if (block.format === 'ordered') {
        return `<ol class="ds-list">${renderListItems(block.children)}</ol>`;
      }
      return `<ul class="ds-list">${renderListItems(block.children)}</ul>`;

    case 'quote':
      return `<blockquote class="ds-blockquote">${renderChildren(block.children)}</blockquote>`;

    case 'code':
      return `<pre class="ds-code"><code>${renderChildren(block.children)}</code></pre>`;

    case 'image':
      if (block.image?.url) {
        return `<figure class="ds-figure"><img src="${block.image.url}" alt="${block.image.alternativeText || ''}" loading="lazy" /></figure>`;
      }
      return '';

    default:
      return '';
  }
}
---

{blocks && blocks.length > 0 && (
  <div class:list={['blocks-renderer', className]}>
    {blocks.map((block) => {
      if (isUmbracoBlock(block)) {
        return <Fragment set:html={renderUmbracoBlock(block)} />;
      }
      if (isLegacyBlock(block)) {
        return <Fragment set:html={renderLegacyBlock(block)} />;
      }
      return null;
    })}
  </div>
)}

<style>
  .ds-list {
    margin: var(--ds-size-4) 0;
    padding-left: var(--ds-size-6);
  }

  .ds-list li {
    margin-bottom: var(--ds-size-2);
  }

  .ds-blockquote {
    margin: var(--ds-size-4) 0;
    padding: var(--ds-size-4);
    border-left: 4px solid var(--ds-color-accent-base-default);
    background-color: var(--ds-color-neutral-background-subtle);
    font-style: italic;
  }

  .ds-code {
    margin: var(--ds-size-4) 0;
    padding: var(--ds-size-4);
    background-color: var(--ds-color-neutral-background-subtle);
    border-radius: var(--ds-border-radius-md);
    overflow-x: auto;
  }

  .ds-code code {
    font-family: var(--ds-font-family-mono);
    font-size: var(--ds-font-size-sm);
  }

  .ds-figure {
    margin: var(--ds-size-4) 0;
  }

  .ds-figure img {
    max-width: 100%;
    height: auto;
    border-radius: var(--ds-border-radius-md);
  }

  /* Umbraco advarsel (alert) block styles */
  .advarsel {
    margin: var(--ds-size-4) 0;
    padding: var(--ds-size-4);
    border-radius: var(--ds-border-radius-md);
    border-left: 4px solid;
  }

  .advarsel--info {
    border-color: var(--ds-color-info-border-default, #0073e6);
    background-color: var(--ds-color-info-surface-default, #e6f2ff);
  }

  .advarsel--advarsel {
    border-color: var(--ds-color-warning-border-default, #e6a700);
    background-color: var(--ds-color-warning-surface-default, #fff8e6);
  }

  .advarsel--viktig {
    border-color: var(--ds-color-danger-border-default, #d32f2f);
    background-color: var(--ds-color-danger-surface-default, #fde8e8);
  }

  .advarsel--suksess {
    border-color: var(--ds-color-success-border-default, #1e7e34);
    background-color: var(--ds-color-success-surface-default, #e6f5ea);
  }

  .advarsel-tittel {
    display: block;
    margin-bottom: var(--ds-size-2);
  }

  /* FAQ block styles */
  .faq-block {
    margin: var(--ds-size-4) 0;
    padding: var(--ds-size-4);
    background-color: var(--ds-color-neutral-surface-default);
    border-radius: var(--ds-border-radius-md);
  }

  .faq-block-q {
    margin: 0 0 var(--ds-size-2);
    font-size: var(--ds-font-size-1);
  }

  .faq-block-a {
    color: var(--ds-color-neutral-text-subtle);
  }

  /* Styles for bare HTML elements from Umbraco RichText (set:html bypasses scoping) */
  :global(.blocks-renderer ul),
  :global(.blocks-renderer ol) {
    margin: var(--ds-size-4) 0;
    padding-left: var(--ds-size-6);
  }

  :global(.blocks-renderer li) {
    margin-bottom: var(--ds-size-2);
  }

  :global(.blocks-renderer blockquote) {
    margin: var(--ds-size-4) 0;
    padding: var(--ds-size-4);
    border-left: 4px solid var(--ds-color-accent-base-default);
    background-color: var(--ds-color-neutral-background-subtle);
    font-style: italic;
  }

  :global(.blocks-renderer pre) {
    margin: var(--ds-size-4) 0;
    padding: var(--ds-size-4);
    background-color: var(--ds-color-neutral-background-subtle);
    border-radius: var(--ds-border-radius-md);
    overflow-x: auto;
  }

  :global(.blocks-renderer pre code) {
    font-family: var(--ds-font-family-mono);
    font-size: var(--ds-font-size-sm);
  }

  :global(.blocks-renderer img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--ds-border-radius-md);
  }

  :global(.blocks-renderer figure) {
    margin: var(--ds-size-4) 0;
  }

  :global(.blocks-renderer h2) {
    margin-top: var(--ds-size-10);
    margin-bottom: var(--ds-size-4);
    scroll-margin-top: 100px;
  }

  :global(.blocks-renderer h3) {
    margin-top: var(--ds-size-8);
    margin-bottom: var(--ds-size-3);
    scroll-margin-top: 100px;
  }

  :global(.blocks-renderer p) {
    margin-bottom: var(--ds-size-4);
  }

  :global(.blocks-renderer a) {
    color: var(--ds-color-accent-text-default);
    text-decoration: underline;
  }

  :global(.blocks-renderer a:hover) {
    color: var(--ds-color-accent-text-hover);
  }
</style>
