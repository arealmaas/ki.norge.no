@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    Layout = null;

    var frontendUrl = Configuration["HeadlessPreview:FrontendUrl"] ?? "http://localhost:4321";
    var previewSecret = Configuration["HeadlessPreview:PreviewSecret"] ?? "";

    var contentType = Model.ContentType.Alias;
    var contentKey = Model.Key.ToString();

    // Redirect to the Astro frontend preview endpoint which handles
    // cookie setup, content fetching, and routing
    var previewUrl = $"{frontendUrl}/api/preview?secret={previewSecret}&type={contentType}&id={contentKey}";
    Context.Response.Redirect(previewUrl);
}